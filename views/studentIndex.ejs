  <%- include("./partials/header.ejs")%>

  <style>
    .descp {
      text-indent: 2em;
      margin: 0 2em;
    }

    .rectangle-141 {
      background-color: white;
      border-radius: 0.75em;
      box-shadow: 0em 0.75em 1.5em -0.25em #919eab1f, 0em 0em 0.125em #919eab33;
      height: 14.6875em;
      left: 4.6875em;
      top: 37.3125em;
      width: 39.125em;
      width: 75%;
      margin: 2em 2em;
    }

    /* .inFirst {
      box-shadow: rgba(50, 50, 93, 0.25) 0px 2px 5px -1px !important;
      border-bottom: 1px solid #EAEFF4;

    } */

    .inFirst {
      display: flex;
      justify-content: center;
      position: relative;
    }

    .classroomDiv {
      /* position: absolute; */
      display: flex;
      justify-content: start;
      z-index: 1;
    }

    .classroom-p {
      background-color: #8A2BE2;
      color: white !important;
      padding: 0.5em !important;
      border-radius: 0 0 0.5em 0!important;
      box-shadow: rgba(50, 50, 93, 0.25) 0px 2px 5px -1px !important;


    }

    /* .classroomDiv2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      position: absolute;
      z-index: 1;
      top: 55%;
    } */

    .card-1 {
      width: 90% !important;
      height: fit-content !important;
      transition: all 0.8s cubic-bezier(0.15, 0.83, 0.66, 1);
      cursor: pointer;
      border-radius: 0.5em;
      box-shadow: rgba(50, 50, 93, 0.25) 0px 2px 5px -1px !important;

    }

    .card-1:hover {
      transform: scale(1.05);
    }

    .card-header {
      border-right: 1px solid #EAEFF4;
      border-bottom: 1px solid #EAEFF4;

    }

    .classroomDiv {
      border-top: 1px solid #EAEFF4;
      /* padding-top: 2em !important; */

    }
    .dark .classroomDiv {
      border-top: 1px solid #555;
    }

    .a-list-1 {
      color: #8A2BE2 !important;
    }

    .setColumn {
      display: grid;
      grid-template-columns: 1fr;
    }

    .setColumn-p {
      display: grid;
      grid-template-columns: 1.25fr 1.25fr 0.5fr !important;
      padding-bottom: 0.5em !important;
      margin-bottom: 0.5em !important;

      border-bottom: 1px solid #0D6EFD;
      
    }

    .setColumn-p-lesson {
      display: grid;
      grid-template-columns: 1.25fr 0.75fr !important;
      padding-bottom: 0.5em !important;
      margin-bottom: 0.5em !important;
      border-bottom: 1px solid #0D6EFD;
      
    }

    .setColumn-p-2 {
      display: grid;
      grid-template-columns: 1.25fr 1.25fr 0.5fr !important;
      font-size: smaller;
    }

     .setColumn-p-lesson-2 {
      display: grid;
      grid-template-columns: 1.25fr 0.75fr !important;
      font-size: smaller;
    }

    .a-link {
      color: #5A6A85;
      padding-bottom: 0.5em !important;
      margin-bottom: 0.5em !important;
    }

    @keyframes moveUpDown {
      0% {
        transform: translateY(0);
      }

      50% {
        transform: translateY(10px);
      }

      100% {
        transform: translateY(0);
      }
    }

    .upDownDiv {
      animation: moveUpDown 1s infinite;
    }

    .upDownDiv {
      position: relative;
      transition-duration: 0.3s;
    }

    .up-down-a:hover,
    .up-down-a:hover .bi {
      color: #8A2BE2 !important;
      transition: 0.3s;
    }

    /* .logo-dent {
      box-shadow: rgba(50, 50, 93, 0.25) 0px 2px 5px -1px !important;
      border-radius: 50%;
      width: fit-content;
      height: auto;
    } */
    /* .secondDiv{
      margin-top: 6em !important;
    } */

    /* .box {
      transform: translateX(400%);
      transition: transform 0.8s ease;
    }
    .box:nth-of-type(even){
      transform: translateX(-400%);
    }
    .box.show {
      transform: translateX(0);
    } */

    .firstDiv {
      height: fit-content;
      background-image: url('/images/bg-2.jpg') !important;
      /* filter: blur(6px); */
      background-position: center;
      background-repeat: no-repeat;
      background-size: cover;
      z-index: 0;
      box-shadow: inset 0 0 0 2000px rgba(0, 0, 0, 0.3);

    }

    .setShadow {
      box-shadow: rgba(50, 50, 93, 0.25) 0px 2px 5px -1px !important;
    }

    .lesson-content{
      transition: all 0.3s ease;
   
      height: 220px !important;
    }
    .lesson-content:hover {
    transform: translateY(-5px);
    box-shadow: 0 4px 8px rgba(187, 134, 252, 0.2);
    border-color: #bb86fc;
}
    body.light {
      background-color: #ffffff;
      color: #000000;
    }

    body.dark {
      background-color: #212121;
      color: #ffffff;
    }

    .dark .bg-white {
      background-color: #444 !important;
      color: #ffffff !important;
    }

    .dark .text-dark {
      color: #ffffff !important;
    }

    .dark .text-primary {
      color: #bb86fc !important;
    }

    .dark .bg-primary {
      background-color: #bb86fc !important;
    }

    /* Additional dark mode styles as needed */
    .dark .classroom-p {
      
      color: white !important;
    }

    /* Override other styles for dark mode */
    .dark .lesson-content {
      background-color: #444 !important;
    }

    .dark .up-down-a:hover,
    .dark .up-down-a:hover .bi {
      color: #bb86fc !important;
    }

    .dark .setColumn-p {
      border-bottom-color: #bb86fc;
    }

    .dark .setColumn-p-lesson {
      border-bottom-color: #bb86fc;
    }

    .dark .a-link {
      color: #bb86fc !important;
    }
    .menu-header {
    cursor: pointer;
    display: flex;
    align-items: center;
}

.bi-chevron-down {
    transition: transform 0.3s ease;
    margin-left: auto;
}

.menu-header.active .bi-chevron-down {
    transform: rotate(180deg);
}

.menu-content {
    display: none;
    padding-left: 1rem;
}
    @media screen and (max-width: 768px) {
         .above-nav-status{
           display: none;
         }
       }
  </style>

</head>

<body>
  <nav>
    <%- include("./partials/studentNav.ejs") %>
  </nav>
  <div class="firstDiv row w-auto" style="margin-top: 5em !important; margin-bottom: 5em !important">
    <div class="setShadow">
      <div class="inFirst row px-5 py-5 flex-column flex-md-row">
        <div class="col-md-4 d-flex justify-content-center">
          <img class="w-75 h-auto logo-dent" src="/images/indexMed/Ellipse9.png" alt="ตราสัญลักษณ์ คณะทันตแพทยศาตร์" style="height: auto; width: auto; max-width: 35em; max-height: 23em; object-fit: contain;">
        </div>
        <div class="home-container col-md-8 d-flex text-white align-items-center mt-4 mt-md-0">
          <div>
            <p class="border-purple mb-2">
              <span class="fs-3">สื่อการเรียนการสอนออนไลน์ : เรื่องส่วนประกอบของฟันเทียม</span><br>
              <span class="fs-4">Online Learning : Component Parts of Dental Prosthesis</span>
            </p>
            <p>
              <span class="fs-4 md-fs-5">คณะทันตแพทยศาสตร์ มหาวิทยาลัยขอนแก่น</span><br>
              <span class="fs-4  md-fs-5">Faculty of Dentistry Khon Kaen University</span>
            </p>
          </div>
        </div>
      </div>
    </div>
     </div>
  <div class="upDownDiv d-flex justify-content-center" style="margin-bottom: 10em !important;">
    <a href="#forUpdown" class="text-dark up-down-a">
      <i class="bi bi-chevron-double-down fs-1"></i>
    </a>
  </div>
  <div class="classroomDiv col-12 w-100" id="forUpdown" data-aos="fade-right" data-aos-duration="1000">
    <p class="fw-bold fs-3 text-primary classroom-p">ห้องเรียน</p>
  </div>
  <div class="row px-3 py-4 secondDiv">
    <% navSubjects.sort((a, b) => new Date(b.updatedAt) - new Date(a.updatedAt)).slice(0, 3).forEach(subject => { %>   
         <div class="col-16 col-lg-4 box" data-aos="fade-up" data-aos-duration="1000" >
        <a href="/eachSubject?subjectDbId=<%= subject._id %>" class="text-decoration-none">

        <div class="lesson-content  mx-3 bg-white w-auto my-2" style=" overflow-y: auto;">
          <div class="px-3 my-3">
            <div class="setColumn h-100 d-flex flex-column justify-content-between position-relative" >
       
           
              <div class="setColumn-p-lesson fw-bold fs-5" >
                <p class="mb-0">
                  <%= subject.subjectId + ' ' + subject.subjectName %>
              </p>
              <p class="mb-0">
                  <%= subject.semester + ' กลุ่มที่: ' + subject.section %>
              </p>
              
              <!-- <p>Times</p> -->
            </div>
              <div class="setColumn-p-lesson-2" style="color:#bb86fc;">
                <p>บทเรียน</p>
                <p><%= subject.lessonArray.length %></p>
              </div>
              <div class="setColumn-p-lesson-2" style="color:#bb86fc;">
                <p>แบบทดสอบ</p>
                <p><%= subject.quizArray.length %></p>
              </div>
              <div class="setColumn-p-lesson-2" style="color:#bb86fc;">
                <p>งานที่มอบหมาย</p>
                <p><%= subject.Assignments.length %></p>
              </div>
              <br>
              <div class="setColumn-p-lesson-2 d-flex justify-content-end" style="color:#bb86fc;">
                แก้ไขล่าสุดเมื่อ <%= new Date(subject.updatedAt).toLocaleDateString('th-TH') %>
              </div>
          
          
          </div>
        </div>
      </div>
    </a>
    </div>
    <% }) %>
  
   
  </div>
   <div class="d-flex justify-content-end  mb-4" >

        <a href="/subjects" class="me-4">ดูรายวิชาทั้งหมด..(<%= navSubjects.length %> วิชา)</a>

    </div>
  <%- include("./partials/footer.ejs") %>
