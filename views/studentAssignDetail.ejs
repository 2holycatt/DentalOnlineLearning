<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>รายละเอียดงานที่มอบหมาย</title>
  <%- include("./partials/header.ejs")%>
  <!-- <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous"> -->
  <link rel="stylesheet" href="/css/assignment.css">
  <link rel="stylesheet" href="/css/fixedSwal.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/noty@4/lib/noty.css">
  <script src="https://cdn.jsdelivr.net/npm/noty@4/lib/noty.min.js"></script>
  <style>
    .list-div,
    .list-div-data {
      grid-template-columns: 1fr 1fr 1fr 1.25fr 0.75fr;

    }
    * {
        box-sizing: border-box !important;
      }
      body.dark {
          background-color: #212121 !important;
        }
      .card-1,
      .card-body-1 {
        border: none !important;
      }
  
      .descp {
        text-indent: 2em;
        margin: 0 2em;
      }
  
      .rectangle-141 {
        background-color: white;
        border-radius: 0.75em;
        box-shadow: 0em 0.75em 1.5em -0.25em #919eab1f, 0em 0em 0.125em #919eab33;
        height: 14.6875em;
        width: 75%;
        margin: 2em 2em;
      }
  
      .home-div,
      .a-home {
        color: #999999 !important;
      }
  
      .above-nav {
        background-color: white !important;
        border-bottom: 1px solid #999999;
      }
  
      .dark .above-nav-status {
        background-color:  var(--secondary-color) !important;
        border-right:1px solid #494949 ;
      }
  
      .status-a {
        color: #404258 !important;
      }
  
      .list-lesson-p {
        color: #8A2BE2;
      }
  
      .list-lesson-p-span {
        color: #4B0082;
      }
  
      .each-lesson {
        border-top: 0.1em solid #8A2BE2;
      }
  
      .aside-right {
        background-color: var(--bg-color) !important;
        height: 100%;
      }
  
      .manange-bar {
        border-radius: 0.5em;
        justify-content: space-between !important;
        
      }
  
      .add-button {
        border-radius: 0.5em !important;
        width: 20% !important;
        height: auto !important;
      }
  
      .lesson-content {
        height: fit-content !important;
        border-radius: 1em !important;
        justify-content: center !important;
      }
      .dark .manange-bar, .dark .lesson-content{
        background-color:  var(--secondary-color) !important;
      }
  
      .lesson-nothing {
        margin: 25% 0 !important;
        padding: 0 !important;
      }
  
      .each-lesson-a {
        text-decoration: none !important;
      }
  
      .each-lesson-a:hover .each-lesson {
        border-left: 0.2em solid #8A2BE2 !important;
      }
  
      .card-img-top {
        box-shadow: rgba(0, 0, 0, 0.15) 1.95px 1.95px 2.6px !important;
      }
  
      .setColumn {
        display: grid !important;
        grid-template-columns: 1fr 1fr 1fr !important;
      }
  
      .card-a {
        text-decoration: none !important;
      }
  
      .card-a:hover,
      .card-a:hover .p-lesson-name {
        color: #007bff !important;
        transition: 0.5s;
      }
  
      .card-a:hover .bi-book {
        color: #007bff !important;
        transition: color 0.5s;
      }
  
      .bi-book-fill {
        display: none;
      }
  
      .card-a:hover .bi-book-fill {
        display: inline-block !important;
        transition: 0.5s;
      }
  
      .card-a:hover .bi-book {
        display: none;
        transition: 0.5s;
      }
  
      .manange-bar,
      .lesson-content {
        box-shadow: rgba(50, 50, 93, 0.25) 0px 2px 5px -1px !important;
        border-radius: 0.5em;
      }
  
      .card-1 {
        width: 90% !important;
        height: fit-content !important;
        transition: all 0.8s cubic-bezier(0.15, 0.83, 0.66, 1);
        cursor: pointer;
        border-radius: 0.5em;
        box-shadow: rgba(50, 50, 93, 0.25) 0px 2px 5px -1px !important;
      }
  
      .card-1:hover {
        transform: scale(1.05);
      }
  
      .card-header {
        border-right: 1px solid #EAEFF4;
        border-bottom: 1px solid #EAEFF4;
      }
  
      .a-list-2,
      .bi-2 {
        color: #8A2BE2 !important;
        
      }
      .gray{
        color: gray !important;
      }
      .dark .gray{
        color: lightgray !important;
      }
      .dark .descriptionText {
    background-color: #4444 !important;
    color: white !important;
  }
  .border-grey{
    border-top: 1px solid #999999 !important;
    border-bottom: 1px solid #999999 !important;
  }
  .dark .border-grey{
    border-top: 1px solid #555 !important;
    border-bottom: 1px solid #555 !important;
  }
  .link{
        color: gray;
      }
      .dark .link{
        color: rgb(231, 231, 231);
      }
      .dark .link:hover ,.link:hover{
        text-decoration: underline;
        color: #ba55d3 !important;
      }
      .link{
        color: gray;
      }
      .dark .link{
        color: rgb(231, 231, 231);
      }
      .dark .link:hover ,.link:hover{
        text-decoration: underline;
        color: #ba55d3 !important;
      }
      @media screen and (max-width: 768px) {
        .above-nav-status{
          display: none;
        }
      }
  </style>
</head>

<body>
  <div id="blur-container">
    <%- include("./partials/studentNav.ejs")%>
    <!-- <div class="above-nav d-flex px-4 py-3">
      <div class="home-div above-nav-home d-flex mx-2 my-0 align-middle">
        <i class="bi bi-house mx-2"></i>
        <a href="/adminIndex" class="a-home">
          <p class="m-0">หน้าหลัก &nbsp;&nbsp;></p>
        </a>
      </div>
      <a href="#" class="status-a mx-2 my-0 align-middle">
        <p class="m-0">บทเรียน</p>
      </a>
    </div> -->
  </div>
  <div class="main-content d-flex w-100 h-auto">
    <%- include("./partials/studentAside.ejs")%>
    <div class="aside-right w-75 h-auto p-4 m-3">
      <div class="lesson-content bg-white w-100 py-3 px-4 " style="height: fit-content;">
        <div class="py-3 ps-1  d-flex w-100">
          <div class="fw-normal fs-6 ms-1">
            <span> <i class="bi bi-clipboard-check me-1" style="cursor: default;color: #8A2BE2;"></i>
            </span>
            <span>
              <a class='link' href="/subjects"> รายวิชาทั้งหมด </a>
            </span>
            <span> / </span> 
            <a class="grey link" href="/eachSubject?subjectDbId=<%=subject._id%>">
              <%=subject.subjectId%> <%=subject.subjectName%> <%=subject.semester%> กลุ่มที่: <%=subject.section%>
            </a> 
            <span>   / งานที่มอบหมาย:  <%=assignment.name%></span> 

          </div>
        </div>
        <div >
          <div class="d-flex justify-content-between align-items-center w-100">
            <div class="flex-grow-1 mb-3">
              <p class="fw-normal fs-3 ms-2"><%=assignment.name%></p>
            </div>
           
          </div>
            <div class="row  ms-2 ">
          <div class="form-control w-100 descriptionText p-1" name="Description" disabled><%=assignment.Description%></div>
        </div>
        <br>
          <div class="col-12 row my-2 ms-2">
           
         
            <div class="col-4">
              <p class="fs-6 fw-bold"><i class="fs-5 bi bi-stopwatch text-success"></i><span class="mx-1 text-success">วันที่เปิดให้ส่ง</span>: <span class="fw-normal"><%=formattedStartDate%></span></p>
            </div>
            <div class="col-4">
              <p class="fs-6 fw-bold"><i class="fs-5 bi bi-stopwatch text-danger"></i><span class="mx-1 text-danger">วันที่หมดเขตส่ง</span>: <span class="fw-normal"><%=formattedDeadline%></span></p>
            </div>
          </div>
        </div>
      <br>
        <div class="row ms-2">
          <div class="col-8">
            <p class="my-1 w-100 fw-bold">ไฟล์ที่เกี่ยวข้อง:</p>
            <% if (assignment.files.length > 0) { %>
            <div class="row">
              <div class="col-12">
                <% const files = assignment.files%>
                <% files.forEach((file, index) => { %>
                <a class="file-a" href="/adminIndex/showFileArray?id=<%=assignment._id%>&index=<%=index%>">
                  <span class=""><%=index+1%>. </span>
                  <%= file.file ? file.file.slice(67) : file.originalName || 'ไม่พบชื่อไฟล์' %>                </a>
                <br>
                <% }); %>
              </div>
            </div>
            <% } else if (assignment.files.length < 1) { %>
            <div class="row ms-2">
              <p class="fs-6 text-center py-2 border-grey" >ไม่มีไฟล์ที่ถูกแนบ</p>            </div>
            <% } %>
          </div>
          <div class="col-4">
            <div class="row ms-2">
              <div class="col-6">
                <p class="my-1 w-100 text-center fw-bold fs-5 ">สถานะการส่ง</p>
              </div>
              <div class="col-6">
                <p class="my-1 w-100 text-center fw-bold fs-5 ">คะแนนที่ได้</p>
              </div>
            </div>
            <div class="row">
              <div class="h-auto row">
                <div class="col-6 setRight p-3 d-flex justify-content-center align-items-center flex-column">
                  <% if (userSubmit) { %>
                    <% if (userSubmit.sendStatus && userSubmit.sendStatus.status) { %>
                      <% if (userSubmit.sendStatus.status == "ส่งตรงเวลา") { %>
                        <p class="fw-bold fs-5 text-success mb-2"><%=userSubmit.sendStatus.status%></p>
                      <% } else { %>
                        <p class="fw-bold fs-5 text-danger mb-2">
                          <%=userSubmit.sendStatus.status%>
                          <% if (userSubmit.sendStatus.day || userSubmit.sendStatus.hour || userSubmit.sendStatus.minute) { %>
                            <br>
                            <span class="fs-5">
                              <%=userSubmit.sendStatus.day%> วัน
                              <%=userSubmit.sendStatus.hour%> ชั่วโมง
                              <%=userSubmit.sendStatus.minute%> นาที
                            </span>
                          <% } %>
                        </p>
                      <% } %>
                      <div class="mt-2">
                        <a href="#editAssignment" class="submit-a text-primary">
                          <i class="bi bi-pencil me-1"></i>แก้ไขงานที่ส่ง
                        </a>
                      </div>
                    <% } %>
                  <% } else { %>
                    <p class="fw-bold fs-5 text-danger mb-2">ยังไม่ส่ง</p>
                    <div class="mt-2">
                      <a href="#submitForm" class="submit-a text-primary">
                        <i class="bi bi-send me-1"></i>ส่งงาน
                      </a>
                    </div>
                  <% } %>
                </div>
                
                <div class="col-6 p-3 d-flex justify-content-center align-items-center">
                  <p class="fw-bold fs-2 <%= userSubmit ? 'text-success' : 'text-danger' %>">
                    <%= userSubmit ? userSubmit.Score : '0' %> / <%=assignment.Score%>
                  </p>
                </div>
              </div>
            </div>
          
            <!-- Add submission stats at bottom -->
            <div class="mt-3 pt-3 border-top ">
              <p class="text-secondary mb-1 text-center">
                <i class="bi bi-people me-2"></i>
                จำนวนผู้ส่งงาน: <%=assignment.sentCount%> คน
              </p>
           
            </div>
          </div>
        </div>
        <!-- <p class="fw-bold fs-5 my-1 mx-2" style="border-left: 0.25em solid #387bef; padding-left: 0.75em !important;">มอบหมายงาน
        </p> -->
      </div>

     
      <% if (userSubmit) { %>
      <% if (userSubmit.checked == true) { %>
      <div class="lesson-content bg-white w-100 p-4 my-4" style="height: fit-content;">
        <p class="fs-5 fw-bold fs-5"><i class="bi bi-info-circle-fill text-primary "></i>
          รายละเอียดการตรวจ
        </p>
        <div class="py-1" style="border-bottom: 1px solid #EAEFF4;">
          <p class="text-primary">คะแนนที่ได้: <span class="text-dark"><%=userSubmit.Score%></span></p>
          <p class="text-primary w-75">ความคิดเห็นจากผู้ตรวจ: <span class="text-dark"><%=userSubmit.teacherComment%></span></p>
          <% const checkDate = new Date(userSubmit.checkDate).toLocaleString('en-US', {timeZone: 'Asia/Bangkok', hour12: true, year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit'}); %>
          <p class="text-success">วันที่และเวลาตรวจ: <span class="text-dark"><%=checkDate.replace(',','')%></span></p>
        </div>
        <div class="my-1">
          <p class="fw-bold">โดย: <span class="fw-normal">ดร. สุรัชธัยณโยธิน วงศ์สวัสดิ</span></p>
        </div>
      </div>
      <% } %>
      <% } %>
      <div class="lesson-content bg-white w-100 p-4 my-4" style="height: fit-content;">
        <% if (userSubmit) { %>
        <form action="/studentEditAssignment" id="editAssignment" method="post" enctype="multipart/form-data">
          <input type="text" name="submitAssignId" class="d-none" value="<%=userSubmit._id%>">
          <input type="text" name="assignId" class="d-none" value="<%=assignment._id%>">
          <div class="assignFormContainer row">
            <div class="col-12 mb-3">
              <p class="fs-5 fw-bold"><i class="bi bi-pencil text-warning fs-5"></i>
                แก้ไขงานที่ส่ง: <span><%=assignment.name%></span>
              </p>
            </div>
            <div class="col-12">
              <div class="my-1 mb-3">
                <label for="comment" class="form-label fs-bold">ความคิดเห็น:</label>
                <textarea class="form-control w-50 p-3" name="comment" style="height: 100px;"><%=userSubmit.comment%></textarea>
              </div>
              <div class="mb-3 row w-50">
                <p>ไฟล์ที่ถูกแนบ:</p>
                <div class="row">
                  <% if (userSubmit.files.length< 1) {%>
                  <p class="mx-1" style="font-size: small;"> - ไม่มีไฟล์ที่ถูกอัปโหลด</p>
                  <% } else if (userSubmit.files.length > 0) {%>
                  <% let files = userSubmit.files; %>
                  <% files.forEach((file, index) => { %>
                  <div class="row">
                    <div class="col-7">
                      <a class="file-a-2 mb-1" href="/studentIndex/showFileArray2?id=<%=userSubmit._id%>&index=<%=index%>">
                        <%=index+1%>.  <%= file.file ? file.file.slice(67) : file.originalName || 'ไม่พบชื่อไฟล์' %>                </a>

                      </a>
                    </div>
                    <div class="col-2 d-flex justify-content-center">
                      <a href="/studentIndex/delFile?assignId=<%=userSubmit._id%>&fileIndex=<%=index%>" class="text-danger fs-6 delFile">ลบ</a>
                    </div>
                  </div>
                  <% }) %>
                  <% }%>
                </div>
              </div>
              <div class="my-1 mb-3">
                <label for="formFileMultiple" class="form-label">แนบไฟล์:</label>
                <input class="form-control w-50 file-input" name="file" type="file" id="formFileMultiple" accept="image/*,
                application/pdf,
                application/vnd.openxmlformats-officedocument.wordprocessingml.document,
                application/msword,video/*,
                application/vnd.ms-powerpoint,
                application/vnd.openxmlformats-officedocument.presentationml.presentation,
                application/vnd.ms-excel,
                application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" multiple>                <p class="p-1" style="font-size: small;"><span class="text-primary">ประเภทไฟล์ที่รองรับ:</span> รูปภาพ, PDF, Word, Power Point และ Excel ขนาดไม่เกิน 100 mb</p>
              </div>
            </div>
            <div class="col-12 d-flex justify-content-start pt-4" style="border-top: 1px solid #EAEFF4;">
              <button class="btn btn-warning p-2" type="submit">บันทึกการแก้ไข <i class="bi bi-pencil text-dark"></i></button>
              <a href="/studentCancelAssign?submitId=<%=userSubmit._id%>&assignmentId=<%=assignment._id%>" 
                class="btn btn-danger p-2 mx-3"
                onclick="return confirm('คุณแน่ใจหรือไม่ที่จะยกเลิกการส่งงาน?')">
                 ยกเลิกการส่งงาน
             </a>
            </div>
          </div>
        </form>
        <% } else if (!userSubmit) { %>
        <form action="/submitAssignment" id="submitForm" method="post" enctype="multipart/form-data">
          <input type="text" name="assignId" class="d-none" value="<%=assignment._id%>">
          <input type="text" name="userId" class="d-none" value="<%=userData._id%>">
          <div class="assignFormContainer row">
            <div class="col-12 mb-3">
              <p class="fs-5 fw-bold"><i class="bi bi-send text-success fs-5"></i>
                ส่งงาน: <span><%=assignment.name%></span>
              </p>
            </div>
            <div class="col-12">
              <div class="my-1 mb-3">
                <label for="comment" class="form-label fs-bold">ความคิดเห็น:</label>
                <textarea class="form-control w-50 p-3" name="comment" style="height: 100px;"></textarea>
              </div>
              <div class="my-1 mb-3">
                <label for="formFileMultiple" class="form-label">แนบไฟล์:</label>
                <input class="form-control w-50 file-input" name="file" type="file" id="formFileMultiple" accept="image/*,
                application/pdf,
                application/vnd.openxmlformats-officedocument.wordprocessingml.document,
                application/msword,video/*,
                application/vnd.ms-powerpoint,
                application/vnd.openxmlformats-officedocument.presentationml.presentation,
                application/vnd.ms-excel,
                application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" multiple>
                <p class="p-1" style="font-size: small;"><span class="text-primary">ประเภทไฟล์ที่รองรับ:</span> รูปภาพ, PDF, Word, Power Point และ Excel ขนาดไม่เกิน 100 mb</p>
              </div>
            </div>
            <div class="col-12 d-flex justify-content-start pt-4" style="border-top: 1px solid #EAEFF4;">
              <button class="btn btn-success p-2" type="submit">ส่งงาน <i class="bi bi-send text-light"></i></button>
            </div>
          </div>
        </form>
        <% } %>
      </div>

    </div>
  </div>
  </div>
  <%- include("./partials/footer.ejs")%>
</body>


</html>