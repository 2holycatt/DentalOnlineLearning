        <div class="row">
          <form action="/adminIndex/setPermissionStudentLists" method="post">
            <% if (students.docs.length > 0) { %>
            <div class="file-example w-100">
              <div class="list-div purple row">
                <p class="fw-bold my-3 col-1 text-center">
                  #
                </p>
                <p class="fw-bold my-3 col-2">
                  รหัสนักศึกษา
                </p>
                <p class="fw-bold my-3 col-3">
                  ชื่อ - นามสกุล
                </p>
                <p class="fw-bold my-3 col-3">
                  ที่อยู่อีเมล (Email)
                </p>
                <p class="fw-bold my-3 col-1">
                  คณะ
                </p>
                <p class="fw-bold my-3 col-2">
                  นักศึกษาจาก
                </p>
              </div>
              <% students.docs.forEach(student => { %>
                <input type="hidden" name="studentIds[]" value="<%= student._id %>">
              <div class="list-div-data row">
                <div class="form-check col-1 d-flex align-items-center justify-content-center">
                  <% if (student.user.permission == true) {%>
                  <input class="form-check-input checkStudent" type="checkbox" name="userLists[]" value="<%=student.user._id%>" checked>
                  <% } else if (student.user.permission == false) { %>
                  <input class="form-check-input checkStudent" type="checkbox" name="userLists[]" value="<%=student.user._id%>">
                  <% } %>
                </div>
                <p class="fw-normal my-3 col-2 grey">
                  <%=student.studentId%>
                </p>
                <p class="fw-normal my-3 col-3 grey truncate-text" title="<%=student.user.fname%> <%=student.user.lname%>">
                  <%=student.user.fname%> <%=student.user.lname%>
                </p>
                <p class="fw-normal my-3 col-3 grey">
                  <%=student.user.email%>
                </p>
                <p class="fw-normal my-3 col-1 grey">
                  <%=student.user.major%>
                </p>
                <% if (student.user.studentFromKku == true) { %>
                <p class="fw-normal my-3 col-2 text-kku" >
                  มหาวิทยาลัยขอนแก่น
                </p>
                <% } else if (student.user.studentFromKku == false) { %>
                <p class="fw-normal my-3 col-2 grey">
                  ภายนอก
                </p>
                <% } %>
              </div>
              <% }); %>
            </div>
            <% } else if (students.docs.length < 1) { %>
            <p class="mt-3">ยังไม่มีนักศึกษาใด ๆ ภายในระบบ</span>
            </p>
            <% } %>
            <div class="d-flex justify-content-between align-items-center">
              <div class="d-flex justify-content-end mt-3">
                <nav aria-label="Page navigation example">
                  <ul class="pagination">
                    <% if (students.hasPrevPage) { %>
                    <li class="page-item">
                      <a class="page-link px-2" href="/adminIndex/setPermission?page=<%= students.prevPage %>&limit=<%= students.limit %>">ก่อนหน้า</a>
                    </li>
                    <% } else { %>
                    <li class="page-item disabled">
                      <a class="page-link px-2" href="#">ก่อนหน้า</a>
                    </li>
                    <% } %>

                    <% let startPage = Math.max(students.page - 1, 1); %>
                    <% let endPage = Math.min(startPage + 2, students.totalPages); %>

                    <% if (startPage > 1) { %>
                    <li class="page-item">
                      <a class="page-link px-2" href="/adminIndex/setPermission?page=1&limit=<%= students.limit %>">1</a>
                    </li>
                    <% if (startPage > 2) { %>
                    <li class="page-item disabled"><a class="page-link px-2">...</a></li>
                    <% } %>
                    <% } %>


                    <% for (let i = startPage; i <= endPage; i++) { %>
                    <li class="page-item <%= students.page === i ? 'active' : '' %>">
                      <a class="page-link px-2" href="/adminIndex/setPermission?page=<%= i %>&limit=<%= students.limit %>"><%= i %></a>
                    </li>
                    <% } %>


                    <% if (endPage < students.totalPages) { %>
                    <% if (endPage < students.totalPages - 1) { %>
                    <li class="page-item disabled"><a class="page-link">...</a></li>
                    <% } %>
                    <li class="page-item">
                      <a class="page-link px-2" href="/adminIndex/setPermission?page=<%= students.totalPages %>&limit=<%= students.limit %>"><%= students.totalPages %></a>
                    </li>
                    <% } %>

                    <% if (students.hasNextPage) { %>
                    <li class="page-item">
                      <a class="page-link px-2" href="/adminIndex/setPermission?page=<%= students.nextPage %>&limit=<%= students.limit %>">ถัดไป</a>
