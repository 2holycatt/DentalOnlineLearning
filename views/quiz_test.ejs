        <script>


    let questions = <%- JSON.stringify(questions) %>;

            const QuizStorage = {
    // เพิ่มการ debounce เพื่อลดการบันทึกถี่เกินไป
    debounceTimeout: null,

    debounce(func, wait = 300) {
        clearTimeout(this.debounceTimeout);
        this.debounceTimeout = setTimeout(func, wait);
    },

    saveImmediate(quizId, questionIndex, type, value) {
    try {
      const key = this.getKey(quizId);
      let answers = this.getAllAnswers(quizId);
      
      // เพิ่มการจัดการสำหรับ matching type
      if (type === 'matching') {
        // value ควรเป็น array ของ matches ในรูปแบบ [{leftIndex: number, rightIndex: number}]
        answers[questionIndex] = {
          type,
          value: value.map(match => ({
            leftIndex: match.leftIndex,
            rightIndex: match.rightIndex
          })),
          timestamp: Date.now()
        };
      } else {
        answers[questionIndex] = { type, value, timestamp: Date.now() };
      }
      
      localStorage.setItem(key, JSON.stringify(answers));
      console.log(`Saved answer for question ${questionIndex}:`, value);
    } catch (error) {
      console.error('Error saving answer:', error);
    }
  },

    getAllAnswers(quizId) {
        return safeLocalStorageOperation(() => {
            const key = this.getKey(quizId);
            return JSON.parse(localStorage.getItem(key) || '{}');
        }) || {};
    },

    getKey(quizId) {
        return `quiz_${quizId}_answers_v2`; // เพิ่ม version เพื่อป้องกันการชนกับข้อมูลเก่า
    }
};

const matchingStorage = {
  // เก็บ matches ปัจจุบันสำหรับแต่ละคำถาม
  currentMatches: new Map(),

  // บันทึก match ใหม่
  saveMatch(questionIndex, leftIndex, rightIndex) {
    const matches = this.currentMatches.get(questionIndex) || [];
    
    // ลบ matches เก่าที่มี leftIndex หรือ rightIndex ซ้ำ
    const filteredMatches = matches.filter(match => 
      match.leftIndex !== leftIndex && match.rightIndex !== rightIndex
    );
    
    // เพิ่ม match ใหม่
    filteredMatches.push({ leftIndex, rightIndex });
    this.currentMatches.set(questionIndex, filteredMatches);
    
    // บันทึกลง localStorage
    QuizStorage.saveImmediate(
      document.getElementById('form').dataset.quizId,
      questionIndex,
      'matching',
      filteredMatches
    );
  },

  // โหลด matches จาก localStorage
  loadMatches(questionIndex, answers) {
    if (!answers[questionIndex] || answers[questionIndex].type !== 'matching') return;
    
    const matches = answers[questionIndex].value;
    if (!Array.isArray(matches)) return;
    
    this.currentMatches.set(questionIndex, matches);
    return matches;
  }
};

function saveAllAnswers() {
    const quizId = document.getElementById('form').dataset.quizId;
    const answers = {};

    document.querySelectorAll('.question').forEach(questionDiv => {
        const originalIndex = questionDiv.dataset.originalIndex;
        if (!originalIndex) return;

        const optionsDiv = questionDiv.querySelector('.options');
        if (!optionsDiv) return;

        const questionType = optionsDiv.dataset.type;
        let value = null;

        try {
            switch (questionType) {
                case 'MCQ':
                    const radio = questionDiv.querySelector('input[type="radio"]:checked');
                    if (radio) {
                        value = radio.dataset.originalIndex;
                    }
                    break;

                case 'checkbox':
                    const checked = Array.from(questionDiv.querySelectorAll('input[type="checkbox"]:checked'));
                    value = checked.map(cb => cb.dataset.originalIndex);
                    break;

                case 'Paragraph':
                case 'short_answ':
                    const textarea = questionDiv.querySelector('textarea');
                    value = textarea ? textarea.value.trim() : '';
                    break;

                case 'matching':
                    // ใช้ originalIndex สำหรับ matching pairs
                    value = Array.from(questionDiv.querySelectorAll('.matching-line')).map(line => ({
                        left: parseInt(line.dataset.left),
                        right: parseInt(line.dataset.right)
                    }));
                    break;
            }

            if (value !== null) {
                answers[originalIndex] = {
                    type: questionType,
                    value: value
                };
            }

        } catch (error) {
            console.error(`Error saving question ${originalIndex}:`, error);
        }
    });

    try {
        localStorage.setItem(`quiz_${quizId}_answers_v2`, JSON.stringify(answers));
    } catch (error) {
        console.error('Storage save error:', error);
    }
}

function loadSavedAnswers() {
    const quizId = document.getElementById('form').dataset.quizId;
    try {
        const saved = localStorage.getItem(`quiz_${quizId}_answers_v2`);
        if (!saved) return;

        const answers = JSON.parse(saved);

        document.querySelectorAll('.question').forEach(questionDiv => {
            // ดึง original index จาก data attribute
            const originalIndex = questionDiv.dataset.originalIndex;
            if (!originalIndex) return;

            // ดึงคำตอบที่บันทึกไว้โดยใช้ original index
            const savedAnswer = answers[originalIndex];
            if (!savedAnswer) return;

            const optionsDiv = questionDiv.querySelector('.options');
            const questionType = optionsDiv?.dataset.type;

            switch (questionType) {
                case 'MCQ':
                    // หา input radio ที่มี data-original-index ตรงกับคำตอบที่บันทึกไว้
                    const radio = questionDiv.querySelector(`input[type="radio"][data-original-index="${savedAnswer.value}"]`);
                    if (radio) radio.checked = true;
                    break;

                case 'checkbox':
                    if (Array.isArray(savedAnswer.value)) {
                        savedAnswer.value.forEach(val => {
                            const checkbox = questionDiv.querySelector(`input[type="checkbox"][data-original-index="${val}"]`);
                            if (checkbox) checkbox.checked = true;
                        });
                    }
                    break;

                case 'Paragraph':
                case 'short_answ':
                    const textarea = questionDiv.querySelector('textarea');
                    if (textarea && savedAnswer.value) {
                        textarea.value = savedAnswer.value;
                        adjustHeight(textarea);
                    }
                    break;

                case 'matching':
                    if (Array.isArray(savedAnswer.value)) {
                        restoreMatching(originalIndex, savedAnswer.value);
                    }
                    break;
            }
        });
    } catch (error) {
        console.error('Error loading answers:', error);
    }
}

