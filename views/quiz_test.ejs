                                oninput="saveQuizSettings(); togglePlaceholder('quizname', 'ชื่อแบบทดสอบ')"
                                onfocus="removePlaceholder('quizname')"
                                onblur="addPlaceholder('quizname', 'ชื่อแบบทดสอบ')">
                                <%=quiz.quizname%>
