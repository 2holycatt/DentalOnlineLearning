async function submitQuiz(quizId) {
    try {
        clearInterval(timerInterval);
        
        // Get the total duration for this attempt
        const totalDuration = getElapsedTime(quizId);
        const attemptId = localStorage.getItem(`quiz_${quizId}_attempt_id`);
        
        // สร้างอาร์เรย์เก็บคำตอบ
        const answers = [];

        // รวบรวมคำตอบจากทุกคำถาม
        document.querySelectorAll('.question').forEach((questionDiv) => {
            // ข้ามหัวข้อหรือคำถามที่ไม่มี ID
            if (!questionDiv.dataset.questionId || !questionDiv.dataset.originalIndex) return;
            
            const questionId = questionDiv.dataset.questionId;
            const originalIndex = questionDiv.dataset.originalIndex;
            const optionsDiv = questionDiv.querySelector('.options');
            
            if (!optionsDiv) return;
            
            const questionType = optionsDiv.dataset.type;
            
            // เก็บคำตอบตามประเภทคำถาม
            switch (questionType) {
              case 'MCQ':
              const selectedRadio = questionDiv.querySelector('input[type="radio"]:checked');
              if (selectedRadio) {
                  // ดูว่าข้อมูลอยู่ในรูปแบบไหน และตรวจสอบให้แน่ใจว่าส่งค่าที่ถูกต้อง
                  const answerValue = selectedRadio.dataset.originalIndex 
                      ? parseInt(selectedRadio.dataset.originalIndex) 
                      : parseInt(selectedRadio.value);
                  
                  console.log("MCQ answer found:", answerValue, "type:", typeof answerValue);
                  
                  answers.push({
                      questionId: questionId,
                      type: 'MCQ',
                      answer: answerValue // ส่งเป็นตัวเลข not string
                  });
              }
              break;
                
                case 'checkbox':
                    const checkedBoxes = Array.from(questionDiv.querySelectorAll('input[type="checkbox"]:checked'));
                    if (checkedBoxes.length > 0) {
                        answers.push({
                            questionId: questionId,
                            type: 'checkbox',
                            answer: checkedBoxes.map(cb => parseInt(cb.dataset.originalIndex || cb.value))
                        });
                    }
                    break;
                
                case 'Paragraph':
                case 'short_answ':
                    const textarea = questionDiv.querySelector('textarea');
                    if (textarea && textarea.value.trim()) {
                        answers.push({
                            questionId: questionId,
                            type: questionType,
                            answer: textarea.value.trim()
                        });
                    }
                    break;
                
                case 'matching':
                    // ดึงข้อมูล matching จาก localStorage หรือ matchingStorage
                    const questionIndex = questionDiv.dataset.questionIndex;
                    const matches = matchingStorage.currentMatches.get(parseInt(questionIndex));
                    
                    if (matches && matches.length > 0) {
                        answers.push({
                            questionId: questionId,
                            type: 'matching',
                            answer: matches
                        });
                    }
                    break;
            }
        });

        console.log('คำตอบที่จะส่ง:', answers); // สำหรับ debug

        // ส่ง API request
        const response = await fetch(`/studentIndex/submitQuiz/${quizId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                answers: answers,
                duration: totalDuration,
                attemptId: attemptId,
                status: 'completed'
            })
        });

        const result = await response.json();

        if (result.success) {
            // ล้าง localStorage
            localStorage.removeItem(`quiz_${quizId}_start_time`);
            localStorage.removeItem(`quiz_${quizId}_current_duration`);
            localStorage.removeItem(`quiz_${quizId}_attempt_id`);
            localStorage.removeItem(`quiz_${quizId}_answers`);
            localStorage.removeItem(`quiz_${quizId}_answers_v2`);
            localStorage.removeItem(`quiz_${quizId}_matching`);
            
            Swal.fire({
                title: 'ส่งแบบทดสอบสำเร็จ!',
                text: `คะแนนที่ได้: ${result.score} คะแนน`,
                icon: 'success'
            }).then(() => {
                window.location.href = `/studentIndex/eachQuiz?quizId=${quizId}`;
            });
        } else {
            throw new Error(result.message || 'เกิดข้อผิดพลาดในการส่งแบบทดสอบ');
        }
        
    } catch (error) {
        console.error('Submit error:', error);
        Swal.fire({
            title: 'เกิดข้อผิดพลาด!',
            text: error.message || 'ไม่สามารถส่งแบบทดสอบได้',
            icon: 'error'
        });
    }
}

