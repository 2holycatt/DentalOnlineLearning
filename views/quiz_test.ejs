};

function restoreMatching(questionIndex, matches) {
    if (!Array.isArray(matches)) return;
    
    const container = document.querySelector(`#question_${questionIndex} .matching-container`);
    if (!container) return;

    // Clear existing matches
    const linesContainer = container.querySelector('.matching-lines');
    if (linesContainer) linesContainer.innerHTML = '';

    // Restore matches
    matches.forEach(match => {
        const leftItem = container.querySelector(`.left-side .matching-item[data-original-index="${match.left}"]`);
        const rightItem = container.querySelector(`.right-side .matching-item[data-original-index="${match.right}"]`);
        
        if (leftItem && rightItem) {
            leftItem.classList.add('matched');
            rightItem.classList.add('matched');
            drawMatchingLine(leftItem, rightItem);
        }
    });
}

           

           

