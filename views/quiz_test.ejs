                        <div class="input-container mx-2">
                            <p>
                            <div class="question_form_top_desc" id="quizdescription" style="color: gray !important;"
                                name="quizdescription"
                                oninput="saveQuizSettings(); togglePlaceholder('quizdescription', 'คำอธิบายแบบทดสอบ')"
                                onfocus="removePlaceholder('quizdescription')"
                                onblur="addPlaceholder('quizdescription', 'คำอธิบายแบบทดสอบ')">
                                <%=quiz.quizdescription%>
                            </div>
                            </p>
                        </div>
                        </p>




                        <!-- จำนวนข้อ: 
  
  
                  <span class="fw-normal fs-6 text-primary" style="margin-right: 1em !important;">0 ข้อ</span> -->



                        <div class="d-flex">


                        </div>




                    </div>

                    <div style="margin: 0 4rem;">
                        <span id="question-count" class="me-2 fs-5 d-none"></span>
                        <span id="all-points-count" class="grey d-none"></span>
                    </div>

                    <% if (quiz && quiz.questions && quiz.questions.length > 0) { %>
                      <%
    // ฟังก์ชันสำหรับสุ่มลำดับอาร์เรย์
    function shuffleArray(array) {
        for (let i = array.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [array[i], array[j]] = [array[j], array[i]];
        }
        return array;
    }

    // สร้าง array ของ index สำหรับคำถาม
    let questionIndexes = Array.from({length: quiz.questions.length}, (_, i) => i);
    
    // ถ้า isShuffled เป็น true ให้สุ่มลำดับคำถาม
    if (quiz.isShuffled) {
        questionIndexes = shuffleArray(questionIndexes);
    }
    %>
                    <div class="questionContainer">
                      <% questionIndexes.forEach((originalIndex, displayIndex) => { 
                        const question = quiz.questions[originalIndex];
                    %>              
                    <div class="question" id="question_<%= displayIndex %>" 
                      data-question-id="<%= question._id %>"
                      data-question-index="<%= displayIndex %>" 
                      data-original-index="<%= originalIndex %>"
                      style="display: none;">
                      <div class="first">
                        <div class="input-question">
                          <%= question.questionText %>
                          <!-- เพิ่มการแสดงรูปของคำถาม -->
                          <% if (question.questionImage && question.questionImage.url) { %>
                              <div class="question-image-container">
                                  <img src="<%= question.questionImage.url %>" 
                                       alt="Question image"
                                       loading="lazy">
                              </div>
                          <% } %>
                      </div>
                      <span class="grey question-point">
                        <%= question.points %> คะแนน
                    </span>
</div>
                                <br>
                                <div class="options" data-type="<%= question.questionType %>">
                                  <% if (question.questionType === 'MCQ' || question.questionType === 'checkbox') { 
                                    // สร้าง array ของ index สำหรับตัวเลือก
                                    let optionIndexes = Array.from({length: question.options.length}, (_, i) => i);
                                    
                                    // ถ้า isShuffled เป็น true ให้สุ่มลำดับตัวเลือก
                                    if (quiz.isShuffled) {
                                        optionIndexes = shuffleArray(optionIndexes);
                                    }
                                %>
                                    <% optionIndexes.forEach((optionIndex) => { 
                                        const option = question.options[optionIndex];
                                    %>
                                    <div class="form-check" style="display: flex; align-items: center;">
                                      <input class="input_check"
                                          type="<%= question.questionType === 'MCQ' ? 'radio' : 'checkbox' %>"
                                          name="answers_<%= displayIndex %>" 
                                          value="<%= optionIndex %>"
                                          data-original-index="<%= optionIndex %>"
                                          <%= question.selectedOption === optionIndex ? 'checked' : '' %>>
                                      <div style="flex-grow: 1; padding: 5px;">
                                        <div><%= option.optionText %></div>
                                        <!-- เพิ่มการแสดงรูปของตัวเลือก -->
                                        <% if (option.image && option.image.url) { %>
                                            <div class="option-image-container mt-2">
                                                <img src="<%= option.image.url %>" 
                                                     alt="Option image"
                                                     style="max-width: 200px; max-height: 150px; object-fit: contain;">
                                            </div>
                                        <% } %>
                                      </div>
                                  </div>
                                            <% }) %>
                                            <% } else if (question.questionType==='Paragraph' ) { %>
                                              <textarea class="form-control long-text-area auto-expand mx-4 mt-2"            
                                              name="answers[<%= displayIndex %>]"
                                              rows="5" 
                                              style="width:90%; resize: none; overflow-y: auto; min-height: 120px;"
                                              placeholder="พิมพ์คำตอบของคุณที่นี่..."
                                          ><%= question.answerText || '' %></textarea>
                                                <% } else if (question.questionType==='short_answ' ) { %>
                                                  <textarea class="form-control short-text-area auto-expand ms-4 mt-2"
                                                  name="answers[<%= displayIndex %>]" 
                                                  rows="1" 
                                                  style="width:50%; resize: none; overflow-y: auto; min-height: 38px;"
                                                  placeholder="พิมพ์คำตอบของคุณที่นี่..."
                                              ><%= question.answerText || '' %></textarea>
                                        <% } else if (question.questionType === 'matching') { %>
                                          <div class="options" data-type="matching">
                                            <div class="matching-container ms-4 mt-3">
                                                <div class="row position-relative">
                                                    <!-- Left side -->
                                                    <div class="col-5 left-side">
                                                        <% 
                                                        let validItemCount = 0;
                                                        // Filter and map valid items with text or image
                                                        const validLeftItems = question.matchingPairs
                                                            .map((pair, idx) => ({
                                                                text: pair.left.text,
                                                                image: pair.left.image,
                                                                originalIndex: pair.originalIndex || idx
                                                            }));
                                                            
                                                        // Create shuffled array from validLeftItems
                                                        let shuffledLeft = [...validLeftItems].sort(() => Math.random() - 0.5);
                                                        
                                                        // Render shuffled items
                                                        shuffledLeft.forEach((item, idx) => { 
                                                            if (item.text || (item.image && item.image.url)) {
                                                                validItemCount++;
                                                        %>
                                                            <div class="matching-item mb-3" 
                                                                 data-original-index="<%= item.originalIndex %>" 
                                                                 data-color="<%= colors[idx % colors.length] %>">
                                                                <div class="form-control d-flex flex-column" style="width: 100%;">
                                                                    <div class="d-flex align-items-center">
                                                                        <span class="number-badge" style="background-color: <%= colors[idx % colors.length] %>">
                                                                            <%= validItemCount %>
                                                                        </span>
                                                                        <% if (item.text) { %>
                                                                            <span><%= item.text %></span>
                                                                        <% } %>
                                                                    </div>
                                                                    <% if (item.image && item.image.url) { %>
                                                                        <div class="mt-2 text-center">
                                                                            <img src="<%= item.image.url %>" 
                                                                                 alt="Left side image"
                                                                                 style="max-width: 150px; max-height: 100px; object-fit: contain;">
                                                                        </div>
                                                                    <% } %>
                                                                </div>
                                                            </div>
                                                        <% }
                                                        }); %>
                                                    </div>
                                    
                                                    <!-- Matching lines container -->
                                                    <div class="col-2">
                                                        <div class="matching-lines"></div>
                                                    </div>
                                    
                                                    <!-- Right side -->
                                                    <div class="col-5 right-side">
                                                        <% const shuffledRight = [...question.matchingPairs].map((pair, idx) => ({
                                                            text: pair.right.text,
                                                            image: pair.right.image,
                                                            originalIndex: idx
                                                        })).sort(() => Math.random() - 0.5) %>
                                    
                                                        <% shuffledRight.forEach((item, idx) => { %>
                                                            <div class="matching-item mb-3" data-original-index="<%= item.originalIndex %>">
                                                                <div class="form-control" style="width: 100%;">
                                                                    <div class="d-flex flex-column">
                                                                        <div><%= String.fromCharCode(65 + idx) %>. <%= item.text %></div>
                                                                        <% if (item.image && item.image.url) { %>
                                                                            <div class="mt-2 text-center">
                                                                                <img src="<%= item.image.url %>" 
                                                                                     alt="Right side image"
                                                                                     style="max-width: 150px; max-height: 100px; object-fit: contain;">
                                                                            </div>
                                                                        <% } %>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        <% }); %>
                                                    </div>
                                                </div>
                                    
                                                <!-- Hidden inputs for answers -->
                                                <input type="hidden" name="matching_answers_<%= displayIndex %>">
                                                <input type="hidden" 
                                                       name="matching_left_order_<%= displayIndex %>" 
                                                       value="<%= JSON.stringify(shuffledLeft.map(item => item.originalIndex)) %>">
                                                <input type="hidden" 
                                                       name="matching_right_order_<%= displayIndex %>" 
                                                       value="<%= JSON.stringify(shuffledRight.map(item => item.originalIndex)) %>">
                                            </div>
                                        </div>
                                    <% } %>
                                          
                                </div>
                            </div>
                            <% }) %>
                            <% } else { %>
  <div class="no-questions">
    <p>ไม่พบข้อมูลคำถาม</p>
  </div>
<% } %>
                    </div>

                    <div class="d-flex" style="padding: 0 2rem;">


                    </div>

                </div>

            </form>


