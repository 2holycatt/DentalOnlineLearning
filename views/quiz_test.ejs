function handleMatchingClick(item) {
    const questionIndex = item.closest('.question').id.split('_')[1];
    
    if (selectedItem === item) {
        item.classList.remove('selected');
        selectedItem = null;
        return;
    }

    if (!selectedItem) {
        selectedItem = item;
        item.classList.add('selected');
    } else {
        const firstSide = selectedItem.closest('.col-5');
        const secondSide = item.closest('.col-5');

        if (firstSide !== secondSide) {
            createMatch(
                questionIndex,
                firstSide.classList.contains('left-side') ? selectedItem : item,
                firstSide.classList.contains('left-side') ? item : selectedItem
            );
        }

        selectedItem.classList.remove('selected');
        item.classList.remove('selected');
        selectedItem = null;
    }
}

function debounce(func, wait) {
    let timeout;
    return function executedFunction(...args) {
        const later = () => {
            clearTimeout(timeout);
            func(...args);
        };
        clearTimeout(timeout);
        timeout = setTimeout(later, wait);
    };
}

function redrawAllLines() {
    document.querySelectorAll('.matching-container').forEach(container => {
        const questionIndex = container.closest('.question').id.split('_')[1];
        const lines = container.querySelector('.matching-lines');
        const matches = matchingAnswers.get(questionIndex) || [];
        
        // Clear existing lines
        lines.innerHTML = '';
        
        // Redraw each match
        matches.forEach(match => {
            const leftItem = container.querySelector(`.left-side .matching-item[data-original-index="${match.left}"]`);
            const rightItem = container.querySelector(`.right-side .matching-item[data-original-index="${match.right}"]`);
            if (leftItem && rightItem) {
                drawMatchingLine(leftItem, rightItem);
            }
        });
    });
}


const debouncedRedraw = debounce(redrawAllLines, 150);
window.addEventListener('resize', debouncedRedraw);
function createMatch(questionIndex, leftItem, rightItem) {
    // Remove any existing matches for these items
    removeExistingMatches(questionIndex, leftItem, rightItem);

    // Create new match
    const match = {
        left: parseInt(leftItem.dataset.originalIndex),
        right: parseInt(rightItem.dataset.originalIndex) 
    };

    // Store in matchingAnswers map
    if (!matchingAnswers.has(questionIndex)) {
        matchingAnswers.set(questionIndex, []);
    }
    matchingAnswers.get(questionIndex).push(match);

    // Update UI
    leftItem.classList.add('matched');
    rightItem.classList.add('matched');
    drawMatchingLine(leftItem, rightItem);

    // Save to localStorage immediately
    saveAllAnswers();
}

function drawMatchingLine(leftItem, rightItem) {
    const container = leftItem.closest('.matching-container');
    const linesContainer = container.querySelector('.matching-lines');
    const line = document.createElement('div');
    line.className = 'matching-line';

    const leftRect = leftItem.getBoundingClientRect();
    const rightRect = rightItem.getBoundingClientRect();
    const containerRect = container.getBoundingClientRect();

    const startX = leftRect.right - containerRect.left;
    const startY = leftRect.top + (leftRect.height / 2) - containerRect.top;
    const endX = rightRect.left - containerRect.left;
    const endY = rightRect.top + (rightRect.height / 2) - containerRect.top;

    const length = Math.sqrt(Math.pow(endX - startX, 2) + Math.pow(endY - startY, 2));
    const angle = Math.atan2(endY - startY, endX - startX);

    const color = leftItem.dataset.color;

    Object.assign(line.style, {
        backgroundColor: color,
        width: `${length}px`,
        left: `${startX}px`,
        top: `${startY}px`,
        transform: `rotate(${angle}rad)`,
        position: 'absolute'
    });

    line.dataset.left = leftItem.dataset.originalIndex;
    line.dataset.right = rightItem.dataset.originalIndex;

    linesContainer.appendChild(line);
}

function removeExistingMatches(questionIndex, leftItem, rightItem) {
    if (!matchingAnswers.has(questionIndex)) return;

    const matches = matchingAnswers.get(questionIndex);
    const leftIndex = parseInt(leftItem.dataset.originalIndex);
    const rightIndex = parseInt(rightItem.dataset.originalIndex);

    const container = leftItem.closest('.matching-container');
    container.querySelectorAll(`.matching-line[data-left="${leftIndex}"], .matching-line[data-right="${rightIndex}"]`)
        .forEach(line => line.remove());

    container.querySelectorAll('.matching-item').forEach(item => {
        if (parseInt(item.dataset.originalIndex) === leftIndex || 
            parseInt(item.dataset.originalIndex) === rightIndex) {
            item.classList.remove('matched');
        }
    });

    matchingAnswers.set(questionIndex, 
        matches.filter(match => match.left !== leftIndex && match.right !== rightIndex)
    );
}

function updateMatchingAnswers(questionIndex) {
    const input = document.querySelector(`input[name="matching_answers_${questionIndex}"]`);
    if (input) {
        input.value = JSON.stringify(matchingAnswers.get(questionIndex) || []);
    }
}



// Initialize when page loads
document.addEventListener('DOMContentLoaded', () => {
    initializeMatching();
    
    document.querySelectorAll('.matching-item').forEach(item => {
        item.addEventListener('click', () => handleMatchingClick(item));
    });
});

window.onerror = function(msg, url, line) {
    console.error(`Error: ${msg}\nURL: ${url}\nLine: ${line}`);
    return false;
};

function logStorageError(e) {
    console.error('LocalStorage Error:', e);
}

// Wrap localStorage operations in try-catch
function safeLocalStorageOperation(operation) {
    try {
        return operation();
    } catch (e) {
        logStorageError(e);
        return null;
    }
}

function adjustHeight(textarea) {
    // รีเซ็ตความสูงก่อน
    textarea.style.height = '0px';
    
    // ดึงค่าความสูงขั้นต่ำตามประเภท textarea
    const minHeight = textarea.classList.contains('short-text-area') ? 38 : 120;
    
    // ดึงค่าความสูงที่บันทึกไว้จาก localStorage
    const quizId = document.getElementById('form').dataset.quizId;
    const textareaId = textarea.name;
    const savedHeightKey = `textarea_height_${quizId}_${textareaId}`;
    const savedHeight = parseInt(localStorage.getItem(savedHeightKey)) || minHeight;
    
    // คำนวณความสูงที่ต้องการ
    const scrollHeight = textarea.scrollHeight;
    const currentContent = textarea.value;
    
    if (!currentContent) {
        textarea.style.height = `${minHeight}px`;
        localStorage.removeItem(savedHeightKey);
    } else {
        // ใช้ความสูงที่มากที่สุดระหว่าง minHeight, scrollHeight และ savedHeight
        const newHeight = Math.max(scrollHeight, minHeight, savedHeight);
        textarea.style.height = `${newHeight}px`;
        // บันทึกความสูงลง localStorage
        localStorage.setItem(savedHeightKey, newHeight);
    }
}

// เพิ่มในส่วนของ DOMContentLoaded
document.addEventListener('DOMContentLoaded', () => {
    const autoExpandTextareas = document.querySelectorAll('textarea.auto-expand');
    
    autoExpandTextareas.forEach(textarea => {
        // ปรับความสูงเมื่อพิมพ์
        textarea.addEventListener('input', function() {
            adjustHeight(this);
        });

        // ปรับความสูงเมื่อกด Enter
        textarea.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                setTimeout(() => adjustHeight(this), 0);
            }
        });

        // ปรับความสูงเมื่อลบข้อความ
        textarea.addEventListener('keyup', function(e) {
            if (e.key === 'Backspace' || e.key === 'Delete') {
                adjustHeight(this);
            }
        });

        // ปรับความสูงเมื่อวางข้อความ
        textarea.addEventListener('paste', function() {
            setTimeout(() => adjustHeight(this), 0);
        });

        // ปรับความสูงเริ่มต้นถ้ามีข้อความ
        if (textarea.value) {
            adjustHeight(textarea);
        }
    });
    
    // เพิ่ม MutationObserver เพื่อตรวจจับการเปลี่ยนแปลงของเนื้อหา
    const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
            if (mutation.type === 'characterData' || mutation.type === 'childList') {
                const textarea = mutation.target.closest('textarea');
                if (textarea && textarea.classList.contains('auto-expand')) {
                    adjustHeight(textarea);
                }
            }
        });
    });

    // เริ่มสังเกตการณ์การเปลี่ยนแปลง
    autoExpandTextareas.forEach(textarea => {
        observer.observe(textarea, {
            childList: true,
            characterData: true,
            subtree: true
        });
    });
});

    // เพิ่มตัวแปรสำหรับเก็บเวลา
    let timeLimit = <%= quiz.timeLimit.value %>; // รับค่า timeLimit จาก server
    let duration = parseInt(localStorage.getItem('quiz_duration')) || 0; // ดึงเวลาที่ใช้ไปแล้วจาก localStorage
    let remainingTime = timeLimit - duration; // คำนวณเวลาที่เหลือ
    let timerInterval;


    function getDurationKey(quizId) {
    const timestamp = new Date().getTime(); // ใช้ timestamp เป็นตัวแยกแต่ละครั้ง
    return `quiz_${quizId}_duration_${timestamp}`;
}

// ฟังก์ชันเริ่มจับเวลา
function startTimer() {
    const quizId = document.getElementById('form').dataset.quizId;
    
    // Get the elapsed time since quiz started, even after page refresh
    duration = getElapsedTime(quizId);
    remainingTime = timeLimit - duration;
    
    // If time limit is already exceeded, submit automatically
    if (remainingTime <= 0) {
        handleTimeUp();
        return;
    }
    
    updateTimerDisplay();
    
    timerInterval = setInterval(() => {
        duration++;
        remainingTime--;
        
        // Update localStorage with current duration
        localStorage.setItem(`quiz_${quizId}_current_duration`, duration.toString());
        
        // Update timer display
        updateTimerDisplay();
        
        // Check if time is up
        if (remainingTime <= 0) {
            clearInterval(timerInterval);
            handleTimeUp();
        }
    }, 1000);
}

function updateTimerDisplay() {
    const hours = Math.floor(remainingTime / 3600);
    const minutes = Math.floor((remainingTime % 3600) / 60);
    const seconds = remainingTime % 60;
    
    const timerElement = document.getElementById('countdownTimer');
    timerElement.textContent = `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
    
    // เพิ่มการแสดงสีเตือนเมื่อเวลาใกล้หมด
    if (remainingTime <= 300) { // น้อยกว่า 5 นาที
        timerElement.style.color = '#dc3545'; // สีแดง
    } else if (remainingTime <= 600) { // น้อยกว่า 10 นาที
        timerElement.style.color = '#ffc107'; // สีเหลือง
    }
}

function handleTimeUp() {
    Swal.fire({
        title: 'หมดเวลาทำแบบทดสอบ!',
        text: 'ระบบจะทำการส่งคำตอบอัตโนมัติ',
        icon: 'warning',
        showConfirmButton: false,
        timer: 2000
    }).then(() => {
        const quizId = document.getElementById('form').dataset.quizId;
        submitQuiz(quizId);
    });
}

function getElapsedTime(quizId) {
    const startTime = localStorage.getItem(`quiz_${quizId}_start_time`);
    if (!startTime) {
        return 0;
    }
    
    const elapsedMilliseconds = Date.now() - parseInt(startTime);
    return Math.floor(elapsedMilliseconds / 1000); // Convert to seconds
}

