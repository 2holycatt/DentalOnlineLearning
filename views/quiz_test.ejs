function checkQuestionAnswered(questionDiv) {
    const questionType = questionDiv.querySelector('.options').dataset.type;
    
    switch (questionType) {
        case 'MCQ':
            return !!questionDiv.querySelector('input[type="radio"]:checked');
        case 'checkbox':
            return !!questionDiv.querySelector('input[type="checkbox"]:checked');
        case 'Paragraph':
        case 'short_answ':
            const textarea = questionDiv.querySelector('textarea');
            return textarea && textarea.value.trim() !== '';
        case 'matching':
            const questionIndex = questionDiv.id.split('_')[1];
            const matches = matchingAnswers.get(questionIndex);
            return matches && matches.length > 0;
        default:
            return false;
    }
}


function goToQuestion(index) {
    // ซ่อนคำถามทั้งหมด
    document.querySelectorAll('.question').forEach(q => q.style.display = 'none');
    
    // แสดงคำถามที่ถูกเลือก
    document.getElementById('question_' + index).style.display = 'block';
    
    // ดึงข้อมูลคำตอบจาก localStorage
    const quizId = document.getElementById('form').dataset.quizId;
    const savedAnswers = safeLocalStorageOperation(() => {
        return JSON.parse(localStorage.getItem(`quiz_${quizId}_answers_v2`)) || {};
    });

    // อัปเดตสถานะปุ่มทั้งหมด
    document.querySelectorAll('.pagination-btn').forEach(btn => {
        if (btn.classList.contains('chevron')) return;

        const btnIndex = parseInt(btn.textContent) - 1;
        // หา question div ที่สอดคล้องกับปุ่ม
        const questionDiv = document.querySelector(`.question[data-question-index="${btnIndex}"]`);
        if (!questionDiv) return;

        // ดึง originalIndex จาก question div
        const originalIndex = questionDiv.dataset.originalIndex;
        const answer = savedAnswers[originalIndex];
        
        // เช็คว่ามีคำตอบหรือไม่
        const hasAnswer = answer && answer.value && (
            (answer.type === 'MCQ' && answer.value !== null) ||
            (answer.type === 'checkbox' && Array.isArray(answer.value) && answer.value.length > 0) ||
            (answer.type === 'matching' && Array.isArray(answer.value) && answer.value.length > 0) ||
            ((answer.type === 'Paragraph' || answer.type === 'short_answ') && answer.value.trim() !== '')
        );

        if (parseInt(index) === btnIndex) {
            // ข้อที่กำลังดูอยู่
            btn.style.backgroundColor = '#8A2BE2'; // สีม่วงเข้ม
            btn.style.color = 'white';
        } else if (hasAnswer) {
            // ข้อที่มีคำตอบแล้ว
            btn.style.backgroundColor = '#c3a2e2'; // สีม่วงอ่อน
            btn.style.color = 'white';
        } else {
            // ข้อที่ยังไม่ได้ตอบ
            btn.style.backgroundColor = '#D9D9D9'; // สีเทา
            btn.style.color = 'black';
        }
    });

    // อัปเดต URL โดยไม่ต้อง refresh หน้า
    const url = new URL(window.location.href);
    url.searchParams.set('question', index);
    window.history.pushState({}, '', url);
}

