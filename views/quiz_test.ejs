        <!-- FORM CONTENT -->
        <div class="container" id="main_container">

            <!-- <form action="/submitQuiz" id="form" method="post"> -->
            <form id="form" method="POST" enctype="multipart/form-data" data-quiz-id="<%= quiz._id %>">
                <div class="questions">



                    <!-- Image   -->

                    <div class="question" id="themeimageid" style="display: none; max-height: 105px;     height: 155px;
