<body>
  <div id="blur-container">
    <%- include("./partials/nav2.ejs", { theme: theme, isSidebarOpen: isSidebarOpen }) %>

  </div>
  <div class="main-content d-flex">
    <%- include("./partials/lessonsList.ejs")%>
   
    <div class="aside-right w-75 h-auto p-4 m-3 ">
        <div class="manange-bar p-3 bg-white d-flex w-100">
            <p class="fw-bold fs-3 ms-2 lesson-bar">นำออกรายชื่อนักศึกษา</p>
            <a href="/adminIndex/uploadStudent" class="add-button btn btn-primary m-0 p-2">
                ย้อนกลับ <i class="bi bi-x-circle-fill mx-2"></i>
              </a>
        </div>
        <br>
        <div class="d-flex align-items-center ms-4 mb-3 me-4">
            <label for="entriesPerPage" class="me-2">แสดงรายชื่อ:</label>
            <select id="entriesPerPage" class="form-select" style="width: max-content; min-width: 170px;">
                <option value="10">10 รายการ</option>
                <option value="20">20 รายการ</option>
                <option value="all">ทั้งหมด</option>
            </select>
        </div>

        <div class="lesson-content p-4 bg-white w-100  mb-4 mt-3">
            <div class="d-flex  justify-content-between mb-3">
                <div class="d-flex align-items-center">
                <label for="subjectSelect" class="me-2 ">รายวิชา:</label>
                <select id="subjectSelect" class="form-select" style="width: max-content; min-width: 360px;">
                    <option value="">-- กรุณาเลือกรายวิชา --</option>
                    <% subjects.forEach(subject => { %>
                        <option value="<%= subject._id %>">
                            <%= subject.subjectId %> <%= subject.subjectName %>
                  ปีการศึกษา: <%= subject.semester %> กลุ่ม: <%= subject.section %>
                        </option>
                    <% }) %>
                </select>
                </div>

                <div class="d-flex align-items-center">
                    <button id="exportBtn" class="btn btn-success p-1" style="display: none;">
                        <i class="bi bi-file-earmark-excel me-2"></i>นำออกเป็นไฟล์ Excel
                    </button>
                </div>
            </div>
           
            <!-- ส่วนแสดงรายชื่อนักศึกษา -->
            <div id="studentList" style="display: none;">
                <div class="list-div purple row">
                    <p class="fw-bold my-3 col-2">รหัสนักศึกษา</p>
                    <p class="fw-bold my-3 col-3">ชื่อ - นามสกุล</p>
                    <p class="fw-bold my-3 col-1">ชื่อเล่น</p>
                    <p class="fw-bold my-3 col-4">ที่อยู่อีเมล (Email)</p>
                    <p class="fw-bold my-3 col-1">คณะ</p>
                    <p class="fw-bold my-3 col-1">นักศึกษาจาก</p>
                </div>
                <div id="studentRows"></div>
            </div>
    
            <div id="noStudents" class="text-center py-4" style="display: none;">
                <p class=" mb-3">ไม่พบรายชื่อนักศึกษาในรายวิชานี้</p>
                <a class="p-1" id="addStudentBtn" href="#" class="btn btn-primary" style="display: none;">
                    <i class="bi bi-person-plus-fill me-2"></i>เพิ่มรายชื่อนักศึกษา
                </a>
            </div>
    
        </div>

        <div class="pagination-container d-flex justify-content-end mt-3" style="display: none;">
            <nav aria-label="Page navigation">
                <ul class="pagination">
                    <!-- Pagination items จะถูกเพิ่มด้วย JavaScript -->
                </ul>
            </nav>
        </div>

    </div>
</div>
  <%- include("./partials/footer.ejs")%>
</body>

<script>
  const subjectSelect = document.getElementById('subjectSelect');
const studentList = document.getElementById('studentList');
const studentRows = document.getElementById('studentRows');
const noStudents = document.getElementById('noStudents');
const exportBtn = document.getElementById('exportBtn');
const entriesPerPage = document.getElementById('entriesPerPage');
const addStudentBtn = document.getElementById('addStudentBtn');

let currentSubject = null;
let totalStudents = 0;


// แก้ไขฟังก์ชัน loadStudents
async function loadStudents(subjectId, limit = 10, page = 1) {
    try {
        const response = await fetch(`/api/subjects/${subjectId}/students?limit=${limit}&page=${page}`);
        const data = await response.json();

        if (!data.success) {
            throw new Error(data.message);
        }

        currentSubject = subjectId;
        totalStudents = data.totalStudents;

        // รีเซ็ต pagination ทุกครั้งที่โหลดข้อมูลใหม่
        const paginationContainer = document.querySelector('.pagination-container');
        paginationContainer.style.display = 'none';
        paginationContainer.querySelector('.pagination').innerHTML = '';

        if (data.students && data.students.length > 0) {
            // อัปเดตตัวเลือกแสดงทั้งหมด
            const allOption = entriesPerPage.querySelector('option[value="all"]');
            allOption.textContent = `ทั้งหมด (${totalStudents} รายการ)`;

            // แสดงข้อมูลนักศึกษา
            studentRows.innerHTML = data.students.map(student => `
             <a href="/adminIndex/studentInformationAccount?studentId=${student.studentId}" class="studentDetail-a">
                <div class="list-div-data row">
                    <p class="fw-normal my-3 col-2 grey">${student.studentId || '-'}</p>
                    <p class="fw-normal my-3 col-3 grey">
                        ${student.user?.prefix || ''}${student.user?.fname || ''} ${student.user?.lname || ''}
                    </p>
                    <p class="fw-normal my-3 col-1 grey">${student.user?.nickname || ''}</p>
                    <p class="fw-normal my-3 col-4 grey">${student.user?.email || '-'}</p>
                    <p class="fw-normal my-3 col-1 grey">${student.user?.major || '-'}</p>
                    <p class="fw-normal my-3 col-1 ${student.user?.studentFromKku ? 'text-kku' : 'grey'}">
                        ${student.user?.studentFromKku ? 'มหาวิทยาลัยขอนแก่น' : 'ภายนอก'}
                    </p>
                </div>
            `).join('');

            studentList.style.display = 'block';
            noStudents.style.display = 'none';
            exportBtn.style.display = 'block';

            // เพิ่มการอัปเดต pagination
            if (limit !== 'all' && data.totalPages > 1) {
                updatePagination(data.currentPage, data.totalPages, limit);
                paginationContainer.style.display = 'flex';
            }
        } else {
            studentList.style.display = 'none';
            noStudents.style.display = 'block';
            exportBtn.style.display = 'none';
        }

        if (data.students && data.students.length > 0) {
            // ... โค้ดเดิม ...
            addStudentBtn.style.display = 'none';
        } else {
            studentList.style.display = 'none';
            noStudents.style.display = 'block';
            exportBtn.style.display = 'none';
            // แสดงปุ่มเพิ่มนักศึกษาเมื่อเลือกรายวิชาแล้ว
            if (currentSubject) {
                addStudentBtn.style.display = 'inline-block';
                addStudentBtn.href = `/adminIndex/addStudentToSubject?subjectDbId=${currentSubject}`;
            }
        }

    } catch (error) {
        console.error('Error:', error);
        studentList.style.display = 'none';
        noStudents.style.display = 'none';
        exportBtn.style.display = 'none';
        addStudentBtn.style.display = 'none';
        document.querySelector('.pagination-container').style.display = 'none';
        
        Swal.fire({
            icon: 'error',
            title: 'เกิดข้อผิดพลาด',
            text: error.message || 'ไม่สามารถดึงข้อมูลนักศึกษาได้',
            confirmButtonText: 'ตกลง'
        });
    }
}
// Event Listeners
subjectSelect.addEventListener('change', function() {
    const selectedSubject = this.value;
    if (!selectedSubject) {
        studentList.style.display = 'none';
        exportBtn.style.display = 'none';
        noStudents.style.display = 'none';
        document.querySelector('.pagination-container').style.display = 'none'; // เพิ่มบรรทัดนี้
        return;
    }
    const limit = entriesPerPage.value === 'all' ? 'all' : parseInt(entriesPerPage.value);
    loadStudents(selectedSubject, limit, 1);
});

entriesPerPage.addEventListener('change', function() {
    if (!currentSubject) return;
    const limit = this.value === 'all' ? 'all' : parseInt(this.value);
    loadStudents(currentSubject, limit, 1);
});

exportBtn.addEventListener('click', function() {
    if (currentSubject) {
        window.location.href = `/adminIndex/exportStudentList?subjectId=${currentSubject}`;
    }
});


exportBtn.addEventListener('click', function() {
    const selectedSubject = subjectSelect.value;
    if (selectedSubject) {
        window.location.href = `/adminIndex/exportStudentList?subjectId=${selectedSubject}`;
    }
});

function generatePaginationItems(currentPage, totalPages, limit) {
    let items = '';
    
    // ปุ่มก่อนหน้า
    if (currentPage > 1) {
        items += `
            <li class="page-item">
                <a class="page-link px-2" href="#" onclick="loadStudents('${currentSubject}', ${limit}, ${currentPage - 1}); return false;">
                    ก่อนหน้า
                </a>
            </li>`;
    } else {
        items += `
            <li class="page-item disabled">
                <a class="page-link px-2" href="#">ก่อนหน้า</a>
            </li>`;
    }

    // คำนวณหน้าที่จะแสดง
    let startPage = Math.max(currentPage - 1, 1);
    let endPage = Math.min(startPage + 2, totalPages);

    // แสดงหน้าแรก
    if (startPage > 1) {
        items += `
            <li class="page-item">
                <a class="page-link px-2" href="#" onclick="loadStudents('${currentSubject}', ${limit}, 1); return false;">1</a>
            </li>`;
        if (startPage > 2) {
            items += `
                <li class="page-item disabled">
                    <a class="page-link px-2">...</a>
                </li>`;
        }
    }

    // แสดงหน้าปัจจุบันและหน้าใกล้เคียง
    for (let i = startPage; i <= endPage; i++) {
        items += `
            <li class="page-item ${currentPage === i ? 'active' : ''}">
                <a class="page-link px-2" href="#" onclick="loadStudents('${currentSubject}', ${limit}, ${i}); return false;">
                    ${i}
                </a>
            </li>`;
    }

    // แสดงหน้าสุดท้าย
    if (endPage < totalPages) {
        if (endPage < totalPages - 1) {
            items += `
                <li class="page-item disabled">
                    <a class="page-link">...</a>
                </li>`;
        }
        items += `
            <li class="page-item">
                <a class="page-link px-2" href="#" onclick="loadStudents('${currentSubject}', ${limit}, ${totalPages}); return false;">
                    ${totalPages}
                </a>
            </li>`;
    }

    // ปุ่มถัดไป
    if (currentPage < totalPages) {
        items += `
            <li class="page-item">
                <a class="page-link px-2" href="#" onclick="loadStudents('${currentSubject}', ${limit}, ${currentPage + 1}); return false;">
                    ถัดไป
                </a>
            </li>`;
    } else {
        items += `
            <li class="page-item disabled">
                <a class="page-link px-2" href="#">ถัดไป</a>
            </li>`;
    }

    return items;
}

function updatePagination(currentPage, totalPages, limit) {
    const paginationContainer = document.querySelector('.pagination-container');
    if (limit === 'all' || totalPages <= 1) {
        paginationContainer.style.display = 'none';
        return;
    }

    const paginationList = paginationContainer.querySelector('.pagination');
    paginationList.innerHTML = generatePaginationItems(currentPage, totalPages, limit);
    paginationContainer.style.display = 'flex';
}

</script>

</html>