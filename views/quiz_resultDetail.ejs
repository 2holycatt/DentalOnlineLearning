                        <span id="all-points-count" class="grey d-none"></span>
                        <span class="me-4">
                            <%= questions.length %>
                                ข้อ <span class="grey"> ( <%= questions.reduce((total, question)=> total +
                                        question.points, 0) %> คะแนน ) </span>
                        </span>
                        <span class="me-4"> คะแนนที่ทำได้: <span class="grey" id="total-score">
                          <%= (function() {
                              // หาคะแนนรวมจาก answers ทั้งหมดในครั้งที่เลือก
                              const currentAttempt = studentAttempt.eachAttempt[0]; // เริ่มที่ครั้งแรก
                              const totalScore = currentAttempt ? currentAttempt.totalScore : 0;
                              return `${totalScore} / ${totalPoints} (${((totalScore/totalPoints) * 100).toFixed(0)}%)`;
                          })() %>
                      </span>
                          </span> 

                          <span> เวลาที่ทำ: <span class="grey duration-display">
                            <%= (function() {
                                const currentAttempt = studentAttempt.eachAttempt[0];
                                if (!currentAttempt || !currentAttempt.duration) return '0 วินาที';
                                
                                const duration = parseInt(currentAttempt.duration);
                                if (isNaN(duration)) return '0 วินาที';
                                
                                const hours = Math.floor(duration / 3600);
                                const minutes = Math.floor((duration % 3600) / 60);
                                const seconds = duration % 60;
                                
                                let timeString = '';
                                if (hours > 0) timeString += `${hours} ชั่วโมง `;
                                if (minutes > 0) timeString += `${minutes} นาที `;
                                if (seconds > 0 || timeString === '') timeString += `${seconds} วินาที`;
                                
                                return timeString.trim();
                            })() %>
                        </span></span>
