let originalScores = null;


function toggleEditMode() {
    isEditMode = !isEditMode;
    const btn = document.querySelector('.edit-mode-btn');
    const inputFields = document.querySelectorAll('.points-input');
    const textFields = document.querySelectorAll('.points-text');
    let editActions = document.getElementById('editActions');

    if (isEditMode) {
        // เข้าสู่โหมดแก้ไข
        // เก็บค่าคะแนนเดิมไว้
        originalScores = Array.from(inputFields).map(input => ({
            questionId: input.closest('.points-display').dataset.questionId,
            points: input.value
        }));

        inputFields.forEach(input => {
            input.style.display = 'inline-block';
            input.removeAttribute('readonly');
        });
        textFields.forEach(text => text.style.display = 'none');
        btn.innerHTML = '<i class="bi bi-x-lg"></i> ยกเลิกการแก้ไข';
        btn.classList.add('active');
        
        // แสดงปุ่มบันทึก
        if (!editActions) {
            const actionsHTML = `
                <div id="editActions" class="edit-actions">
                    <span class="edit-status">
                         รอดำเนินการแก้ไขคะแนน
                    </span>
                    <button class="cancel-btn" onclick="toggleEditMode()">
                         ยกเลิก
                    </button>
                    <button class="save-btn" onclick="saveChanges()">
                        <i class="bi bi-check-lg"></i> บันทึก
                    </button>
                </div>
            `;
            document.body.insertAdjacentHTML('beforeend', actionsHTML);
            editActions = document.getElementById('editActions');
        }
        editActions.style.display = 'flex';
    } else {
        // ออกจากโหมดแก้ไข
        if (originalScores) {
            // คืนค่าคะแนนเดิม
            originalScores.forEach(score => {
                const display = document.querySelector(`.points-display[data-question-id="${score.questionId}"]`);
                if (display) {
                    const input = display.querySelector('.points-input');
                    const text = display.querySelector('.points-text');
                    input.value = score.points;
                    text.textContent = score.points;
                }
            });

            // คำนวณคะแนนรวมใหม่จากคะแนนเดิม
            const totalScore = originalScores.reduce((sum, score) => sum + parseInt(score.points), 0);
            const maxScore = <%= totalPoints %>;
            const percentage = ((totalScore / maxScore) * 100).toFixed(0);
            document.querySelector('#total-score').textContent = 
                `${totalScore}/${maxScore} (${percentage}%)`;
        }

        inputFields.forEach(input => {
            input.style.display = 'none';
            input.setAttribute('readonly', true);
        });
        textFields.forEach(text => text.style.display = 'inline');
        btn.innerHTML = '<i class="bi bi-pencil"></i> แก้ไขคะแนน';
        btn.classList.remove('active');
        
        
        if (editActions) {
            editActions.style.display = 'none';
        }

        // รีเซ็ตค่า originalScores
        originalScores = null;
    }
}

async function saveChanges() {
    try {
        const selectedAttemptIndex = document.querySelector('select').value;
        const displays = document.querySelectorAll('.points-display');
        const inputFields = document.querySelectorAll('.points-input');
        const textFields = document.querySelectorAll('.points-text');
        const updatedScores = [];
        let totalScore = 0;

        const currentAttempt = window.studentAttempt.eachAttempt[selectedAttemptIndex];
        
        displays.forEach(display => {
            const questionId = display.dataset.questionId;
            const points = parseInt(display.querySelector('.points-input').value) || 0;
            
            // หาคำตอบเดิมและตรวจสอบว่ามีข้อมูลหรือไม่
            const existingAnswer = currentAttempt.answers.find(a => a.questionId === questionId);
            
            totalScore += points;
            updatedScores.push({ 
                questionId, 
                points,
                type: existingAnswer?.type || 'MCQ',
                answer: existingAnswer?.answer || null,
                isCorrect: existingAnswer?.isCorrect || false,
                matchingAnswers: existingAnswer?.matchingAnswers || []
            });
        });

        const response = await fetch('/updateQuizScores', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                quizId: '<%= quiz._id %>',
                studentDbId: '<%= studentAttempt.studentDbId %>',
                attemptIndex: parseInt(selectedAttemptIndex),
                scores: updatedScores,
                totalScore: totalScore
            })
        });

        const result = await response.json();

        if (!response.ok) {
            throw new Error(result.message || 'Failed to save scores');
        }

        if (result.success) {
            // อัพเดตข้อมูลใน window.studentAttempt ก่อน
            window.studentAttempt.eachAttempt[selectedAttemptIndex].totalScore = totalScore;
            window.studentAttempt.eachAttempt[selectedAttemptIndex].answers = updatedScores;

            // อัพเดตการแสดงผลคะแนนแต่ละข้อ
            displays.forEach(display => {
                const questionId = display.dataset.questionId;
                const score = updatedScores.find(s => s.questionId === questionId);
                const text = display.querySelector('.points-text');
                const input = display.querySelector('.points-input');
                
                if (score) {
                    text.textContent = score.points;
                    input.value = score.points;
                }
            });

            // อัพเดตคะแนนรวม
            const maxScore = <%= totalPoints %>;
            const percentage = ((totalScore / maxScore) * 100).toFixed(0);
            document.querySelector('#total-score').textContent = 
                `${totalScore}/${maxScore} (${percentage}%)`;

            const editActions = document.getElementById('editActions');
                if (editActions) {
                editActions.style.display = 'none';
            }

            // ออกจากโหมดแก้ไข
            isEditMode = false;
            const btn = document.querySelector('.edit-mode-btn');
            const saveBtn = document.getElementById('saveScoreBtn');
            
            // อัพเดตการแสดงผล UI
            inputFields.forEach(input => {
                input.style.display = 'none';
                input.setAttribute('readonly', true);
            });
            textFields.forEach(text => text.style.display = 'inline');
            
            btn.innerHTML = '<i class="bi bi-pencil"></i> แก้ไขคะแนน';
            btn.classList.remove('active');
            
            if (saveBtn) {
                saveBtn.style.display = 'none';
            }

            // อัพเดต originalScores
            originalScores = updatedScores.map(score => ({
                questionId: score.questionId,
                points: score.points
            }));

            // แสดงข้อความสำเร็จ
            Swal.fire({
                icon: 'success',
                title: 'บันทึกคะแนนเรียบร้อย',
                showConfirmButton: false,
                timer: 1500
            });
        }
    } catch (error) {
        console.error('Error:', error);
        Swal.fire({
            icon: 'error',
            title: 'เกิดข้อผิดพลาด',
            text: error.message || 'ไม่สามารถบันทึกคะแนนได้'
        });
    }
}

