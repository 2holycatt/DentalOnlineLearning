                                        <%= question.questionText %>
                                    </div>
                                    <!-- Modify the points display to be editable -->
<span class="grey ms-4">
  <span class="points-display" data-question-id="<%= question._id %>">
      <span class="points-text">
          <%= 
          (function() {
              const currentAttempt = studentAttempt.eachAttempt[0];
              if (!currentAttempt || !currentAttempt.answers) return 0;
              
              const answer = currentAttempt.answers.find(a => 
                  a.questionId === question._id.toString()
              );
              
              return answer ? answer.points || 0 : 0;
          })()
          %>
      </span>
      <input type="number" class="points-input" style="display: none; width: 60px;" 
             min="0" max="<%= question.points %>" 
             value="<%= 
             (function() {
                 const currentAttempt = studentAttempt.eachAttempt[0];
                 if (!currentAttempt || !currentAttempt.answers) return 0;
                 
                 const answer = currentAttempt.answers.find(a => 
                     a.questionId === question._id.toString()
                 );
                 
                 return answer ? answer.points || 0 : 0;
             })()
             %>"
      >
  </span>/ <%= question.points %> คะแนน
</span>
                                </div>
                                <br>
                                <div class="options">
                                    <% if (question.questionType === 'MCQ' || question.questionType === 'checkbox') { %>
                                        <% question.options.forEach((option, j) => { %>
                                            <div class="form-check" style="display: flex; align-items: center;">
                                                <input class="input_check answer-input"
    type="<%= question.questionType === 'MCQ' ? 'radio' : 'checkbox' %>"
    name="Answ_<%= i %>" 
    value="<%= j %>"
    data-question-id="<%= question._id %>"
    data-option-index="<%= j %>"
    <%= (function() {
        const currentAttempt = studentAttempt.eachAttempt[0];
        if (!currentAttempt || !currentAttempt.answers) return '';
        
        const answer = currentAttempt.answers.find(a => 
            a.questionId === question._id.toString()
        );
        
        if (!answer) return '';
        
        if (question.questionType === 'MCQ') {
            return answer.answer === j ? 'checked' : '';
        } else if (question.questionType === 'checkbox') {
            return Array.isArray(answer.answer) && answer.answer.includes(j) ? 'checked' : '';
        }
        return '';
    })() %>
    disabled>
                                                <div style="flex-grow: 1; padding: 5px;">
                                                    <%= option.optionText %>
                                                </div>
                                            </div>
                                        <% }) %>
                                    <% } else if (question.questionType === 'Paragraph' || question.questionType === 'short_answ') { %>
                                        <textarea class="form-control ps-2 me-4 mt-2 answer-input" 
