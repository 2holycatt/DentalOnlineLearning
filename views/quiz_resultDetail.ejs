            function renderOptions(question, questionIndex) {
                if (question.questionType === 'MCQ' || question.questionType === 'checkbox') {
                    return question.options.map((option, i) => `
                      <div class="form-check p-0" style="display: flex; align-items: center;">
                          <input class="input_check" type="${question.questionType === 'MCQ' ? 'radio' : 'checkbox'}" name="Answ_${questionIndex}" value="${i}">
                          <div name="option_${questionIndex}_${i}" style="flex-grow: 1; padding: 5px;">
              ${option.optionText}
          </div>                </div>
                  `).join('');
                } else if (question.questionType === 'Paragraph') {
                    return `<textarea class="form-control mt-3 mb-2" name="answer_${questionIndex}" rows="1" style="width:90%;" readonly></textarea>`;
                } else if (question.questionType === 'short_answ') {
                    return `<textarea class="form-control mt-3 mb-2" name="answer_${questionIndex}" rows="1" style="width:50%;" readonly></textarea>`;
                }
                return '';
            }

            document.addEventListener('DOMContentLoaded', () => {
                renderQuestions();
            });

            function updateQuestionCount() {
                const questionCountElement = document.getElementById('question-count');
                questionCountElement.innerHTML = ` ${questions.length} คำถาม`;
            }

            questions.forEach(question => {
                if (question.questionType === 'checkbox' && !Array.isArray(question.answer)) {
                    question.answer = [];
                }
            });

            function calculateTotalPoints() {
                const totalPoints = questions.reduce((sum, question) => sum + question.points, 0);
                document.getElementById('all-points-count').innerText = `( ${totalPoints} คะแนน)`;
            }
            function updateQuestionPoints(index, newPoints) {
                // ปรับคะแนนในอาร์เรย์ questions
                questions[index].points = Number(newPoints);
                // คำนวณคะแนนรวมใหม่
                calculateTotalPoints();
            }
            document.addEventListener('DOMContentLoaded', () => {
                updateQuestionCount();
                calculateTotalPoints();
                updateQuestionPoints
                renderQuestions();
            });

            let isEditMode = false;

            function formatDuration(seconds) {
                if (!seconds || isNaN(seconds) || seconds < 0) {
        return '0 วินาที';
    }    
    const hours = Math.floor(seconds / 3600);
    const minutes = Math.floor((seconds % 3600) / 60);
    const remainingSeconds = seconds % 60;
    
    let timeString = '';
    if (hours > 0) timeString += `${hours} ชั่วโมง `;
    if (minutes > 0) timeString += `${minutes} นาที `;
    if (remainingSeconds > 0 || timeString === '') timeString += `${remainingSeconds} วินาที`;
    
    return timeString.trim();
}

            function showAttemptResult(index) {
    const attempt = window.studentAttempt.eachAttempt[index];
    if (!attempt) return;

    // อัพเดตคะแนน
    document.querySelectorAll('.points-display').forEach(display => {
        const questionId = display.dataset.questionId;
        const answer = attempt.answers.find(a => a.questionId === questionId);
        const points = answer ? answer.points || 0 : 0;
        
        display.querySelector('.points-text').textContent = points;
        display.querySelector('.points-input').value = points;
    });

    // อัพเดตคำตอบ
    document.querySelectorAll('.answer-input').forEach(input => {
        const questionId = input.dataset.questionId;
        const answer = attempt.answers.find(a => a.questionId === questionId);
        
        if (!answer) {
            if (input.tagName === 'TEXTAREA') {
                input.value = 'ไม่มีคำตอบ';
            } else {
                input.checked = false;
            }
            return;
        }

        if (input.tagName === 'TEXTAREA') {
            input.value = answer.answer || 'ไม่มีคำตอบ';
        } else {
            const optionIndex = parseInt(input.dataset.optionIndex);
            if (answer.type === 'MCQ') {
                input.checked = answer.answer === optionIndex;
            } else if (answer.type === 'checkbox') {
                input.checked = Array.isArray(answer.answer) && answer.answer.includes(optionIndex);
            }
        }
    });

    // อัพเดตคะแนนรวม
    
    const totalScore = attempt.totalScore;
    const maxScore = <%= totalPoints %>;
    const percentage = ((totalScore / maxScore) * 100).toFixed(0);
    document.querySelector('#total-score').textContent = 
        `${totalScore} / ${maxScore} ( ${percentage}% )`;
        const durationDisplay = document.querySelector('.duration-display');
    if (durationDisplay) {
        // ตรวจสอบว่ามี duration หรือไม่
        if (!attempt.duration || attempt.duration === undefined || attempt.duration === null) {
            durationDisplay.textContent = '0 วินาที';
        } else {
            const duration = parseInt(attempt.duration);
            if (isNaN(duration)) {
                durationDisplay.textContent = '0 วินาที';
            } else {
                durationDisplay.textContent = formatDuration(duration);
            }
        }
    }
}

