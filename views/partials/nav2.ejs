<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/nav2.css">
    <link rel="stylesheet" href="/css/nav2_dark.css">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet"> <!-- Material Icons -->
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var dropdownElementList = [].slice.call(document.querySelectorAll('.dropdown-toggle'))
            var dropdownList = dropdownElementList.map(function (dropdownToggleEl) {
                return new bootstrap.Dropdown(dropdownToggleEl)
            });
        });
    </script>
    <!-- Font Awesome -->
    <title>Header</title>
    <style>
        :root {
            --light: #d8dbe0;
            --dark: #28292c;
            --link: rgb(27, 129, 112);
            --link-hover: rgb(24, 94, 82);
        }

        .switch_theme {
            position: relative;
            width: 45px;
            /* กำหนดความกว้างของ switch */
            height: 20px;
            /* กำหนดความสูงของ switch */
            display: inline-block;
            background-color: var(--dark);
            border-radius: 50px;
            cursor: pointer;
            margin-right: 1rem;
            /* ลดระยะห่างขวาของ switch */
        }

        .switch_theme input {
            position: absolute;
            opacity: 0;
            width: 0;
            height: 0;
        }

        .switch_theme .slider {
            position: absolute;
            top: -2px;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: var(--dark);
            border-radius: 50px;
            transition: 0.3s;
            
        }

        .switch_theme .slider::before {
            content: "\f185";
            /* ไอคอนพระอาทิตย์ (FontAwesome) */
            font-family: "FontAwesome";
            position: absolute;
            top: -1px;
            /* ปรับตำแหน่งด้านบน */
            left: 0px;
            /* ปรับตำแหน่งด้านซ้าย */
            width: 24px;
            /* ขนาดของไอคอน */
            height: 24px;
            border-radius: 50%;
            background-color: var(--light);
            transition: 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .switch_theme input:checked+.slider {
            background-color: var(--light);
        }

        .switch_theme input:checked+.slider::before {
            content: "\f186";
            /* ไอคอนพระจันทร์ (FontAwesome) */
            transform: translateX(30px);
            /* ปรับการเคลื่อนที่ของลูกกลมเมื่อ checked */
            background-color: var(--dark);
            box-shadow: none;
        }



        /* ปรับปรุงปุ่ม toggleMenu */
        .sub-menu-wrap {
            position: absolute;
            right: 0;
            top: 60px;
            border-radius: 8px;
            overflow: hidden;
            display: none;
        }

        .sub-menu-wrap.open-menu {
            display: block;
        }

        .sub-menu {
            padding: 4rem;
        }

        .sub-menu-link {
            display: flex;
            align-items: center;
            text-decoration: none;
            transition: background 0.3s;
        }

        .sub-menu-link i {
            margin-right: 10px;
        }


        .user-info {
            margin-bottom: 10px;
        }

        .user-info h5 {
            margin: 0;
        }

        .search_button {
            background: none;
            border: none;
            cursor: pointer;
            outline: none;
            font-size: 1rem;
            color: var(--icon-color);
        }

        .profile-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
        }

        .dropdown-item:hover{
            color: #9146ff !important
        }

        .dark .dropdown-submenu {
            background-color:#555 !important; 
        }
        
        .dark .dropdown-item{
            color:white;
            background-color:#555;
        }
    
        .dropdown-submenu {
             position: absolute;
             left: 70%;
             display: none;
}
.dropdown-toggle::after {
    display: none; /* ซ่อน dropdown arrow เดิม */
}

.bi-chevron-down {
    transition: transform 0.3s;
}

.show .bi-chevron-down {
    transform: rotate(180deg); /* หมุนไอคอนเมื่อเปิด dropdown */
}
.grey {
        color: gray ;
      }
.purple{
    color: #ba55d3  !important
}
.custom-swal-popup {
    padding: 2rem;
    border-radius: 12px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
}

.custom-swal-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 1.5rem;
    color: #333;
}

.custom-swal-content {
    margin: 1.5rem 0 2.5rem 0; /* เพิ่มระยะห่างด้านล่างของข้อความ */
    font-size: 1.1rem;
    color: #555;
}

.custom-swal-confirm-button {
    padding: 0.8rem 2.5rem !important; /* ทำให้ปุ่มใหญ่ขึ้น */
    font-size: 1.1rem !important;
    font-weight: 500 !important;
    background-color: #ba55d3 !important; /* สีม่วงตามธีมของคุณ */
    border-radius: 8px !important;
    box-shadow: 0 4px 12px rgba(186, 85, 211, 0.3) !important;
}

.custom-swal-confirm-button:hover {
    background-color: #a03aaf !important; /* สีเข้มขึ้นเมื่อ hover */
    transform: translateY(-2px);
    transition: all 0.2s;
}

.custom-swal-icon {
    border: none !important;
    margin-top: 1rem !important;
}

.custom-swal-image {
    margin: 1rem auto;
    display: block;
}

.custom-swal-actions {
    margin-top: 2rem; /* เพิ่มระยะห่างจากข้อความไปยังปุ่ม */
}
      .dark .grey {
        color: rgb(231, 231, 231)  ;
      }
      .dark .purple{
        color: #b98aff !important;
      }
      .dark .a-li .purple {
    color: #b98aff !important; /* สีที่อ่อนกว่าสำหรับ dark theme */
}
.dark .text-success{
        color: rgb(54, 194, 54) !important;
      }
      .dark .text-danger{
        color: rgb(255, 75, 75) !important;
      }
      
    </style>
</head>

<body class="<%= theme === 'dark' ? 'dark' : 'light' %>"> <!-- ใช้ class ของ theme -->

    <header class="header">
        <button onclick="toggleSidebar()" class="menu-btn">
            <% if (theme==='light' ) { %>
                <i class="bi bi-list"></i> <!-- Icon menu for light theme -->
                <% } else { %>
                    <i class="bi bi-list" style="color: white;"></i> <!-- Icon menu for dark theme -->
                    <% } %>
        </button>
        <div class="header_info">
            <a href="/adminIndex" class="logo-a d-flex justify-content-between">
                <img class="h-auto mx-4  logo-dent" src="<%= userData.fullImageUrl %>" style="width: 3.5rem; 
                max-width: 100px;" alt="ตราสัญลักษณ์ คณะทันตแพทยศาตร์">
            </a>
            <ul class="ul-nav">
                <li class="li-a">
                    <a href="/adminIndex" class="a-li">หน้าหลัก </a>
                </li>
                <li class="li-a show-drop">
                    <a href="#" class="a-li d-flex">
                        ห้องเรียน &nbsp; <i class="bi bi-chevron-down"></i>
                    </a>
                    <ul class="dropdown">
                        <li class="drop-li my-1">
                            <a class="a-li" href="/subjects">
                                รายวิชาทั้งหมด
                            </a>
                        </li>
                        <a class="dropdown-item dropdown-toggle d-flex justify-content-between align-items-center a-li" 
                        href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                         รายวิชา
                         <i class="bi bi-chevron-down"></i>

                     </a>
                     <ul class="dropdown-menu dropdown-submenu">
                         <% if (typeof navSubjects !== 'undefined' && navSubjects.length > 0) { %>
                             <% navSubjects.forEach(subject => { %>
                                 <li>
                                     <a class="dropdown-item p-1 a-li" href="/eachSubject?subjectDbId=<%= subject._id %>">
                                         <%= subject.subjectId %> <%= subject.subjectName %> 
                                         <%= subject.semester %> กลุ่มที่: <%= subject.section %>
                                     </a>
                                 </li>
                             <% }); %>
                         <% } else { %>
                             <li>
                                 <span class="dropdown-item disabled">ไม่มีรายวิชา</span>
                             </li>
                         <% } %>
                     </ul>
                 </li>
                
             </ul>
         </li>
                <li class="li-a show-drop">
                    <a href="#" class="a-li d-flex">
                        จัดการข้อมูลนักศึกษา &nbsp; <i class="bi bi-chevron-down"></i>
                    </a>
                    <ul class="dropdown">
                        <li class="drop-li my-1"><a class="a-li" href="/adminIndex/adminDashboard">แดชบอร์ด (Dashboard)</a></li>
                        <li class="drop-li my-1"><a class="a-li" href="/adminIndex/uploadStudent">รายชื่อนักศึกษา</a>
                        </li>
                        <li class="drop-li my-1"><a class="a-li" href="/adminIndex/logsFile">การเข้าใช้งาน (Logs
                                file)</a></li>
                        <li class="drop-li my-1"><a class="a-li" href="/adminIndex/setPermission">การกำหนดสิทธิ์</a></li>
                    </ul>
                </li>
                <li class="a-li d-flex">
                    <a href="#" class="a-li" onclick="redirectTo3DModel(event)">แบบจำลอง 3D</a>
                 </li>
                <% if (hasUnread) { %>
                    <li id="teacherNotification" class="li-a a-li">
                      <a href="/adminIndex/teacherNotification" class="a-li bell-animatio"><span class="text-success"></spanc>
                          <i class="bi bi-bell-fill text-success mx-2"></i>
                      </a>
              
                      <% } else { %>
                    <li id="teacherNotification" class="li-a a-li">
                      <a href="/adminIndex/teacherNotification" class="a-li "> <i class="bi bi-bell-fill mx-1"></i></a>
                      
                    </li>
                    <% } %>
                  
            </ul>
           
        </div>
        <div class="header_search">
            <button class="search_button" onclick="searchQuiz()">
                <% if (theme==='light' ) { %>
                    <i class="bi bi-search m-2"></i>
                    <% } else { %>
                        <i class="bi bi-search m-2" style="color: white;"></i>
                        <% } %>
            </button>
            <input id="searchInput" class="search-input" type="search" name="search" placeholder="ค้นหา" 
            onkeypress="if(event.keyCode === 13) { searchQuiz(); return false; }" />      
          </div>


        <div class="header_right">
            <!-- Theme Toggle Switch -->
            <label class="switch_theme ">
                <input type="checkbox" class="theme_toggle" onchange="toggleTheme()" <%=theme==='dark' ? 'checked' : ''
                    %>>
                <span class="slider round"></span>
            </label>

            <!-- Profile Button -->
            <button onclick="toggleMenu()" class="profile_button ms-3 me-2 ">
                <img src="/<%= userData.img %>" alt="Profile Image" class="profile-icon mx-4 my-3"
                    style="height: 40px;">
            </button>
            <div class="sub-menu-wrap" id="subMenu">
                <div class="sub-menu">
                    <div class="user-info">
                        <h5>
                            <%= userData.fname %>
                                <%= userData.lname %>
                        </h5>
                    </div>
                    <hr />
                    <a href="/profile" class="sub-menu-link">
                        <i class="bi bi-person-fill"></i>&nbsp;โปรไฟล์
                    </a>
                    <a href="/logoutGoogle" class="sub-menu-link"
                        onclick="event.preventDefault(); document.getElementById('logout-form').submit();">
                        <i class="bi bi-box-arrow-right"></i>&nbsp;ออกจากระบบ
                    </a>
                    <form id="logout-form" action="/logoutGoogle" method="post" style="display: none;">
                        <!-- สร้าง form ซ่อนไว้สำหรับส่ง POST request ไปยัง /logout -->
                        <!-- สามารถเพิ่ม CSRF token หรือ headers อื่น ๆ ตามความเหมาะสม -->
                    </form>
                </div>
            </div>
        </div>
    </header>

    <!-- Sidebar Component -->
    <%- include('sidebar.ejs', { isOpen: isSidebarOpen, theme: theme }) %> <!-- รวม Sidebar component -->
        <script>
            // ฟังก์ชัน JavaScript สำหรับการจัดการ Sidebar และธีม
            function toggleSidebar() {
                var sidebar = document.querySelector('.sidebar'); // เปลี่ยนการค้นหาด้วย class
                if (sidebar) {
                    sidebar.classList.toggle('open');
                    // บันทึกสถานะ Sidebar ใน localStorage
                    var isOpen = sidebar.classList.contains('open');
                    localStorage.setItem('isSidebarOpen', isOpen ? 'true' : 'false');
                }
            }

            function toggleTheme() {
                // ตรวจสอบธีมปัจจุบันจาก class ของ body
                var currentTheme = document.body.classList.contains('light') ? 'light' : 'dark';
                var newTheme = currentTheme === 'light' ? 'dark' : 'light';

                // ลบ class ของธีมปัจจุบันและเพิ่ม class ของธีมใหม่
                document.body.classList.remove(currentTheme);
                document.body.classList.add(newTheme);

                // บันทึกสถานะธีมใหม่ลงใน localStorage
                localStorage.setItem('theme', newTheme);

                // ตั้งค่าการ checked ของสวิตช์ toggle
                document.querySelector('.theme_toggle').checked = (newTheme === 'dark');
            }

            function toggleMenu() {
                var subMenu = document.getElementById('subMenu');
                if (subMenu) {
                    subMenu.classList.toggle('open-menu');
                }
            }

            // Initialize theme from localStorage
            (function () {
                // ตรวจสอบธีมที่ถูกบันทึกใน localStorage, ถ้าไม่มีให้ใช้ 'light' เป็นค่าเริ่มต้น
                var savedTheme = localStorage.getItem('theme') || 'light';

                // เพิ่ม class ของธีมที่ถูกบันทึกใน body
                document.body.classList.add(savedTheme);

                // ตั้งค่าการ checked ของสวิตช์ toggle ตามธีมที่ถูกบันทึก
                document.querySelector('.theme_toggle').checked = (savedTheme === 'dark');

                // ตรวจสอบสถานะการเปิด/ปิดของ Sidebar จาก localStorage
                var savedSidebarState = localStorage.getItem('isSidebarOpen') === 'true';
                var sidebar = document.querySelector('.sidebar');
                if (sidebar && savedSidebarState) {
                    sidebar.classList.add('open');
                }
            })();

            document.getElementById('searchInput').addEventListener('keypress', function (event) {
                if (event.key === 'Enter') {
                    event.preventDefault();  
                    searchQuiz();  
                }
            });

            function searchQuiz() {
                const searchQuery = document.getElementById('searchInput').value.trim(); 
                const userRole = '<%= userData.role %>';  // สมมติว่า role ถูกส่งจาก EJS

                if (searchQuery.length > 0) {
                    let searchPath = '';
                    if (userRole === 'teacher') {
                        searchPath = `/search=${encodeURIComponent(searchQuery)}`;
                    } else if (userRole === 'student') {
                        searchPath = `/search=${encodeURIComponent(searchQuery)}`;
                    } else {
                        alert('ไม่สามารถค้นหาได้ กรุณาลองใหม่');
                        return;
                    }
                    window.location.href = searchPath;
                } else {
                    alert('กรุณากรอกคำค้นหา');
                }
            }

            async function redirectTo3DModel(event) {
            event.preventDefault(); 

    try {
        const response = await fetch('/generate3DModelToken', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        });

        if (!response.ok) {
            throw new Error('Failed to generate SSO token');
        }

        const { redirectUrl } = await response.json();
        window.open(redirectUrl, '_blank'); 
    } catch (error) {
        console.error('Error:', error);
        Swal.fire({
            icon: 'error',
            title: 'เกิดข้อผิดพลาด',
            text: 'ไม่สามารถเชื่อมต่อกับระบบแบบจำลอง 3D ได้',
            confirmButtonText: 'ตกลง',
            customClass: {
                popup: 'custom-swal-popup',
                title: 'custom-swal-title',
                content: 'custom-swal-content',
                confirmButton: 'custom-swal-confirm-button',
                icon: 'custom-swal-icon',
                image: 'custom-swal-image',
                actions: 'custom-swal-actions'
            }
        });
    }
}

        </script>
</body>

</html>