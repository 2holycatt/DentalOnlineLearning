
<style>
  .each-lesson-grid {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
  }

  .small-text {
    font-size: small !important;
    width: 40% !important;
    margin: 0 0 !important;

  }

  .each-lesson-a:hover {
    /* เพิ่ม .each-lesson-a:focus */
    border-left: 0.2em solid #8A2BE2 !important;
    /* background-color: #404258 !important; */
  }

  .each-lesson-a:hover .hide-button {
    display: block !important;
    cursor: pointer;
  }

  .addLessonLink{
    width: 60%;
    background-color: #8A2BE2 !important;
    border-radius: 2em !important;
    margin: 1em auto !important;
  }

  .addLessonLink:hover{
    width: 60%;
    background-color: white !important;
    border-radius: 2em !important;
    margin: 1em auto !important;
    color: #8A2BE2 !important;
    border: 1px solid #8A2BE2 !important;
    transition: 0.5s;
  }

  .addLessonLink:hover i{
    color: #8A2BE2 !important;
    border:none !important;
    transition: 0.5s;
    }

  .addLessonLink i {
    color: white !important;

  }

  .above-nav-status{
    border-right: 1px solid #EAEFF4;
    /* position: fixed; */
    height: auto!important;
    overflow-y: auto !important;
    scrollbar-width: thin !important;
    
  }

  .bold-menus{
    border-left: 0.25em solid #8A2BE2;
    padding-left: 0.75em !important;
    

  }

  .menues-sub,
  .a-list,
  .a-list-1, .a-list-2, .a-list-3, .a-list-4,
  .a-list-5, .a-list-6, .a-list-7,.a-list-8{
    text-decoration: none;
    color: gray;
    transition-duration: 0.3s;
  }
  .dark .menues-sub,
  .dark .a-list,
  .dark .a-list-1, .dark .a-list-2, .dark .a-list-3, .dark .a-list-4,
  .dark .a-list-5, .dark .a-list-6, .dark .a-list-7,.dark .a-list-8{
    text-decoration: none;
    color: lightgray;
    transition-duration: 0.3s;
  }

  .menues-sub:hover{
    color: #8A2BE2 !important;
    transition: 0.3s;
  }
  .a-list:hover,
  .a-list-1:hover, .a-list-2:hover, .a-list-3:hover, .a-list-4:hover,
  .a-list-5:hover, .a-list-6:hover, .a-list-7:hover,.a-list-8:hover {
    color: #8A2BE2 !important;
    transition: 0.3s;

  }
  .a-li {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
    text-decoration: none;
    color: inherit;
}
.menu-header:hover{
  cursor: pointer;
}



</style>
<div class="above-nav-status p-4 col-sm-0 col-3 ">
  <a class="fs-6 ms-2 my-2 a-li grey" href="/adminIndex">
    หน้าหลัก
</a>
  <p class="fs-6 fw-bold bold-menus">
    ห้องเรียน
  </p>
  <div class="menues">
    <p class="menues-sub fs-6 my-2">
      <div class="ms-2 my-1">
        <a class="a-li grey" href="/subjects">
         รายวิชาทั้งหมด
     </a>
      </div>
      <div class="menu-item">
        <div class="menu-header ms-2 my-1" onclick="toggleSubjects(this)">
          <span class="a-li grey">รายวิชา <i class="bi bi-chevron-down"></i></span>
          
        </div>
        
        <div class="menu-content" style="display: none;">
          <% if (typeof navSubjects !== 'undefined' && navSubjects.length > 0) { %>
            <% navSubjects.forEach(subject => { %>
              <div class="ms-4 my-1">
                <a class="a-li grey" 
                  href="/eachSubject?subjectDbId=<%= subject._id %>"
                  title="<%= subject.subjectId %> <%= subject.subjectName %> <%= subject.semester %> กลุ่มที่: <%= subject.section %>">
                  <%= subject.subjectId %> <%= subject.subjectName %> 
                  <%= subject.semester %> กลุ่มที่: <%= subject.section %>
                </a>
              </div>
            <% }); %>
          <% } else { %>
            <div class="ms-4 my-1">
              <span class="a-li">ไม่มีรายวิชา</span>
            </div>
          <% } %>
        </div>
      </div>
    </p>
  </div>

  <p class="fs-6 fw-bold bold-menus my-2">
    จัดการข้อมูลนักศึกษา
  </p>
  <div class="menues">
    <p class="menues-sub fs-6 my-1">
      <i class="bi-4 bi-bar-chart mx-2"></i>
      <a href="/adminIndex/adminDashboard" class="a-list-4">แดชบอร์ด (Dashboard)</a>
    </p>
    <p class="menues-sub my-1">
      <i class="bi-5 bi-person-lines-fill mx-2" class="a-list-5"></i>
      <a href="/adminIndex/uploadStudent" class="a-list-5">รายชื่อนักศึกษา</a>
    </p>
    <p class="menues-sub my-1">
      <!-- <i class="bi bi-database-add mx-2"></i> -->
      <i class="bi-6 bi-clock-history mx-2" class="a-list-6"></i>
      <a href="/adminIndex/logsFile" class="a-list-6">การเข้าใช้งาน (Logs file)</a>
    </p>
    <p class="menues-sub my-1">
      <!-- <i class="bi bi-database-add mx-2"></i> -->
      <i class="bi-7 bi-person-check mx-2" class="a-list-7"></i>
      <a href="/adminIndex/setPermission" class="a-list-7">การกำหนดสิทธิ์</a>
    </p>
  </div>
  <% if (hasUnread) { %>
    <li id="teacherNotification" class="mx-2">
      <a href="/adminIndex/teacherNotification" class="a-list-8 bell-animatio"><span class="text-success">แจ้งเตือน</spanc>
          <i class="bi-8 bi-bell-fill text-success mx-2"></i>
      </a>

      <% } else { %>
    <li id="teacherNotification" class="mx-2">
      <a href="/adminIndex/teacherNotification" class="a-list-8">แจ้งเตือน <i class="bi bi-bell-fill mx-1"></i></a>
    </li>
    <% } %>
</div>

<script>
 function toggleSubjects(element) {
    const menuItem = element.parentElement;
    const menuContent = menuItem.querySelector('.menu-content');
    const icon = element.querySelector('.bi-chevron-down');
    
    // Toggle active class
    menuItem.classList.toggle('active');
    
    // Show/hide content
    if (menuItem.classList.contains('active')) {
        menuContent.style.display = 'block';
        icon.style.transform = 'rotate(180deg)';
    } else {
        menuContent.style.display = 'none';
        icon.style.transform = 'rotate(0deg)';
    }
}
</script>