    }

    .card-img-top {
      box-shadow: rgba(0, 0, 0, 0.15) 1.95px 1.95px 2.6px !important;
    }

    .setColumn {
      display: grid !important;
      grid-template-columns: 1fr 1fr 1fr !important;
    }

    .card-a {
      text-decoration: none !important;

    }

    .card-a:hover,
    .card-a:hover .p-lesson-name {
      color: #007bff !important;
      transition: 0.5s;
    }

    .card-a:hover .bi-book {
      color: #007bff !important;
      transition: color 0.5s;
    }

    .bi-book-fill {
      display: none;
    }

    .card-a:hover .bi-book-fill {
      display: inline-block !important;
      transition: 0.5s;
    }

    .card-a:hover .bi-book {
      display: none;
      transition: 0.5s;
    }

    .manange-bar,
    .lesson-content {
      box-shadow: rgba(50, 50, 93, 0.25) 0px 2px 5px -1px !important;
      border-radius: 0.5em;
    }

    .card-1 {
      width: 90% !important;
      height: fit-content !important;
      transition: all 0.8s cubic-bezier(0.15, 0.83, 0.66, 1);
      cursor: pointer;
      border-radius: 0.5em;
      box-shadow: rgba(50, 50, 93, 0.25) 0px 2px 5px -1px !important;

    }

    .card-1:hover {
      transform: scale(1.05);
    }

    .card-header {
      border-right: 1px solid #EAEFF4;
      border-bottom: 1px solid #EAEFF4;

    }


    #dashboardSelector {
      border-color: #EAEFF4;
      border-radius: 0.5em;
      background-color: white !important;
      font-size: smaller;
      padding: 0.5em !important;
    }

    #dashboardSelector option {
      color: #404258;
      background-color: white !important;


    }

    .sectionSelector {
      border-color: #EAEFF4;
      border-radius: 0.5em;
      background-color: white !important;
      font-size: smaller;
      padding: 0.5em !important;
    }

    .sectionSelector option {
      color: #404258;
      background-color: white !important;

    }

    /* .set-border {
      border-bottom: 1px solid #EAEFF4;
      padding-bottom: 1em !important;

    } */

    .set-border-bottom {
      border-bottom: 1px solid #EAEFF4;
      margin-bottom: 1em !important;

    }

    .lesson-bar {
      border-left: 0.25em solid #8A2BE2 !important;
      padding-left: 0.5em !important;
      margin-right: 0.5em !important;

    }
    .dark .lesson-bar{
      border-left: 0.25em solid #b98aff  !important;

    }

    .a-add {
      color: #007bff !important;
    }

    .a-add:hover {
      color: #0053ac !important;
    }

    .graph-container {
      margin-right: 1em !important;
      margin-bottom: 2em !important;
    }

    .graph-container-2 {
      margin-bottom: 1em !important;
      /* background-color: #5D87FF; */
      color: white;
    }

    .graph-container-3 {
      margin-bottom: 1em !important;
      /* background-color: #5D87FF; */
      color: #7C8FAC;
    }

    .graph-container-4 {
      margin-bottom: 1em !important;
      /* background-color: #5D87FF; */
      color: #7C8FAC;
    }

    .graph-label {
    }

    .progress-bar-white {
      background-color: white;
      /* color: #5D87FF; */
      /* ถ้าต้องการให้ข้อความเป็นสีดำเพื่อความชัดเจน */

    }

    .progress {
      margin-top: 1em !important;
    }

    .success-eachday {
      color: #0D6EFD !important;
    }

    .success-eachday:hover {
      color: #0053ac !important;
      transition: 0.3s;
    }

    .quiz-label {
      font-size: small;
    }
