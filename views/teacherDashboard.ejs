      'rgba(238, 130, 238)', // ม่วงพาสเทล
      'rgba(255, 140, 0)' // ส้มเข้ม
    ];
    
    const labelColorMap = new Map();

    function generateUniqueColor(usedColors) {
  const COLOR_OPACITY = 1;
  let color;
  do {
    const r = Math.floor(Math.random() * 255);
    const g = Math.floor(Math.random() * 255);
    const b = Math.floor(Math.random() * 255);
    color = `rgba(${r}, ${g}, ${b}, ${COLOR_OPACITY})`;
  } while (usedColors.has(color));
  return color;
}

function getColorForLabel(label) {
  // ถ้ามีสีที่ถูกกำหนดไว้แล้วสำหรับ label นี้ ให้ใช้สีเดิม
  if (labelColorMap.has(label)) {
    return labelColorMap.get(label);
  }

  // ถ้ายังไม่มีสี ให้หาสีใหม่
  const usedColors = new Set(labelColorMap.values());
  let color;

  // ใช้สีจาก predefinedColors ก่อนถ้ายังมีเหลือ
  const availablePresetColors = predefinedColors.filter(c => !usedColors.has(c));
  if (availablePresetColors.length > 0) {
    color = availablePresetColors[0];
  } else {
    // ถ้าใช้สีที่กำหนดไว้หมดแล้ว ให้สร้างสีใหม่
    color = generateUniqueColor(usedColors);
  }

  // เก็บการจับคู่สีกับ label
  labelColorMap.set(label, color);
  return color;
}
