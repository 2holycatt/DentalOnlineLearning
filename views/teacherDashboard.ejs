<body>
  <%- include("./partials/nav2.ejs", { theme: theme, isSidebarOpen: isSidebarOpen }) %>
  <!-- <div class="above-nav d-flex px-4 py-3">
    <div class="home-div above-nav-home d-flex mx-2 my-0 align-middle">
      <i class="bi bi-house mx-2"></i>
      <a href="/adminIndex" class="a-home">
        <p class="m-0">หน้าหลัก &nbsp;&nbsp;></p>
      </a>
    </div>
    <a href="#" class="status-a mx-2 my-0 align-middle">
      <p class="m-0">บทเรียน</p>
    </a>
  </div> -->
  <div class="main-content d-flex">
    <% const pageName = "adminLessonIndex" %>
    <%- include("./partials/lessonsList.ejs", { pageName: pageName })%>
    <!-- <div style="width: 20%;"><p class="w-100">&nbsp;</p></div> -->
    <div class="aside-right bg-white h-auto p-4 m-3" style="width: 80%;">
      <div class="manange-bar px-4 py-3 bg-white d-flex w-100">
        <p class="fw-bold fs-3 mx-1">
          <i class='bi-bar-chart-fill purple me-1'></i> แดชบอร์ด (Dashboard)
        </p>
        <div class="d-flex justify-content-center" style="align-items: center;">
          <label class="mx-2" for="dashboardSelector">แดชบอร์ดของ: </label>
          <select id="dashboardSelector" onchange="changeDashboardType(this.value)">
            <option value="lesson" <%= contentType === 'lesson' ? 'selected' : '' %>>บทเรียน</option>
            <option value="quiz" <%= contentType === 'quiz' ? 'selected' : '' %>>แบบทดสอบ</option>
            <option value="assignment" <%= contentType === 'assignment' ? 'selected' : '' %>>งานที่มอบหมาย</option>
          </select>
        </div>
      </div>

      <div class="lesson-content p-4 bg-white w-100 my-4">
        <div style="border-bottom: 1px solid #EAEFF4;" class="mb-3">
          <p class="fs-4 fw-bold mb-2 ">
            <i class="" ></i>
            <span class="ms-1"> ภาพรวมของ<%= contentType === 'quiz' ? 'แบบทดสอบ' : 
              contentType === 'assignment' ? 'งานที่มอบหมาย' : 
              'บทเรียน' %>
            </span>
            <span class=""> 
              (<%= contentType === 'quiz' ? 'Overview of Quizzes' : 
              contentType === 'assignment' ? 'Overview of Assignments' : 
              'Overview of Lessons' %>)
            </span>
          </p>
        </div>
        <% if (latestSubject) {%>
          <div class="d-flex flex-column flex-md-row mb-4" style="align-items: center;">
            <div class="me-md-5 mb-2 mb-md-0"> <!-- เพิ่ม margin-bottom บนมือถือ -->
              <label class="quiz-label" for="dashboardSelector">รายวิชา: </label>
              <% if (subjects.length > 0) { %>
              <select class="sectionSelector" onchange="submitSubjectId(this.value)">
                <% subjects.forEach(subject => { %>
                <option value="<%= subject._id %>" <%= subject._id.equals(latestSubject._id) ? 'selected' : '' %>>
                  <%= subject.subjectId %> <%= subject.subjectName %>
                  ปีการศึกษา: <%= subject.semester %> กลุ่ม: <%= subject.section %>
                </option>
                <% }) %>
              </select>
              <% } %>
            </div>
          
            <div class="m-0"> <!-- ไม่จำเป็นต้องมี margin-right บนมือถือ -->
              <label class="quiz-label" for="chartTypeSelector">ประเภทกราฟ: </label>
              <select id="chartTypeSelector" class="sectionSelector" onchange="changeChartType(this.value)">
                <option value="bar">กราฟแท่ง</option>
                <option value="line">กราฟเส้น</option>
                <option value="pie">กราฟวงกลม</option>
                <option value="doughnut">กราฟโดนัท</option>
              </select>
            </div>
          </div>
     
        <% 
        let hasContent = false;
        let noContentMessage = '';
        
        if (contentType === 'quiz') {
          hasContent = latestSubject.quizArray && latestSubject.quizArray.length > 0;
          noContentMessage = 'ยังไม่มีแบบทดสอบในรายวิชานี้';
        } else if (contentType === 'assignment') {
          hasContent = latestSubject.Assignments && latestSubject.Assignments.length > 0;
          noContentMessage = 'ยังไม่มีงานที่มอบหมายในรายวิชานี้';
        } else {
          hasContent = lessonLabels.length > 0;
          noContentMessage = 'ยังไม่มีบทเรียนในรายวิชานี้';
        }
      %>
    
      <% if (hasContent) { %>
        <% if (lessonLabels.length > 0) { %>
        <div class="row">
            <div class="col-md-8 col-12">
            <div class="graph-container shadow-sm rounded">
              <div class="p-3 graph-label">
                <div class="">
                  <p class="fw-bold">
                    <%= contentType === 'quiz' ? 'กราฟแสดงความสำเร็จแต่ละแบบทดสอบ' :
                        contentType === 'assignment' ? 'กราฟแสดงความสำเร็จแต่ละงานที่มอบหมาย' :
                        'กราฟแสดงความสำเร็จแต่ละบทเรียน' %>
                  </p>
                  <small>
                    <%= contentType === 'quiz' ? 'จำนวนความสำเร็จของแบบทดสอบที่นักศึกษาทำเสร็จสิ้นไป' :
                        contentType === 'assignment' ? 'จำนวนความสำเร็จของงานที่มอบหมายที่นักศึกษาส่งแล้ว' :
                        'จำนวนความสำเร็จของบทเรียนที่นักศึกษาทำเสร็จสิ้นไป' %>
                  </small>
                </div>
              </div>
              <div class="w-auto">
                <canvas id="myChart" class="h-auto w-100 p-3"></canvas>
                <div class="d-flex py-2" >
                  <!-- <small class="ms-auto my-2 mx-3">
                    <a href="/adminIndex/moreDetailChart?subjectId=<%=latestSubject._id%>" class="ms-auto success-eachday ">รายละเอียดเพิ่มเติม</a>
                  </small> -->
                </div>
              </div>
            </div>
        
          </div>
          <div class="col-md-4 col-12">
            <div class="graph-container-2">
              <div class="w-auto">
                <div class="fs-6 p-3 shadow-sm rounded" style="background-color: #5D87FF;">
                  <% if (contentType === 'quiz') { %>
                    <p class="fw-bold">ความสำเร็จของแบบทดสอบทั้ง <%= latestSubject.quizArray.length %> แบบ</p>
                    <small>เปอร์เซ็นความสำเร็จของแบบทดสอบที่นักศึกษาทำ</small>
                  <% } else if (contentType === 'assignment') { %>
                    <p class="fw-bold">ความสำเร็จของงานที่มอบหมายทั้ง <%= latestSubject.Assignments.length %> งาน</p>
                    <small>เปอร์เซ็นความสำเร็จของงานที่นักศึกษาส่ง</small>
                  <% } else { %>
                    <p class="fw-bold">ความสำเร็จของบทเรียนทั้ง <%= totalLessons || 0 %> บท</p>
                    <small>เปอร์เซ็นความสำเร็จของทุกบทเรียนที่รวมจากจำนวนนักศึกษาทั้งหมด</small>
                  <% } %>
                  <h1 class="text-center">
                    <% 
                      let percentage = 0;
                      if (contentType === 'quiz' && latestSubject.quizArray.length > 0) {
                        const totalAttempts = chartData.reduce((sum, attempts) => sum + attempts, 0);
