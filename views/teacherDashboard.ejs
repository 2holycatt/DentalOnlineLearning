  <script>
    function changeDashboardType(type) {
  // ดึงค่า subjectId จาก select ของรายวิชา
  const subjectSelect = document.querySelector('.sectionSelector');
  const subjectId = subjectSelect ? subjectSelect.value : '';

  // สร้าง URL สำหรับ redirect
  let url = '/adminIndex/adminDashboard?contentType=' + type;
  
  // ถ้ามี subjectId ให้เพิ่มเข้าไปใน URL
  if (subjectId) {
    url += '&subjectId=' + subjectId;
  }

  // redirect ไปยัง URL ใหม่
  window.location.href = url;
}

document.addEventListener('DOMContentLoaded', function() {
  const contentType = '<%= contentType %>';
  const dashboardSelector = document.getElementById('dashboardSelector');
  if (dashboardSelector) {
    dashboardSelector.value = contentType;
  }
  // เริ่มต้นด้วยกราฟแท่ง
  changeChartType('bar');
});

    document.querySelectorAll('.date').forEach(element => {
      const dateValue = element.getAttribute('data-date');
      if (dateValue) {
        // แปลงวันที่ด้วย JavaScript
        const date = new Date(dateValue);
        const hoursAndMinutes = date.toLocaleTimeString('th-TH', {
          hour: '2-digit',
          minute: '2-digit'
        });
        element.textContent = `${hoursAndMinutes}`;
      }
    });



    function submitSubjectId(subjectId) {
      if (subjectId) {
    // ดึงค่า contentType ปัจจุบันจาก select
    const dashboardSelector = document.getElementById('dashboardSelector');
    const currentContentType = dashboardSelector ? dashboardSelector.value : 'lesson';
    
    // สร้าง URL พร้อมทั้ง subjectId และ contentType
    window.location.href = `/adminIndex/adminDashboard?subjectId=${subjectId}&contentType=${currentContentType}`;
  }
}

let currentCharts = {
  myChart: null,
  myChart2: null
};

function changeChartType(chartType) {
  // ทำลายกราฟเดิมถ้ามีอยู่
  if (currentCharts.myChart) {
    currentCharts.myChart.destroy();
  }
  
  const ctx = document.getElementById('myChart').getContext('2d');
  const labels = '<%= lessonLabels %>';
  const splitLabels = labels.split(",");
  const truncatedLabels = splitLabels.map(label => {
    return label.length > 10 ? label.slice(0, 10) + '...' : label;
  });
  
  const data = '<%= progressData %>';
  const splitData = data.split(",");
  const studentAmount = '<%= studentAmount %>';
  const parsintStdAmount = parseInt(studentAmount, 10);
  
  // สร้างสีพื้นหลัง
  const backgroundColors = splitLabels.map(label => getColorForLabel(label));
  
  const config = {
    type: chartType,
    data: {
      labels: truncatedLabels,
      datasets: truncatedLabels.map((label, index) => ({
      label: label,
      data: splitData.map((d, i) => i === index ? d : 0), // แสดงข้อมูลเฉพาะของ label นั้นๆ
      backgroundColor: backgroundColors[index],
      borderWidth: 1,
      barPercentage: 0.8,
      categoryPercentage: 0.7,
      borderRadius: 5
    }))
    },
    options: {
      responsive: true,
      layout: {
      padding: {
        bottom: 0 // เพิ่มระยะห่างด้านล่าง
      }
    },
    scales: chartType === 'bar' || chartType === 'line' ? {
      x: {
        title: {
          display: true,
         
          font: {
            size: 16,
            family: 'Noto Sans Thai, sans-serif'
          },
          padding: { top: 10, bottom: 20 }
        },
        ticks: {
          padding: 10,
          font: {
            size: 14,
            family: 'Noto Sans Thai, sans-serif'
          }
        },
        grid: {
          display: false
        }
      },
      y: {
        beginAtZero: true,
        max: parsintStdAmount,
        title: {
          display: true,
          text: 'จำนวนนักศึกษาที่สำเร็จ',
          font: {
            size: 16,
            family: 'Noto Sans Thai, sans-serif'
          }
        },
        grid: {
          borderDash: [2, 4]
        }
      }
    } : undefined,
    plugins: {
      legend: {
        position: chartType === 'pie' || chartType === 'doughnut' ? 'left' : 'top',
        align: 'start',
        labels: {
          padding: 20,
          usePointStyle: true,
          font: {
            family: 'Noto Sans Thai, sans-serif',
            size: 12
          }
        }
      },
      tooltip: {
        callbacks: {
          label: function(context) {
            const label = context.dataset.label || '';
            if (chartType === 'pie' || chartType === 'doughnut') {
              const total = context.dataset.data.reduce((acc, curr) => acc + curr, 0);
              const percentage = ((context.raw / total) * 100).toFixed(2);
              return `${label}: ${context.raw} คน (${percentage}%)`;
            }
            return `${label}: ${context.raw} คน`;
          }
        }
      }
    }
  }
};

  currentCharts.myChart = new Chart(ctx, config);
}


    const predefinedColors = [
      'rgba(255, 99, 132)', // แดงชมพู
      'rgba(54, 162, 235)', // น้ำเงินสด
      'rgba(255, 206, 86)', // เหลืองอ่อน
      'rgba(75, 192, 192)', // เขียวน้ำทะเล
      'rgba(153, 102, 255)', // ม่วงอ่อน
      'rgba(255, 159, 64)', // ส้มอ่อน
      'rgba(255, 99, 71)', // แดงส้ม
      'rgba(60, 179, 113)', // เขียวมิ้นต์
      'rgba(135, 206, 250)', // ฟ้าอ่อน
      'rgba(148, 0, 211)', // ม่วงเข้ม
      'rgba(220, 20, 60)', // แดงเข้ม
      'rgba(244, 164, 96)', // ส้มทองอ่อน
      'rgba(100, 149, 237)', // ฟ้าเทา
      'rgba(255, 215, 0)', // เหลืองทอง
      'rgba(255, 105, 180)', // ชมพูสด
      'rgba(70, 130, 180)', // ฟ้าน้ำทะเล
