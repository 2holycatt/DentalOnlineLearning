        function updateQuestionCount() {
          const questionCountElement = document.getElementById('question-count');
          questionCountElement.innerHTML = `${quiz.questions.length} คำถาม`;
        }

        function calculateTotalPoints() {
          const totalPoints = quiz.questions.reduce((sum, question) => sum + question.points, 0);
          document.getElementById('all-points-count').innerText = `( ${totalPoints} คะแนน)`;
        }

        function updateQuestionPoints(index, newPoints) {
          // ปรับคะแนนในอาร์เรย์ questions
          quiz.questions[index].points = Number(newPoints);
          // คำนวณคะแนนรวมใหม่
          calculateTotalPoints();
        }

        function toggleShowAnswers(checkbox) {
    const questions = document.querySelectorAll('.question');
    
    questions.forEach((questionDiv, questionIndex) => {
        const question = window.questions[questionIndex];
        
        if (question.questionType === 'MCQ' || question.questionType === 'checkbox') {
            const options = questionDiv.querySelectorAll('.form-check');
            
            options.forEach((option, optionIndex) => {
                const checkIcon = option.querySelector('.bi-check2');
                const input = option.querySelector('input');
                
                if (checkbox.checked) {
                    if (question.questionType === 'MCQ') {
                        if (optionIndex === parseInt(question.answer)) {
                            checkIcon.classList.remove('d-none');
                            input.checked = true;
                        }
                    } else if (question.questionType === 'checkbox' && 
                             Array.isArray(question.answer)) {
                        if (question.answer.includes(optionIndex)) {
                            checkIcon.classList.remove('d-none');
                            input.checked = true;
                        }
                    }
                } else {
                    checkIcon.classList.add('d-none');
                    input.checked = false;
                }
            });
        } else if (question.questionType === 'short_answ') {
            // จัดการแสดงคำตอบสำหรับ short answer
            const answerText = questionDiv.querySelector('.answer-text');
            if (answerText) {
                answerText.style.display = checkbox.checked ? 'block' : 'none';
            }
          }
    });

    // บันทึกสถานะใน localStorage
    localStorage.setItem('showAnswers', checkbox.checked);
}

// เพิ่ม event listener เมื่อโหลดหน้า
document.addEventListener('DOMContentLoaded', () => {
    const showAnswersCheckbox = document.getElementById('showAnswers');
    if (showAnswersCheckbox) {
        // โหลดสถานะจาก localStorage
        const showAnswers = localStorage.getItem('showAnswers') === 'true';
        showAnswersCheckbox.checked = showAnswers;
        if (showAnswers) {
            toggleShowAnswers(showAnswersCheckbox);
        }
    }
});

