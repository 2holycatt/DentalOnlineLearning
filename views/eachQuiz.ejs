      <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
      
      <script>


        function confirmRelease(quizId) {
          Swal.fire({
            title: 'ยืนยันการเผยแพร่แบบทดสอบ?',
            text: "คุณแน่ใจหรือไม่ว่าต้องการเผยแพร่แบบทดสอบนี้ทันที!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            confirmButtonText: 'ใช่, เผยแพร่เลย!',
            cancelButtonText: 'ยกเลิก',
            customClass: {
              container: 'swal-container',

              icon: 'swal-icon',
              confirmButton: 'swal-confirm-button',
              cancelButton: 'swal-cancel-button'
            }
          }).then((result) => {
            if (result.isConfirmed) {
              // เผยแพร่แบบทดสอบทันที (ปรับเวลาเป็น UTC+7)
              let releaseWhen = new Date(); // เวลาปัจจุบัน (UTC)
              releaseWhen = new Date(releaseWhen.getTime() + (7 * 60 * 60 * 1000)); // เพิ่ม 7 ชั่วโมงเพื่อเป็นเวลาไทย (UTC+7)
              submitReleaseQuiz(quizId, releaseWhen.toISOString(), null); // ส่งในรูปแบบ ISO และไม่มี deadline
            }
          });
        }

        function confirmDelete(quizId) {
          Swal.fire({
            title: "แน่ใจแล้วหรือยัง?",
            text: "คุณไม่สามารถเรียกคืนแบบทดสอบนี้ได้!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "gray",
            confirmButtonText: "ลบแบบทดสอบ",
            cancelButtonText: "ยกเลิก",
            customClass: {
              container: 'swal-container',

              icon: 'swal-icon',
              confirmButton: 'swal-confirm-button',
              cancelButton: 'swal-cancel-button'
            }
          }).then((result) => {
            if (result.isConfirmed) {
              window.location.href = `/adminIndex/deleteQuiz?quizId=${quizId}`;
            }
          });
        }

        function openReleaseQuizModal(quizId) {
  Swal.fire({
    title: '<div class="my-4">เผยแพร่แบบทดสอบ</div>',
    html: `
      <div><label for="releaseDate" class="form-label me-2">วันเวลาที่จะเผยแพร่:</label></div>
      <div class="d-flex justify-content-center mb-3">
          <div class="m-3">
              <input type="date" style="width: 125px;" id="releaseDate" class="form-control" required>
          </div>
          <div class="m-3">
              <input type="time" style="width: 125px;" id="releaseTime" class="form-control" required>
          </div>
      </div>

      <div><label for="deadlineDate" class="form-label me-2">วันเวลาหมดเขต (ทางเลือก):</label></div>
      <div class="d-flex justify-content-center">
          <div class="d-flex align-items-center m-3">
              <input type="date" style="width: 125px;" id="deadlineDate" class="form-control">
          </div>
          <div class="d-flex align-items-center m-3">
              <input type="time" style="width: 125px;" id="deadlineTime" class="form-control">
          </div>
      </div>
    `,
    showCancelButton: true,
    confirmButtonText: 'เผยแพร่แบบทดสอบ',
    cancelButtonText: 'ยกเลิก',
    customClass: {
      container: 'swal-container',
      icon: 'swal-icon',
      confirmButton: 'swal-launch-button',
      cancelButton: 'swal-cancel-button'
    },
    didOpen: () => {
      const releaseDateInput = document.getElementById('releaseDate');
      const releaseTimeInput = document.getElementById('releaseTime');
      const deadlineDateInput = document.getElementById('deadlineDate');
      const deadlineTimeInput = document.getElementById('deadlineTime');

      // สร้างวันที่ปัจจุบันตามเวลาไทย (UTC+7)
      const now = new Date();
      const timeOffsetInHours = 7; // เวลาชดเชย (UTC+7)
      const localNow = new Date(now.getTime() + (timeOffsetInHours * 60 * 60 * 1000));

      // แปลงเป็นรูปแบบ YYYY-MM-DD สำหรับการตั้งค่า min
      const today = localNow.toISOString().split('T')[0];
      releaseDateInput.setAttribute('min', today);
      deadlineDateInput.setAttribute('min', today);

      // ตั้งค่าเวลาในรูปแบบ HH:MM ตามเวลาไทย
      const hours = String(localNow.getUTCHours()).padStart(2, '0');
      const minutes = String(localNow.getUTCMinutes()).padStart(2, '0');
      const currentTimeString = `${hours}:${minutes}`;

      releaseDateInput.addEventListener('change', () => {
        const selectedDate = releaseDateInput.value;
        if (selectedDate === today) {
          releaseTimeInput.setAttribute('min', currentTimeString);
        } else {
          releaseTimeInput.removeAttribute('min'); // ถ้าไม่ใช่วันปัจจุบัน ลบ min ของ releaseTimeInput ออก
        }
      });

      // เรียกฟังก์ชันตรวจสอบเมื่อหน้าเว็บโหลด
      if (releaseDateInput.value === today) {
        releaseTimeInput.setAttribute('min', currentTimeString);
      }
    },
    preConfirm: () => {
      const releaseDate = document.getElementById('releaseDate').value;
      const releaseTime = document.getElementById('releaseTime').value;

      if (!releaseDate || !releaseTime) {
        Swal.showValidationMessage('กรุณากรอกวันและเวลาสำหรับการเผยแพร่แบบทดสอบ');
        return false;
      }

      let releaseWhen = new Date(`${releaseDate}T${releaseTime}:00`);

      // แปลงเวลาให้เป็นเวลาไทย (UTC+7)
      releaseWhen = new Date(releaseWhen.getTime() + (7 * 60 * 60 * 1000));

      // สร้างวันที่และเวลาปัจจุบัน
      const now = new Date();
      const localNow = new Date(now.getTime() + (7 * 60 * 60 * 1000));

      // ตรวจสอบว่าเวลาที่เลือกอยู่ก่อนเวลาปัจจุบันหรือไม่
      if (releaseWhen < localNow) {
        Swal.showValidationMessage('ไม่สามารถเลือกวันหรือเวลาก่อนเวลาปัจจุบันได้');
        return false;
      }

      const deadlineDate = document.getElementById('deadlineDate').value;
      const deadlineTime = document.getElementById('deadlineTime').value;

      try {
        if (isNaN(releaseWhen.getTime())) {
          throw new Error('Invalid release date/time');
        }

        let deadline = null;
        if (deadlineDate && deadlineTime) {
          deadline = new Date(`${deadlineDate}T${deadlineTime}:00`);
          deadline = new Date(deadline.getTime() + (7 * 60 * 60 * 1000)); // แปลงเวลาเป็น UTC+7

          // ตรวจสอบว่า deadline หลังจาก releaseWhen หรือไม่
          if (deadline <= releaseWhen) {
            Swal.showValidationMessage('วันเวลาหมดเขตต้องอยู่หลังวันเวลาเผยแพร่แบบทดสอบ');
            return false;
          }

          deadline = deadline.toISOString();
        }

        return {
          releaseWhen: releaseWhen.toISOString(),
          deadline
        };
      } catch (error) {
        Swal.showValidationMessage('รูปแบบวันหรือเวลาผิดพลาด กรุณาลองใหม่');
        return false;
      }
    }
  }).then((result) => {
    if (result.isConfirmed) {
      console.log('Submitted Release:', result.value.releaseWhen);
      console.log('Submitted Deadline:', result.value.deadline);
      submitScheduleQuizRelease(quizId, result.value.releaseWhen, result.value.deadline);
    }
  });
}

        function submitReleaseQuiz(quizId, releaseWhen, deadline) {
          console.log('quizId:', quizId); // ตรวจสอบว่า quizId ถูกส่งมาเป็นสตริงหรือไม่

          const isReleased = true; // เผยแพร่แบบทดสอบ

          fetch(`/adminIndex/releaseQuiz/${quizId}`, {  // ใช้ path parameters แทน query parameters
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              isReleased,
              releaseWhen,
              deadline
            })
          })
            .then(response => response.json())
            .then(data => {
              if (data.success) {
                Swal.fire({
                  icon: "success",
                  title: "เผยแพร่แบบทดสอบสำเร็จ",
                  showConfirmButton: false,
                  timer: 1500,

                  customClass: {
                    container: 'swal-container',
                    icon: 'swal-icon',
                  },
                }).then(() => {
                  location.reload(); // รีเฟรชหน้าจอหลังจากปิด Swal
                });
              } else {
                alert('เกิดข้อผิดพลาดในการเผยแพร่แบบทดสอบ');
              }
            })
            .catch(error => {
              // จัดการข้อผิดพลาดในกรณีที่ fetch ล้มเหลว
              console.error('Error:', error);
              Swal.fire({
                icon: "error",
                title: "เกิดข้อผิดพลาดในการเชื่อมต่อ",
                text: error.message || "ไม่สามารถเชื่อมต่อกับ server ได้",
                customClass: {
                  container: 'swal-container',

                  icon: 'swal-icon',
                  confirmButton: 'swal-confirm-button',
                  cancelButton: 'swal-cancel-button'
                },
              });
            });
        }

        function submitScheduleQuizRelease(quizId, releaseWhen, deadline) {
          console.log('quizId:', quizId); // ตรวจสอบ quizId
          console.log('releaseWhen:', releaseWhen); // ตรวจสอบเวลา release
          console.log('deadline:', deadline); // ตรวจสอบ deadline

          // ส่งค่าไปที่ Back-end
          fetch(`/adminIndex/scheduleQuizRelease/${quizId}`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              releaseWhen,  // เวลาในการเผยแพร่
              deadline      // กำหนดเส้นตาย
            })
          })
            .then(response => response.json())
            .then(data => {
              console.log('Response from server:', data); // ดูผลลัพธ์จาก Back-end
              if (data.success) {
                Swal.fire({
                  icon: "success",
                  title: "ตั้งเวลาเผยแพร่แบบทดสอบสำเร็จ",
                  showConfirmButton: false,
                  customClass: {
                    container: 'swal-container',

                    icon: 'swal-icon',
