      }

      .Hover-effect::after {
        content: "";
        position: absolute;
        width: 100%;
        height: var(--underline-hight);
        background-color: var(--underline_color);
        left: 0;
        bottom: 0;
        transform: scale(0, 1);
        transition: transform 0.3s ease;
      }


      .active-container::after {
        transform: scale(1, 1);
      }


      .Hover-effect:hover::after {
        transform: scale(1, 1);
      }



