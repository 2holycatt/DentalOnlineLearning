        function cancelReleaseQuiz(quizId) {
          Swal.fire({
            title: "แน่ใจแล้วหรือยัง?",
            text: "หากยกเลิกการเผยแพร่แล้วนักศึกษาทั้งหมดจะไม่เห็นแบบทสอบนี้!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "gray",
            confirmButtonText: "ยืนยัน",
            cancelButtonText: "ยกเลิก",
            customClass: {
              container: 'swal-container',
              icon: 'swal-icon',
              confirmButton: 'swal-confirm-button',
              cancelButton: 'swal-cancel-button'
            }
          }).then((result) => {
            if (result.isConfirmed) {
              // ถ้าผู้ใช้ยืนยันการยกเลิก
              fetch(`/adminIndex/releaseQuiz/${quizId}`, {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                  isReleased: false,  // ตั้ง isReleased เป็น false เพื่อยกเลิกการเผยแพร่
                })
              })
                .then(response => response.json())
                .then(data => {
                  if (data.success) {
                    Swal.fire({
                      icon: "success",
                      title: "ยกเลิกการเผยแพร่สำเร็จ",
                      showConfirmButton: false,
                      timer: 1500,

                      customClass: {
                        container: 'swal-container',
                        icon: 'swal-icon'
                      },
                    }).then(() => {
                      location.reload(); // รีเฟรชหน้าเพื่ออัปเดตสถานะ
                    });
                  } else {
                    Swal.fire({
                      title: 'เกิดข้อผิดพลาด',
                      text: 'เกิดข้อผิดพลาดในการยกเลิกการเผยแพร่',
