                const button = document.getElementById(`imageButton_${questionIndex}_${optionIndex}`);
                if (button) {
                    button.style.display = 'inline-block';
                }
            }

            function hideImageButton(questionIndex, optionIndex) {
                const button = document.getElementById(`imageButton_${questionIndex}_${optionIndex}`);
                if (button) {
                    button.style.display = 'none';
                }
            }

            let modalInstance = null;

function handleCloseModal() {
    // หากยังไม่มี instance ให้สร้างใหม่
    if (!modalInstance) {
        modalInstance = new bootstrap.Modal(document.getElementById('exampleModalLong'));
    }
    
    // Reset form
    document.getElementById('formimage').reset();
    
    // Hide preview image
    const preview = document.getElementById('preview_image');
    if (preview) {
        preview.src = '';
        preview.style.display = 'none';
    }
    
    // Hide modal
    modalInstance.hide();
}

            function openImageUploadModal(target, questionIndex, optionIndex = null) {
    // Reset form และ preview
    document.getElementById('formimage').reset();
    const preview = document.getElementById('preview_image');
    preview.src = '';
    preview.style.display = 'none';
    
    // Set values
    document.getElementById('uploadTarget').value = target;
    document.getElementById('questionIndex').value = questionIndex;
    document.getElementById('optionIndex').value = optionIndex !== null ? optionIndex : '';
    
      // สร้างหรือใช้ modal instance ที่มีอยู่
      if (!modalInstance) {
        modalInstance = new bootstrap.Modal(document.getElementById('exampleModalLong'));
    }
    modalInstance.show();
}

document.addEventListener('DOMContentLoaded', function() {
    // เพิ่มการตรวจสอบธีมและปรับแต่ง modal ตามธีม
    const modalEl = document.getElementById('exampleModalLong');
    
    // ปรับขนาด modal ทันทีเมื่อเปิด
    modalEl.addEventListener('shown.bs.modal', function() {
        const dialogEl = modalEl.querySelector('.modal-dialog');
        dialogEl.style.maxWidth = '800px';
        dialogEl.style.width = '90%';
        
        
        const contentEl = modalEl.querySelector('.modal-content');
        contentEl.style.maxWidth = '100%';
        contentEl.style.width = '100%';
    });
    
    // Add hidden.bs.modal event listener
    modalEl.addEventListener('hidden.bs.modal', function() {
        document.getElementById('formimage').reset();
        const preview = document.getElementById('preview_image');
        preview.src = '';
        preview.style.display = 'none';
    });
});


function removeImage(questionIndex, target, optionIndex = null) {
    // ป้องกันการ bubble ของ event
    event.stopPropagation();

    Swal.fire({
        title: 'ยืนยันการลบรูปภาพ',
        text: "คุณต้องการลบรูปภาพนี้ใช่หรือไม่?",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#d33',
        confirmButtonText: 'ใช่, ลบรูปภาพ',
        cancelButtonText: 'ยกเลิก'
    }).then((result) => {
        if (result.isConfirmed) {
            if (target === 'question') {
                questions[questionIndex].questionImage = null;
            } else if (target === 'option' && optionIndex !== null) {
                questions[questionIndex].options[optionIndex].image = null;
            }

            // อัพเดท UI
            renderQuestions();
            
            // บันทึกการเปลี่ยนแปลง
            autosave();

            // แสดงข้อความสำเร็จ
            Swal.fire({
                icon: 'success',
                title: 'ลบรูปภาพแล้ว',
                showConfirmButton: false,
                timer: 1500
            });
        }
    });
}

function showOptionControls(questionIndex, optionIndex) {
    const imageButton = document.getElementById(`imageButton_${questionIndex}_${optionIndex}`);
    if (imageButton) {
        imageButton.classList.remove('d-none');
    }
}

function hideOptionControls(questionIndex, optionIndex) {
    setTimeout(() => {
        const imageButton = document.getElementById(`imageButton_${questionIndex}_${optionIndex}`);
        if (imageButton && !imageButton.matches(':hover')) {
            imageButton.classList.add('d-none');
        }
    }, 100);
}

function showMatchingPairControls(questionIndex, pairIndex, side) {
    const imageButton = document.getElementById(`imageButton_${questionIndex}_${pairIndex}_${side}`);
    if (imageButton) {
        imageButton.classList.remove('d-none');
    }
}

function hideMatchingPairControls(questionIndex, pairIndex, side) {
    setTimeout(() => {
        const imageButton = document.getElementById(`imageButton_${questionIndex}_${pairIndex}_${side}`);
        if (imageButton && !imageButton.matches(':hover')) {
            imageButton.classList.add('d-none');
        }
    }, 100);
}

function removeMatchingImage(questionIndex, pairIndex, side) {
    event.stopPropagation();
    
    Swal.fire({
        title: 'ยืนยันการลบรูปภาพ',
        text: "คุณต้องการลบรูปภาพนี้ใช่หรือไม่?",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#d33',
        confirmButtonText: 'ใช่, ลบรูปภาพ',
        cancelButtonText: 'ยกเลิก'
    }).then((result) => {
        if (result.isConfirmed) {
            questions[questionIndex].matchingPairs[pairIndex][side].image = null;
            renderQuestions();
            autosave();
            
            Swal.fire({
                icon: 'success',
                title: 'ลบรูปภาพแล้ว',
                showConfirmButton: false,
                timer: 1500
            });
        }
    });
}
        </script>

