        <script>
            let currentQuestionId = null;

function selectedbody(questionId) {
    currentQuestionId = questionId;
    // Reset form and preview
    document.getElementById('formimage').reset();
    document.getElementById('preview_image').style.display = 'none';
}

function readURL(input) {
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
            const preview = document.getElementById('preview_image');
            preview.src = e.target.result;
            preview.style.display = 'block';
        };
        reader.readAsDataURL(input.files[0]);
    }
}

function savechanges() {
    const formData = new FormData(document.getElementById('formimage'));
    const quizId = '<%= quiz._id %>';
    const target = document.getElementById('uploadTarget').value;
    const questionIndex = parseInt(document.getElementById('questionIndex').value);
    const optionIndex = document.getElementById('optionIndex').value;

    if (!document.getElementById('avatar').files[0]) {
        Swal.fire({
            icon: 'error',
            title: 'กรุณาเลือกรูปภาพ'
        });
        return;
    }

    // แสดง loading state
    const saveBtn = document.querySelector('#exampleModalLong .modal-footer .btn-primary');
    const originalBtnText = saveBtn.innerHTML;
    saveBtn.disabled = true;
    saveBtn.innerHTML = '<i class="bi bi-arrow-repeat spinner"></i> กำลังบันทึก...';

    fetch(`/adminIndex/uploadQuestionImage?quizId=${quizId}`, {
        method: 'POST',
        body: formData
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            if (target === 'question') {
                questions[questionIndex].questionImage = {
                    url: data.imageUrl,
                    contentType: data.contentType
                };
            } else if (target === 'option') {
                questions[questionIndex].options[optionIndex].image = {
                    url: data.imageUrl,
                    contentType: data.contentType
                };
            } else if (target.startsWith('matching_')) {
                const [_, side] = target.split('_');
                if (!questions[questionIndex].matchingPairs[optionIndex][side].image) {
                    questions[questionIndex].matchingPairs[optionIndex][side].image = {};
                }
                questions[questionIndex].matchingPairs[optionIndex][side].image = {
                    url: data.imageUrl,
                    contentType: data.contentType
                };
            }

            // อัพเดท UI และบันทึกข้อมูล
            renderQuestions();
            autosave();

            // ปิด modal
            handleCloseModal();

            Swal.fire({
                icon: 'success',
                title: 'บันทึกสำเร็จ',
                timer: 1500,
                showConfirmButton: false
            });
        } else {
            throw new Error('อัปโหลดรูปภาพไม่สำเร็จ');
        }
    })
    .catch(error => {
        console.error('Upload error:', error);
        Swal.fire({
            icon: 'error',
            title: 'เกิดข้อผิดพลาด',
            text: 'ไม่สามารถอัปโหลดรูปภาพได้'
        });
    })
    .finally(() => {
        // คืนค่าปุ่มกลับสู่สถานะปกติ
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalBtnText;
    });
}

            let debounceTimer;

            function autosave() {
                const saveStatus = document.getElementById('saveStatus');
                saveStatus.style.display = 'inline-block';
                saveStatus.querySelector('.status-text').textContent = 'กำลังบันทึก...';

                clearTimeout(debounceTimer);
                 debounceTimer = setTimeout(() => {
                const quizName = document.getElementById('editQuizname').textContent;
                const quizDescription = document.getElementById('quizdescription').textContent;
                const attemptLimit = document.getElementById('attemptLimit').value;
                const timeLimit = JSON.parse(document.getElementById('timeLimit').value);

                const questionsWithImages = questions.map(question => ({
        ...question,
        questionImage: question.questionImage || null,
        options: question.options.map(option => ({
            ...option,
            image: option.image || null
        }))
    }));

            const data = {
                quizId: '<%= quiz._id %>',
                quizname: quizName,
                quizdescription: quizDescription,
                attemptLimit: attemptLimit,
                timeLimit: timeLimit,
                questions: questionsWithImages
            };

            fetch('/updateQuiz', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        console.log('Quiz settings saved successfully');
                        saveStatus.querySelector('.status-text').textContent = 'บันทึกแล้ว';
                        saveStatus.querySelector('i').classList.remove('bi-cloud-arrow-up-fill');
                        saveStatus.querySelector('i').classList.add('bi-cloud-check-fill');
                       
                    } else {
                        console.error('Error saving quiz settings');
                        saveStatus.querySelector('.status-text').textContent = 'บันทึกไม่สำเร็จ';
                        saveStatus.querySelector('i').classList.remove('bi-cloud-arrow-up-fill');
                        saveStatus.querySelector('i').classList.add('bi-cloud-slash-fill');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
