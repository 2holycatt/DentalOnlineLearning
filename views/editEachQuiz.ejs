            let deletedQuestionHistory = []; // เพิ่มตัวแปรเก็บประวัติคำถามที่ถูกลบ

function deleteQuestion(i) {
    if (questions.length > 1) {
        // เก็บคำถามที่จะลบไว้ในประวัติ
        const deletedQuestion = questions[i];
        deletedQuestionHistory.push({
            question: deletedQuestion,
            index: i
        });

        // ลบคำถาม
        questions.splice(i, 1);
        updateQuestionCount();
        calculateTotalPoints();
        renderQuestions();
        autosave();

        // แสดง SweetAlert2
        const Toast = Swal.mixin({
            toast: true,
            position: 'bottom-end',
            showConfirmButton: false,
            timer: 5000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer)
                toast.addEventListener('mouseleave', Swal.resumeTimer)
            }
        });

        Toast.fire({
            title: 'ลบคำถามแล้ว',
            html: '<a href="#" onclick="undoDelete()" style="text-decoration: underline; color: #3085d6;">เลิกทำ</a>'
        });
    }
}

function undoDelete() {
    if (event) {
        event.preventDefault();
    }

    if (deletedQuestionHistory.length > 0) {
        const lastDeleted = deletedQuestionHistory.pop();
        questions.splice(lastDeleted.index, 0, lastDeleted.question);
        updateQuestionCount();
        calculateTotalPoints();
        renderQuestions();
        autosave();

        // แสดง SweetAlert2 เมื่อยกเลิกการลบสำเร็จ
        const Toast = Swal.mixin({
            toast: true,
            position: 'bottom-end',
            showConfirmButton: false,
            timer: 3000,
        });

        Toast.fire({
            icon: 'success',
            title: 'ยกเลิกการลบคำถามแล้ว'
        });
    }
}

