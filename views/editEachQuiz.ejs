            let sortableInstance = null;

            function initializeSortable() {
    const container = document.getElementById('questionContainer');
    console.log('Initializing Sortable...'); 

    if (!container) {
        console.error('Cannot find questionContainer');
        return;
    }

    if (sortableInstance) {
        sortableInstance.destroy();
    }

    sortableInstance = Sortable.create(container, {
        animation: 150,
        handle: '.drag-handle',
        ghostClass: 'sortable-ghost', // เพิ่มคลาสสำหรับเงา
        dragClass: 'sortable-drag',   // เพิ่มคลาสสำหรับตัวที่กำลังลาก
        chosenClass: 'sortable-chosen',
        forceFallback: true,
        scroll: true,
        scrollSensitivity: 30,
        scrollSpeed: 10,
        fallbackTolerance: 3,


        onStart: function(evt) {
            console.log('Drag started:', evt.oldIndex);
            const draggedItem = evt.item;
            draggedItem.classList.add('dragging');
        },

        onEnd: async function(evt) {
            console.log('Drag ended:', evt.oldIndex, '->', evt.newIndex);
            const draggedItem = evt.item;
            draggedItem.classList.remove('dragging');

            const oldIndex = evt.oldIndex;
            const newIndex = evt.newIndex;

            if (oldIndex === newIndex) return;

            // อัพเดตลำดับใน array
            const movedQuestion = questions.splice(oldIndex, 1)[0];
            questions.splice(newIndex, 0, movedQuestion);

             // แสดงสถานะกำลังบันทึก
             const saveStatus = document.getElementById('saveStatus');
            saveStatus.style.display = 'inline-block';
            saveStatus.querySelector('.status-text').textContent = 'กำลังบันทึก...';
            saveStatus.querySelector('i').classList.remove('bi-cloud-check-fill', 'bi-cloud-slash-fill');
            saveStatus.querySelector('i').classList.add('bi-cloud-arrow-up-fill');

            try {
                // ดึงข้อมูลที่จำเป็นทั้งหมด
                const quizName = document.getElementById('editQuizname').textContent;
                const timeLimit = JSON.parse(document.getElementById('timeLimit').value);
                const attemptLimit = document.getElementById('attemptLimit').value;

                const response = await fetch('/updateQuiz', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        quizId: '<%= quiz._id %>',
                        quizname: quizName, // เพิ่ม quizname
                        timeLimit: {  // เพิ่ม timeLimit object
                            value: timeLimit.value,
                            display: timeLimit.display
                        },
                        attemptLimit: parseInt(attemptLimit),
                        questions: questions
                    })
                });

                const data = await response.json();
                if (data.success) {
                    // อัพเดตไอคอนและข้อความเมื่อบันทึกสำเร็จ
                    saveStatus.querySelector('.status-text').textContent = 'บันทึกแล้ว';
                    saveStatus.querySelector('i').classList.remove('bi-cloud-arrow-up-fill');
                    saveStatus.querySelector('i').classList.add('bi-cloud-check-fill');
                    
                    // ซ่อนสถานะหลังจาก 2 วินาที
                    setTimeout(() => {
                        saveStatus.style.display = 'none';
                    }, 5000);
                } else {
                    throw new Error('Failed to update quiz');
                }
            } catch (error) {
                console.error('Error:', error);
                
                // แสดงสถานะเมื่อบันทึกไม่สำเร็จ
                saveStatus.querySelector('.status-text').textContent = 'บันทึกไม่สำเร็จ';
                saveStatus.querySelector('i').classList.remove('bi-cloud-arrow-up-fill');
                saveStatus.querySelector('i').classList.add('bi-cloud-slash-fill');
                
                // คืนค่าตำแหน่งเดิม
                questions.splice(newIndex, 1);
                questions.splice(oldIndex, 0, movedQuestion);
                renderQuestions();
            }
        }
    });

    console.log('Sortable initialized successfully');
}

