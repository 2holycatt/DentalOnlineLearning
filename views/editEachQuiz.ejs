            function addQuestionType(index, type) {
    // เก็บค่าคะแนนเดิมไว้
    const currentPoints = questions[index].points || 1;
    
    // อัพเดทประเภทคำถาม
    questions[index].questionType = type;
    
    // สร้างตัวเลือกเริ่มต้นตามประเภท
    switch(type) {
        case 'matching':
            questions[index].matchingPairs = [{
                left: {
                    text: 'ด้านซ้าย',
                    image: null,
                    index: 0
                },
                right: {
                    text: 'ด้านขวา',
                    image: null,
                    index: 0
                },
                points: 1,
                correctMatch: {
                    leftIndex: 0,
                    rightIndex: 0
                }
            }];
            questions[index].options = []; // ล้างตัวเลือกเดิม
            break;

        case 'MCQ':
        case 'checkbox':
            questions[index].options = [{
                optionText: 'ตัวเลือก 1'
            }];
            questions[index].matchingPairs = []; // ล้างคู่จับคู่เดิม
            break;

        case 'Paragraph':
        case 'short_answ':
            questions[index].options = []; // ล้างตัวเลือกเดิม
            questions[index].matchingPairs = []; // ล้างคู่จับคู่เดิม
            break;
    }

    // คืนค่าคะแนนเดิม
    if (type !== 'matching') {
        questions[index].points = currentPoints;
    }

    updateQuestionCount();
    calculateTotalPoints();
    renderQuestions();
    console.log('Changed question type:', type);
    autosave();
}

