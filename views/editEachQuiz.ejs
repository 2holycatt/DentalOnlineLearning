    // Add new pair
    const newIndex = question.matchingPairs.length;
    question.matchingPairs.push({
        left: {
            text: 'ด้านซ้าย',
            image: null,
            index: newIndex
        },
        right: {
            text: 'ด้านขวา',
            image: null,
            index: newIndex
        },
        points: 1,
        correctMatch: {
            leftIndex: newIndex,
            rightIndex: newIndex
        }
    });

    question.points = calculateMatchingTotalPoints(question);

    // Re-render question display
    renderQuestions();
    calculateTotalPoints();
    autosave();
}

function removeMatchingPair(questionIndex, pairIndex) {
    // Get the question
    const question = questions[questionIndex];
    
    // Validate that matchingPairs exists and has more than one pair
    if (!question.matchingPairs || question.matchingPairs.length <= 1) {
        alert('ต้องมีอย่างน้อย 1 คู่');
        return;
    }

    // Remove the pair
    question.matchingPairs.splice(pairIndex, 1);

  // Update correctMatch indices
  question.matchingPairs.forEach((pair, idx) => {
        pair.correctMatch = {
            leftIndex: pair.left.index !== null ? idx : null,
            rightIndex: idx
        };
    });

    
    // Update total points for the question
    question.points = calculateMatchingTotalPoints(question);

    // Re-render the question
    renderQuestions();
    calculateTotalPoints();
    autosave();
}

function updateMatchingPair(questionIndex, pairIndex, side) {
    const input = event.target;
    const question = questions[questionIndex];
    const pair = question.matchingPairs[pairIndex];

    // อัพเดทค่าใน questions array
    pair[side].text = input.value;

    // หากเป็นด้าน left ให้อัพเดทหมายเลข
    if (side === 'left') {
        let validPairCount = 0;
        const allPairs = document.querySelectorAll(`#matching_pairs_${questionIndex} .matching-pair`);
        
        allPairs.forEach((pairEl) => {
            const leftInput = pairEl.querySelector('.left-side input');
            const leftText = leftInput ? leftInput.value.trim() : '';
            const leftImage = pairEl.querySelector('.left-side img');
            const pairNumber = pairEl.querySelector('.pair-number');
            
            // ตรวจสอบทั้งข้อความและรูปภาพ
            const hasValidContent = leftText !== '' || leftImage;
            
            if (hasValidContent) {
                validPairCount++;
                pairNumber.textContent = `${validPairCount}.`;
                pairNumber.style.visibility = 'visible';
            } else {
                pairNumber.style.visibility = 'hidden';
            }
        });
    }

    // อัพเดทคะแนน
    question.points = calculateMatchingTotalPoints(question);
    
    autosave();
}

function updatePairNumbers(questionIndex) {
    const pairs = document.querySelectorAll(`#matching_pairs_${questionIndex} .matching-pair`);
    let validPairCount = 0;

    pairs.forEach((pair) => {
        const leftInput = pair.querySelector('.left-side input');
        const pairNumber = pair.querySelector('.pair-number');
        
        if (leftInput && leftInput.value && leftInput.value.trim() !== '') {
            validPairCount++;
            pairNumber.textContent = `${validPairCount}.`;
            pairNumber.style.display = 'visible';
        } else {
            pairNumber.style.display = 'hidden';
        }
    });
}

function updatePairPoints(questionIndex, pairIndex, points) {
    const question = questions[questionIndex];
    question.matchingPairs[pairIndex].points = parseInt(points) || 0;
    
    // Update total points for the question
    question.points = calculateMatchingTotalPoints(question);
    
    renderQuestions();
    calculateTotalPoints(); // Update total quiz points
    autosave();
}

function addRightSideOnly(questionIndex) {
    const question = questions[questionIndex];
    
    if (!question.matchingPairs) {
        question.matchingPairs = [];
    }

    // Add new right side only pair
    const newIndex = question.matchingPairs.length;
    question.matchingPairs.push({
        left: {
            text: '',
            image: null,
            index: null 
        },
        right: {
            text: 'ด้านขวา',
            image: null,
            index: newIndex
        },
        points: 0, // No points for right side only
        correctMatch: {
            leftIndex: null, // Set leftIndex to null for right side only
            rightIndex: newIndex
        }
    });

    question.points = calculateMatchingTotalPoints(question);

    // Re-render question display
    renderQuestions();
    calculateTotalPoints();
    autosave();
}

function calculateMatchingTotalPoints(question) {
    if (!question.matchingPairs) return 0;
    
    return question.matchingPairs.reduce((total, pair) => {
        // ตรวจสอบว่ามีข้อความหรือรูปภาพในด้านซ้าย
        const hasLeftContent = (pair.left.text && pair.left.text.trim() !== '') || 
                             (pair.left.image && pair.left.image.url);
        
        return total + (hasLeftContent ? (parseInt(pair.points) || 1) : 0);
    }, 0);
}

