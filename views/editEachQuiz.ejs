            function toggleShuffleAll(checkbox) {
    const quizId = '<%= quiz._id %>';
    
    // Show saving status
    const saveStatus = document.getElementById('saveStatus');
    saveStatus.style.display = 'inline-block';
    saveStatus.querySelector('.status-text').textContent = 'กำลังบันทึก...';
    saveStatus.querySelector('i').classList.remove('bi-cloud-check-fill', 'bi-cloud-slash-fill');
    saveStatus.querySelector('i').classList.add('bi-cloud-arrow-up-fill');
    
    // Show loading state in label
    const label = checkbox.nextElementSibling;
    const originalText = label.textContent;
    label.textContent = checkbox.checked ? 'กำลังเปิดการสุ่ม...' : 'กำลังปิดการสุ่ม...';
    
    // Send request to update shuffle state
    fetch('/updateQuizShuffleState', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({
            quizId: quizId,
            isShuffled: checkbox.checked
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            // Update checkbox state and label
            label.textContent = originalText;
            
            // Show success status
            saveStatus.querySelector('.status-text').textContent = 'บันทึกแล้ว';
            saveStatus.querySelector('i').classList.remove('bi-cloud-arrow-up-fill');
            saveStatus.querySelector('i').classList.add('bi-cloud-check-fill');
            
            // Hide status after 2 seconds
            setTimeout(() => {
                saveStatus.style.display = 'none';
            }, 2000);
        } else {
            // Revert checkbox if update failed
            checkbox.checked = !checkbox.checked;
            label.textContent = originalText;
            
            // Show error status
            saveStatus.querySelector('.status-text').textContent = 'บันทึกไม่สำเร็จ';
            saveStatus.querySelector('i').classList.remove('bi-cloud-arrow-up-fill');
            saveStatus.querySelector('i').classList.add('bi-cloud-slash-fill');
            
            Swal.fire('Error', 'Failed to update shuffle state', 'error');
        }
    })
    .catch(error => {
        // Revert checkbox on error
        checkbox.checked = !checkbox.checked;
        label.textContent = originalText;
        
        // Show error status
        saveStatus.querySelector('.status-text').textContent = 'บันทึกไม่สำเร็จ';
        saveStatus.querySelector('i').classList.remove('bi-cloud-arrow-up-fill');
        saveStatus.querySelector('i').classList.add('bi-cloud-slash-fill');
        
        Swal.fire('Error', 'Failed to update shuffle state', 'error');
    });
}

