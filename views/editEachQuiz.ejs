            //Shuffle
            function shuffleQuestionsAndOptions() {
                const container = document.querySelector('.questionContainer');
                if (!container) return;

                // สุ่มลำดับข้อคำถาม
                const questions = Array.from(container.getElementsByClassName('question'));
                for (let i = questions.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    container.insertBefore(questions[j], questions[i]);
                }

                // สุ่มตัวเลือกในแต่ละข้อ
                questions.forEach(question => {
                    // สุ่มตัวเลือกแบบ MCQ และ checkbox
                    const optionsContainer = question.querySelector('.options');
                    if (optionsContainer) {
                        const options = Array.from(optionsContainer.getElementsByClassName('form-check'));
                        if (options.length > 0) {
                            for (let i = options.length - 1; i > 0; i--) {
                                const j = Math.floor(Math.random() * (i + 1));
                                optionsContainer.insertBefore(options[j], options[i]);
                            }
                        }

                        // สุ่มตัวเลือกแบบจับคู่
                        const matchingContainer = question.querySelector('.matching-container');
                        if (matchingContainer) {
                            // สุ่มด้านซ้าย
                            const leftItems = Array.from(matchingContainer.querySelectorAll('.left-side .matching-item'));
                            for (let i = leftItems.length - 1; i > 0; i--) {
                                const j = Math.floor(Math.random() * (i + 1));
                                leftItems[i].parentNode.insertBefore(leftItems[j], leftItems[i]);
                            }

                            // สุ่มด้านขวา
                            const rightItems = Array.from(matchingContainer.querySelectorAll('.right-side .matching-item'));
                            for (let i = rightItems.length - 1; i > 0; i--) {
                                const j = Math.floor(Math.random() * (i + 1));
                                rightItems[i].parentNode.insertBefore(rightItems[j], rightItems[i]);
                            }
                        }
                    }
                });
            }

