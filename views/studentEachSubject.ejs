    <div class="main-content d-flex">
      <%- include("./partials/studentAside.ejs")%>
        <!-- <div style="width: 20%;"><p class="w-100">&nbsp;</p></div> -->
        <div class="aside-right bg-white h-auto p-4 m-3" style="width: 80%;">
          <div class="manange-bar px-4 py-3 bg-white w-100">
            <div class="mb-3">
              <p class="fw-bold fs-3 my-1 lesson-bar">
                <span class=" fw-normal">
                  <%=subject.subjectId%>
                    <%=subject.subjectName%>
                </span>
                <span class="">
                  ภาคการศึกษา:
                </span>
                <span class=" fw-normal">
                  <%=subject.semester%>
                </span>
                <span class="">
                  กลุ่มที่:
                </span>
                <span class=" fw-normal">
                  <%=subject.section%>
                </span>
              </p>
              <p class="grey m-3"><%=subject.description%></p>

              <% if (subject.isArchived) { %>
                <br>
              <hr>
                <p class="grey mt-2">
                  <i class="me-2"></i>
                  รายวิชานี้ถูกจัดเก็บ 
                </p>
              <% } %>
            </div>
            <div>
              <!-- <div class="d-flex justify-content-start mx-3 mb-2">
                <p>โดย</p>
              </div> -->
              <!-- <div class="d-flex justify-content-end">
                <a class="m-1 p-2 btn btn-primary" href="/adminIndex/adminDashboard?subjectId=<%=subject._id%>" >
                  แดชบอร์ด <i class="ms-1 bi bi-pie-chart-fill"></i>
                </a>
                <div>
                 
                  <a href="/adminIndex/deleteSubject?subjectId=<%=subject._id%>" class="btn btn-danger m-1 p-2">
                    จัดเก็บรายวิชา <i class="bi bi-archive"></i>
                  </a>
                </div>
              </div> -->
            </div>
          </div>
          <!-- <div class="lesson-content p-4 bg-white w-100 my-4">
        <p class="lesson-nothing text-center">ยังไม่มีข้อมูลจากบทเรียน
          <br>โปรดเลือกบทเรียนที่มีอยู่ในรายชื่อหากต้องดูข้อมูลและจัดการ
        </p>
      </div> -->

          <div class="lesson-content p-4 bg-white w-100 my-4">
            <div class="row">

              <div class="col-12 mt-2 row">
                <div class="col">
                  <p class="fw-bold fs-6 my-1">
                    <i class="bi bi-book-half text-primary me-1"></i>
                    บทเรียน
                    <span class="text-secondary fw-normal">
                      /
                    </span>
                    จำนวน:
                    <span class="text-primary fw-normal">
                      <%=subject.lessonArray.length%>
                    </span>
                  </p>
                </div>
                <div class="col d-flex align-items-center justify-content-end">
                 
                </div>
              </div>
              <div class="set-border-bottom col-12 mt-3 row">
                <% if (subject.lessonArray.length> 0) {%>
                  <% const lessons=subject.lessonArray %>
                    <% lessons.forEach(lesson=> { %>
                      <% if (lesson.file) { %>
                        <div class="col-md-4 col-sm-6 col-xs-12 mb-3 d-flex justify-content-center">
                          <a href="/studentIndex/eachLessonStudent?lessonId=<%= lesson._id %>">
                            <div class="card-1 text-bg-white mb-3"
                              style="max-width: 18em; max-height: 10em; position: relative;">
                              <div class="card-header bg-white px-2 py-1 fw-bold text-primary"
                                style="width: fit-content; border-bottom-right-radius: 0.5em; position: absolute;">
                                <p class="text-break" style="font-size: small;">
                                  <%= lesson.LessonName %>
                                </p>
                              </div>
                              <div class="card-body d-flex justify-content-center p-4">
                                <%const image=lesson.file%>
                                  <img src="<%=image%>" alt="รูปภาพประกอบบทเรียน" class="card-img" alt="รูปของบทเรียน"
                                    style="width: 100%; height: 20%; border-radius: 0.5em;">
                                  <!-- /* <img src="/images/indexMed/DENTISTRY_KKU.svg.png" class="card-img" alt="รูปของบทเรียน" style="height: 100%; width: 50%; object-fit: cover;"> */ -->
                              </div>
                            </div>
                          </a>
                        </div>
                        <% } else if (!lesson.file) { %>
                          <div class="col-md-4 col-sm-6 col-xs-12 mb-3 d-flex justify-content-center">
                            <a href="/studentIndex/eachLessonStudent?lessonId=<%= lesson._id %>">
                              <div class="card-1 text-bg-white mb-3"
                                style="max-width: 18em; max-height: 10em; position: relative;">
                                <div class="card-header bg-white px-2 py-1 fw-bold text-primary"
                                  style="width: fit-content; border-bottom-right-radius: 0.5em; position: absolute;">
                                  <p class="text-break" style="font-size: small;">
                                    <%= lesson.LessonName %>
                                  </p>
                                </div>
                                <div class="card-body d-flex justify-content-center p-4">
                                  <img src="/images/indexMed/DENTISTRY_KKU.svg.png" class="card-img" alt="รูปของบทเรียน"
                                    style="height: 100%; width: 60%; object-fit: cover; ">
                                </div>
                              </div>
                            </a>
                          </div>
                          <% } %>
                            <% }); %>
                              <% } else if (subject.lessonArray.length < 1) {%>
                                <p class="showSubject show<%=subject.subjectId%> mb-2">
                                  ยังไม่มีบทเรียนในรายวิชานี้</span>
                                </p>
                                <% } %>
              </div>

              <div class="col-12 mt-2 row">
                <div class="col">
                  <p class="fw-bold fs-6 my-1">
                    <i class="bi-3 bi-card-checklist me-1 text-primary"></i>

                    แบบทดสอบ
                    <span class="text-secondary fw-normal">
                      /
                    </span>
                    จำนวน:
                    <span class="text-primary fw-normal">
                      <%= subject.quizArray ? subject.quizArray.filter(quiz => quiz.isReleased).length : 0 %>
                    </span>
                  </p>
                </div>
                
              </div>
              <div class="set-border-bottom col-12 mt-3 row">
                <% 
                const releasedQuizzes = subject.quizArray ? subject.quizArray.filter(quiz => quiz.isReleased) : [];
                if (releasedQuizzes.length === 0) { 
                %>
                  <p class="showSubject show<%= subject.subjectId %> m-2">
                    ยังไม่มีแบบทดสอบในรายวิชานี้
                  </p>
                <% } else { %>
                  <% releasedQuizzes.forEach(quiz => { %>
                    <div class="col-md-4 col-sm-6 col-xs-12 mb-3 d-flex justify-content-center">
                      <a href="/studentIndex/eachQuiz?quizId=<%= quiz._id %>">
                        <div class="card-1 text-bg-white mb-3" style="max-width: 18em; max-height: 10em; position: relative;">
                          <div class="card-header bg-white px-2 py-1 fw-bold text-primary"
                            style="width: fit-content; border-bottom-right-radius: 0.5em; position: absolute;">
                            <p class="text-break" style="font-size: small;">
                              <%= quiz.quizname %>
                            </p>
                          </div>
                          <div class="card-body d-flex justify-content-center p-4">
                            <% if (quiz.file) { %>
                              <img src="<%= quiz.file %>" alt="รูปภาพประกอบบทเรียน" class="card-img"
                                style="width: 100%; height: 20%; border-radius: 0.5em;">
                            <% } else { %>
                              <img src="/images/indexMed/DENTISTRY_KKU.svg.png" class="card-img" alt="รูปของบทเรียน"
                                style="height: 100%; width: 60%; object-fit: cover;">
                            <% } %>
                          </div>
                        </div>
                      </a>
                    </div>
                  <% }); %>
                <% } %>
              </div>

              <div class="col-12 mt-2 row">
                <div class="col">
                  <p class="fw-bold fs-6 my-1">
                    <i class="me-1 bi-2 bi bi-list-task text-primary"></i>
                    งานที่มอบหมาย
                    <span class="text-secondary fw-normal">
                      /
                    </span>
                    จำนวน:
                    <span class="text-primary fw-normal">
                        <%= subject.Assignments ? subject.Assignments.length : 0 %>
                    </span>
                  </p>
                </div>
               
              </div>
              <div class=" col-12 mt-2 row">
                <% if (subject.Assignments.length > 0) { %>
                  <div class="file-example w-100">
                  <div class="list-div text-primary row ">
                    <p class="fw-bold my-3 col-3 text-center">
                      ชื่อ
                    </p>
                    <p class="fw-bold my-3 col-2 text-center">
                      วันที่เปิดให้ส่ง
                    </p>
                    <p class="fw-bold my-3 col-2 text-center">
                      วันที่หมดเขตส่ง
                    </p>
                    <p class="fw-bold my-3 col-3 text-center">
                      จำนวนที่นักศึกษาส่งงาน
                    </p>
                    <p class="fw-bold my-3 col-1 text-center">
                      คะแนนเต็ม
                    </p>
                  </div>
                  <% subject.Assignments.forEach(assign => { %>
                    <a href="/studentAssignDetail?id=<%= assign._doc._id %>" class="data-a">                    
                      <div class="list-div-data row py-3">
                        <p class="fs-6 fw-normal grey col-3 truncate-text" title="<%= assign.name %>">
                            <%= assign.name %>
                        </p>
                        <p class="fs-6 fw-normal text-success col-2">
                            <%= moment(assign.StartDate).format('DD/MM/YYYY HH:mm') %>
                        </p>
                        <p class="fs-6 fw-normal text-danger col-2">
                            <%= moment(assign.Deadline).format('DD/MM/YYYY HH:mm') %>
                        </p>
                        <p class="fs-6 fw-normal text-center grey col-3">
                            <%= assign.sentCount %>
                        </p>
                        <p class="fs-6 fw-normal text-success text-center col-1">
                            <%= assign.Score %>
                        </p>
                    </div>
                  </a>
                  <% }); %>
                  <% } else if (subject.Assignments.length < 1) {%>
                  <div class="list-no-assign">
                    <p class="showSubject show<%=subject.subjectId%> mb-2">ยังไม่มีงานที่มอบหมายในรายวิชานี้</p>
                  </div>
                  <% }; %>
                
                </div>
              </div>

            </div>
          </div>

        </div>
    </div>
