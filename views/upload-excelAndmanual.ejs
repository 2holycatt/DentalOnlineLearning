<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student List</title>
  <%- include("./partials/header.ejs")%>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  
  <style>
      body.dark {
        background-color: #212121 !important;
      }

      .card-1,
      .card-body-1 {
        border: none !important;
      }

      .add-button {
        width: fit-content !important;
      }

      .list-header {
        box-shadow: rgba(0, 0, 0, 0.15) 1.95px 1.95px 2.6px !important;
      }

      .p-header-1,
      .p-header-2 {
        border-right: 1px solid #999999 !important;
      }

      .p-header-4 {
        border-left: 1px solid #999999 !important;
      }

      .student-list {
        border-bottom: 1px solid #cdcdcd !important;
        color: #898989 !important;
      }

      .email-p {
        font-size: smaller !important;
      }

      .link-list {
        text-decoration: none !important;
      }

      .link-list:hover .student-list {
        color: black !important;
        transition: 0.3s;
      }

      .addContent-a {
        text-decoration: none !important;
        transition-duration: 0.3s;
      }

      .addContent-a:hover {
        color: #0d57d6 !important;
        transition: 0.3s;
      }

      .list-div {

        padding-top: 0.5em;
        border-bottom: 1px solid #EAEFF4;
      }

      .dark .list-div {
        border-bottom: 1px solid #555;
      }

      .list-div-data {
  padding: 0 !important;
  margin: 0;
  min-height: 50px;
  display: flex;
  align-items: center;
}

      .dark .list-div-data {
        border-bottom: 1px solid #555;
      }

      .lesson-bar {
        border-left: 0.25em solid #8A2BE2 !important;
        padding-left: 0.5em !important;
        margin-right: 0.5em !important;

      }

      /* .studentDetail-a:hover>.list-div-data {
        color: #0053ac !important;
        transition: 0.3s;
      } */

      .above-nav {
        background-color: white !important;
        border-bottom: 1px solid #999999;
      }

      .dark .above-nav-status {
        background-color: var(--secondary-color) !important;
        border-right: 1px solid #494949;
      }

      .status-a {
        color: #404258 !important;
      }

      .list-lesson-p {
        color: #8A2BE2;
      }

      .list-lesson-p-span {
        color: #4B0082;
      }

      .each-lesson {
        border-top: 0.1em solid #8A2BE2;
      }

      .aside-right {
        background-color: var(--bg-color) !important;
        height: 100%;
      }

      .manange-bar {
        border-radius: 0.5em;
        justify-content: space-between !important;

      }

      .add-button {
        border-radius: 0.5em !important;
        height: auto !important;
      }

      .lesson-content {
        height: fit-content !important;
        border-radius: 1em !important;
        justify-content: center !important;
      }

      .dark .manange-bar,
      .dark .lesson-content {
        background-color: var(--secondary-color) !important;
      }

      .lesson-nothing {
        margin: 25% 0 !important;
        padding: 0 !important;
      }

      .each-lesson-a {
        text-decoration: none !important;
      }

      .each-lesson-a:hover .each-lesson {
        border-left: 0.2em solid #8A2BE2 !important;
      }

      .card-img-top {
        box-shadow: rgba(0, 0, 0, 0.15) 1.95px 1.95px 2.6px !important;
      }

      .setColumn {
        display: grid !important;
        grid-template-columns: 1fr 1fr 1fr !important;
      }

      .card-a {
        text-decoration: none !important;
      }

      .card-a:hover,
      .card-a:hover .p-lesson-name {
        color: #007bff !important;
        transition: 0.5s;
      }

      .card-a:hover .bi-book {
        color: #007bff !important;
        transition: color 0.5s;
      }

      .bi-book-fill {
        display: none;
      }

      .card-a:hover .bi-book-fill {
        display: inline-block !important;
        transition: 0.5s;
      }

      .card-a:hover .bi-book {
        display: none;
        transition: 0.5s;
      }

      .manange-bar,
      .lesson-content {
        box-shadow: rgba(50, 50, 93, 0.25) 0px 2px 5px -1px !important;
        border-radius: 0.5em;
      }

      .card-1 {
        width: 90% !important;
        height: fit-content !important;
        transition: all 0.8s cubic-bezier(0.15, 0.83, 0.66, 1);
        cursor: pointer;
        border-radius: 0.5em;
        box-shadow: rgba(50, 50, 93, 0.25) 0px 2px 5px -1px !important;
      }

      .card-1:hover {
        transform: scale(1.05);
      }

      .card-header {
        border-right: 1px solid #EAEFF4;
        border-bottom: 1px solid #EAEFF4;
      }

      .a-list-5,
      .bi-5 {
        color: #8A2BE2 !important;

      }
      .dark .a-list-5,
      .darl .bi-5 {
        color: #b98aff !important;

      }
      .grey {
        color: gray !important;
      }

      .dark .grey {
        color: lightgray !important
      }

      /* .studentDetail-a :hover {
        color: #0053ac !important;
      } */
      .list-div-data:hover {
        background-color:#f4f4f9 ;

      }
      .dark .list-div-data:hover {
        background-color:#555 ;

      }
      .checkbox-column {
  display: flex;
  justify-content: center;
  align-items: center;
  transition: all 0.3s ease;
  padding: 0.5rem 0;
}
.checkbox-column input[type="checkbox"] {
  width: 18px;
  height: 18px;
  cursor: pointer;
  margin: 0;
}
/* ปรับแต่ง style ของ header checkbox */
.list-div.purple .checkbox-column {
  margin: 0;
  padding: 0.5rem 0;
  height: 100%;
}
.studentDetail-a {
  text-decoration: none !important;
  padding: 0.5rem 0;
  margin: 0;
  height: 100%;
  display: flex;
  align-items: center;
}
.swal2-popup {
  font-size: 1rem !important;
  text-align: center !important;
}

.swal2-title {
  font-size: 1.4rem !important;
  margin: 1rem 0 !important;
}

.swal2-content {
  font-size: 1rem !important;
}

.swal2-icon {
  margin: 1.5rem auto !important;
  transform: scale(1.2);
}

.swal2-actions {
  justify-content: center !important;
  gap: 1rem !important;
  margin-top: 1.5rem !important;
}

.swal2-confirm,
.swal2-cancel {
  font-size: 1rem !important;
  padding: 0.5rem 1.5rem !important;
  margin:1rem 0rem !important;
  border-radius: 0.5rem !important;
  min-width: 120px !important;
}

/* Dark mode adjustments */
.dark .swal2-popup {
  background-color: #333 !important;
  color: #fff !important;
}

.dark .swal2-title,
.dark .swal2-html-container {
  color: #fff !important;
}

.dark .swal2-confirm {
  background-color: #dc3545 !important;
}

.dark .swal2-cancel {
  background-color: #3085d6 !important;
}

/* Center icon and content */
.swal2-icon-content {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
}

.swal2-icon-success + .swal2-html-container {
  margin: 0 0 2rem 0 !important;
}
.swal2-html-container {
  margin: 0 !important;
  text-align: center !important;
}
#entriesPerPage {
    padding: 1rem 0.25rem;
    border-radius: 0.25rem;
    border: 1px solid #ced4da;
    background-color: #fff;
    cursor: pointer;
}



#entriesPerPage:focus {
    border-color: #86b7fe;
    outline: 0;
    box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
}
.email-column {
    overflow-wrap: break-word;
    word-wrap: break-word;
    hyphens: auto;
    overflow: visible;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}

label {
    font-size: 0.9rem !important;
}
.list-div.purple {
  display: flex;
  align-items: center;
  margin: 0;
  padding: 0;
}

.list-div.purple,
.list-div-data {
  display: flex;
  align-items: stretch;
  margin: 0;
  padding: 0;
}

.list-div.purple p,
.list-div-data p,
.checkbox-column {
  display: flex;
  align-items: center;
  margin: 0 !important;
  padding: 0.5rem;
  min-height: 48px;
}

/* ปรับแต่ง style ของ header checkbox */
.list-div.purple .checkbox-column,
.list-div-data .checkbox-column {
  justify-content: center;
  padding: 0.5rem;
}

.checkbox-column input[type="checkbox"] {
  margin: 0;
  width: 18px;
  height: 18px;
}

.list-div.purple .col-2,
.list-div-data .col-2,
.studentDetail-a .col-2 {
  flex: 0 0 16.666667%;
  max-width: 16.666667%;
}

.list-div.purple .col-4,
.list-div-data .col-4,
.studentDetail-a .col-4 {
  flex: 0 0 33.333333%;
  max-width: 33.333333%;
}
/* ปรับแต่ง style ของ data rows */
.list-div-data {
  display: flex;
  align-items: center;
  margin: 0;
  padding: 0;
  min-height: 48px;
}

.list-div-data .checkbox-column {
  justify-content: center;
  padding-left: 0.5rem;
  padding-right: 0.5rem;
}

/* ปรับแต่ง studentDetail-a alignment */
.studentDetail-a {
  display: flex;
  align-items: center;
  padding: 0;
  margin: 0;
  height: 100%;
}

.studentDetail-a p {
  display: flex;
  align-items: center;
  margin: 0 !important;
  padding: 0.5rem 0;
  min-height: 48px;
}

.table-responsive-wrapper {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  margin-bottom: 1rem;
  scrollbar-width: thin;
}

/* ปรับแต่ง scrollbar */
.table-responsive-wrapper::-webkit-scrollbar {
  height: 8px;
}

.table-responsive-wrapper::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 4px;
}

.table-responsive-wrapper::-webkit-scrollbar-thumb {
  background: #888;
  border-radius: 4px;
}

.table-responsive-wrapper::-webkit-scrollbar-thumb:hover {
  background: #555;
}

/* กำหนดความกว้างขั้นต่ำของตาราง */
.list-div.purple,
.list-div-data {
  min-width: 800px; /* ปรับตามความเหมาะสม */
}
form-select {
    padding: 0.375rem 0.75rem;
    font-size: 0.9rem;
    border: 1px solid #ced4da;
    border-radius: 0.25rem;
    background-color: #fff;
    cursor: pointer;
}

.form-select:focus {
    border-color: #86b7fe;
    outline: 0;
    box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
}




.dark .form-select:focus {
    border-color: #86b7fe;
}
.filter-container {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    margin-bottom: 1rem;
    justify-content: flex-end;
}

.filter-select {
    display: flex;
    align-items: center;
    margin-right: 0.5rem;
    white-space: nowrap;
}

.form-select-sm {
    border: 1px solid lightgray;
    border-radius: 0.5em;
    padding: 0.4rem 0.8rem;
    background-color: white;
    font-size: 0.9rem;
    width: auto;
    min-width: 150px;
    max-width: 200px; /* เพิ่มขนาดสูงสุด */
}


      @media screen and (max-width: 768px) {

        .filter-container {
       
        justify-content: flex-end;
    }
    
    .form-select-sm {
        font-size: 0.8rem;
        padding: 0.3rem 0.5rem;
        min-width: 120px;
    }
    
    .filter-select {
        margin-right: 0.3rem;
    }
        .above-nav-status {
          display: none;
        }
        .list-div-data {
    padding: 0.5em 0;
  }
  
  .list-div-data p {
    margin-top: 0.5rem !important;
    margin-bottom: 0.5rem !important;
    font-size: 0.9rem;
  }
  
  .checkbox-column input[type="checkbox"] {
    width: 16px;
    height: 16px;
  }
  .list-div.purple p,
  .list-div.purple .checkbox-column,
  .list-div-data .checkbox-column,
  .studentDetail-a p {
    min-height: 40px;
    font-size: 0.9rem;
  }

  .list-div.purple p,
  .list-div-data p,
  .checkbox-column {
    padding: 0.25rem;
    min-height: 40px;
    font-size: 0.9rem;
  }
  .table-responsive-wrapper {
    margin: -1rem; /* ขยายให้เต็มพื้นที่ parent */
    padding: 1rem;
  }
  
  .lesson-content {
    padding: 1rem !important;
  }

  /* ปรับขนาดตัวอักษรให้เล็กลงบนมือถือ */
  .list-div.purple p,
  .list-div-data p {
    font-size: 0.85rem;
  }

  .d-flex.align-items-center.flex-wrap.gap-4 {
        gap: 1rem !important;
    }
    
    .d-flex.align-items-center.flex-wrap.gap-4 > div {
        width: 100%;
    }
    
    #entriesPerPage,
    #studentFilter {
        width: 100% !important;
    }
      }

      @media screen and (max-width: 575px) {
    .filter-container {
        
        justify-content: space-between;
    }
    
    .form-select-sm {
        min-width: 0;
       
        font-size: 0.75rem;
        padding: 0.25rem;
    }
    
    .filter-select {
        flex: 1;
        margin: 0 0.25rem;
    }
}
    </style>
</head>

<body>
  <div id="blur-container">
    <%- include("./partials/nav2.ejs", { theme: theme, isSidebarOpen: isSidebarOpen }) %>

  </div>
  <div class="main-content d-flex">
    <%- include("./partials/lessonsList.ejs")%>
      <div class="aside-right bg-white h-auto p-4 m-3" style="width: 80%;">
        <div class="manange-bar px-4 py-3 bg-white w-100 mb-3"> 
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
              <!-- ส่วนหัวข้อ -->
              <div class="d-flex align-items-center">
                  <p class="fw-bold fs-3 mb-0">
                      <i class="bi-person-lines-fill purple me-3"></i> รายชื่อนักศึกษา
                  </p>
              </div>
              
      
              <!-- ส่วนปุ่มต่างๆ -->
              <div class="d-flex flex-wrap gap-2">
                  <button id="deleteButton" class="add-button btn btn-danger m-0 p-2" style="display: none;">
                      <i class="bi bi-trash me-1"></i> ลบรายชื่อที่เลือก
                  </button>
                  <button id="selectButton" class="add-button btn btn-secondary m-0 p-2">
                      <i class="bi bi-check-square me-1"></i>เลือกลบรายชื่อ
                  </button>
                  <a href="/adminIndex/uploadStudent2" class="add-button btn btn-primary m-0 p-2">
                      <i class="bi bi-file-arrow-up-fill me-1"></i> อัปโหลดรายชื่อนักศึกษา
                  </a>
                  <a href="/adminIndex/exportStudentListPage" class="add-button btn btn-dark m-0 p-2">
                      <i class="bi bi-file-arrow-down-fill me-1"></i> นำออกรายชื่อนักศึกษา
                  </a>
              </div>
          </div>
      </div>
        <br>
        <div class="filter-container d-flex align-items-center flex-wrap gap-4 ms-2 mb-3 me-4">
          <!-- ส่วนแสดงรายชื่อ -->
          <div class="filter-select">
              <label for="entriesPerPage" class="me-2">แสดงรายชื่อ:</label>
              <select id="entriesPerPage" class="form-select-sm px-2">
                  <option value="10" <%= allStudents.limit == 10 ? 'selected' : '' %>> 10 รายการ</option>
                  <option value="20" <%= allStudents.limit == 20 ? 'selected' : '' %>> 20 รายการ</option>
                  <option value="all" <%= allStudents.limit == allStudents.totalDocs ? 'selected' : '' %>>
                      ทั้งหมด (<%= allStudents.totalDocs %> รายการ)
                  </option>
              </select>
          </div>
      
          <!-- ส่วน Filter นักศึกษา -->
          <div class="filter-select">
              <label for="studentFilter" class="me-2">นักศึกษาจาก:</label>
              <select id="studentFilter" class="form-select-sm px-2">
                  <option value="all" selected>ทั้งหมด</option>
                  <option value="kku">มหาวิทยาลัยขอนแก่น</option>
                  <option value="external">ภายนอก</option>
              </select>
          </div>
      </div>
      
        <% if (allStudents.length < 1) { %>

          <div class="lesson-content bg-white w-100 py-3 my-2" style="height: fit-content;">
            <p class="px-3">ยังไม่มีรายชื่อนักศึกษา เนื่องจากคุณยังไม่ได้เพิ่มรายชื่อนักศึกษาและข้อมูลใด ๆ ลงในระบบ
            </p>
            <a href="/adminIndex/uploadStudent2" class="px-3 addContent-a text-primary">
              เพื่มรายชื่อและข้อมูลนักศึกษา
              <i class="bi bi-plus-circle-fill"></i>
            </a>
          </div>
          <% } else if (allStudents.docs.length> 0) {%>
            <div class="lesson-content p-4 bg-white w-100 my-2 h-auto">
              <div class="table-responsive-wrapper">
                  <div class="list-div purple row">
                      <p class="fw-bold my-3 col-1 checkbox-column" style="display: none;">
                          <input type="checkbox" id="selectAll" style="display: none;">
                      </p>
                      <!-- เพิ่ม div ครอบส่วนของหัวข้อเพื่อให้สอดคล้องกับ studentDetail-a -->
                      <div class="col-12 row">
                          <p class="fw-bold my-3 col-2">
                              รหัสนักศึกษา
                          </p>
                          <p class="fw-bold my-3 col-2">
                              ชื่อ - นามสกุล
                          </p>
                          <p class="fw-bold my-3 col-1">
                              ชื่อเล่น
                          </p>
                          <p class="fw-bold my-3 col-4">
                              ที่อยู่อีเมล (Email)
                          </p>
                          <p class="fw-bold my-3 col-1">
                              คณะ
                          </p>
                          <p class="fw-bold my-3 col-1">
                              นักศึกษาจาก
                          </p>
                      </div>
                  </div>
                  <% allStudents.docs.forEach ((student, index)=> { %>
                      <div class="list-div-data row">
                          <p class="col-1 checkbox-column my-auto" style="display: none;">
                              <input type="checkbox" name="studentCheckbox" value="<%= student.studentId %>" style="display: none;">
                          </p>
                          <a href="/adminIndex/studentInformationAccount?studentId=<%=student.studentId%>" class="studentDetail-a col-12 row">
                              <p class="fw-normal my-3 col-2 grey">
                                  <%= student.studentId || '-' %>
                              </p>
                              <p class="fw-normal my-3 col-2 grey col-adjust">
                                  <%= student.prefix || '' %><%= student.user ? `${student.user.fname || '' } ${student.user.lname || '' }` : '-' %>
                              </p>
                              <p class="fw-normal my-3 col-1 grey">
                                  <%= student.user && student.user.nickname ? student.user.nickname : '' %>
                              </p>
                              <p class="fw-normal my-3 col-4 grey email-column">
                                  <%= student.user?.email || '-' %>
                              </p>
                              <p class="fw-normal my-3 col-1 grey">
                                  <%= student.user?.major || '-' %>
                              </p>
                              <p class="fw-normal my-3 col-1 <%= student.user?.studentFromKku ? 'text-kku' : 'grey' %>">
                                  <%= student.user?.studentFromKku ? 'มหาวิทยาลัยขอนแก่น' : 'ภายนอก' %>
                              </p>
                          </a>
                      </div>
                  <% }); %>
              </div>
          </div>
            <div class="d-flex justify-content-end mt-3">
              <nav aria-label="Page navigation example">
                <ul class="pagination">
                  <% if (allStudents.hasPrevPage) { %>
                    <li class="page-item">
                      <a class="page-link px-2"
                        href="/adminIndex/uploadStudent?page=<%= allStudents.prevPage %>&limit=<%= allStudents.limit %>">ก่อนหน้า</a>
                    </li>
                    <% } else { %>
                      <li class="page-item disabled">
                        <a class="page-link px-2" href="#">ก่อนหน้า</a>
                      </li>
                      <% } %>

                        <% let startPage=Math.max(allStudents.page - 1, 1); %>
                          <% let endPage=Math.min(startPage + 2, allStudents.totalPages); %>

                            <% if (startPage> 1) { %>
                              <li class="page-item">
                                <a class="page-link px-2"
                                  href="/adminIndex/uploadStudent?page=1&limit=<%= allStudents.limit %>">1</a>
                              </li>
                              <% if (startPage> 2) { %>
                                <li class="page-item disabled"><a class="page-link px-2">...</a></li>
                                <% } %>
                                  <% } %>


                                    <% for (let i=startPage; i <=endPage; i++) { %>
                                      <li class="page-item <%= allStudents.page === i ? 'active' : '' %>">
                                        <a class="page-link px-2"
                                          href="/adminIndex/uploadStudent?page=<%= i %>&limit=<%= allStudents.limit %>">
                                          <%= i %>
                                        </a>
                                      </li>
                                      <% } %>


                                        <% if (endPage < allStudents.totalPages) { %>
                                          <% if (endPage < allStudents.totalPages - 1) { %>
                                            <li class="page-item disabled"><a class="page-link">...</a></li>
                                            <% } %>
                                              <li class="page-item">
                                                <a class="page-link px-2"
                                                  href="/adminIndex/uploadStudent?page=<%= allStudents.totalPages %>&limit=<%= allStudents.limit %>">
                                                  <%= allStudents.totalPages %>
                                                </a>
                                              </li>
                                              <% } %>

                                                <% if (allStudents.hasNextPage) { %>
                                                  <li class="page-item">
                                                    <a class="page-link px-2"
                                                      href="/adminIndex/uploadStudent?page=<%= allStudents.nextPage %>&limit=<%= allStudents.limit %>">ถัดไป</a>
                                                  </li>
                                                  <% } else { %>
                                                    <li class="page-item disabled">
                                                      <a class="page-link px-2" href="#">ถัดไป</a>
                                                    </li>
                                                    <% } %>
                </ul>
              </nav>
            </div>
            <% } %>
      </div>
  </div>
  <%- include("./partials/footer.ejs")%>
</body>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const selectButton = document.getElementById('selectButton');
    const deleteButton = document.getElementById('deleteButton');
    const selectAll = document.getElementById('selectAll');
    const checkboxes = document.getElementsByName('studentCheckbox');
    const uploadButton = document.querySelector('a[href="/adminIndex/uploadStudent2"]');
    const exportButton = document.querySelector('a[href="/adminIndex/exportStudentListPage"]'); // แก้ไขตรงนี้
    const checkboxColumns = document.querySelectorAll('.checkbox-column');
    const adjustColumns = document.querySelectorAll('.col-adjust');
    const studentFilter = document.getElementById('studentFilter');
    const studentRows = document.querySelectorAll('.list-div-data');

    studentFilter.addEventListener('change', function() {
        const filterValue = this.value;
        let visibleCount = 0;
        
        studentRows.forEach(row => {
            const studentTypeColumn = row.querySelector('p:last-child');
            const studentTypeText = studentTypeColumn.textContent.trim();
            
            if (filterValue === 'all') {
                row.style.display = '';
                visibleCount++;
            } else if (filterValue === 'kku' && studentTypeText === 'มหาวิทยาลัยขอนแก่น') {
                row.style.display = '';
                visibleCount++;
            } else if (filterValue === 'external' && studentTypeText === 'ภายนอก') {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        // แสดงข้อความเมื่อไม่พบข้อมูล
        const noDataMessage = document.querySelector('.table-responsive-wrapper');
        const existingMessage = document.getElementById('no-data-message');
        
        if (visibleCount === 0) {
            if (!existingMessage) {
                const messageElement = document.createElement('p');
                messageElement.id = 'no-data-message';
                messageElement.className = 'text-center mt-3';
                messageElement.textContent = 'ไม่พบรายชื่อนักศึกษาตามเงื่อนไขที่เลือก';
                noDataMessage.appendChild(messageElement);
            }
        } else if (existingMessage) {
            existingMessage.remove();
        }
    });



    let isSelectionMode = false;
  
    // Toggle selection mode
    selectButton.addEventListener('click', function() {
        isSelectionMode = !isSelectionMode;
        selectButton.innerHTML = isSelectionMode 
            ? 'ยกเลิก' 
            : '<i class="bi bi-check-square me-1"></i>เลือกลบรายชื่อ';
        
        // แสดง/ซ่อนปุ่มต่างๆ
        deleteButton.style.display = isSelectionMode ? 'inline-block' : 'none';
        uploadButton.style.display = isSelectionMode ? 'none' : 'inline-block';
        exportButton.style.display = isSelectionMode ? 'none' : 'inline-block';
        
        // ปรับการแสดงผลของ columns ให้ถูกต้อง ไม่เกิน 12 columns
      if (isSelectionMode) {
    // ปรับแต่ง Header row
    const headerRow = document.querySelector('.list-div.purple.row');
    if (headerRow) {
        // Reset className ของทุก column ก่อน
        headerRow.innerHTML = `
<p class="fw-bold my-3 col-1 checkbox-column" style="display: flex; justify-content: center;">
    <input type="checkbox" id="selectAll">
</p>
<div class="col-11 d-flex" style="padding: 0;">
    <p class="fw-bold my-3 col-2">
        รหัสนักศึกษา
    </p>
    <p class="fw-bold my-3 col-2">
        ชื่อ - นามสกุล
    </p>
    <p class="fw-bold my-3 col-1">
        ชื่อเล่น
    </p>
    <p class="fw-bold my-3 col-4">
        ที่อยู่อีเมล (Email)
    </p>
    <p class="fw-bold my-3 col-1">
        คณะ
    </p>
    <p class="fw-bold my-3 col-1">
        นักศึกษาจาก
    </p>
</div>`;
                
                // เพิ่ม event listener ให้กับ selectAll ที่สร้างใหม่
                document.getElementById('selectAll').addEventListener('change', function() {
                    checkboxes.forEach(cb => {
                        cb.checked = this.checked;
                    });
                });
            }
            
            // ปรับแต่ง Data rows
            document.querySelectorAll('.list-div-data').forEach(row => {
                // แยก checkbox ออกมา
                const checkboxCol = row.querySelector('.checkbox-column');
        if (checkboxCol) {
            checkboxCol.style.display = 'flex';
            checkboxCol.style.justifyContent = 'center';
            
            // ตรวจสอบว่ามี checkbox หรือไม่
            const checkbox = checkboxCol.querySelector('input[type="checkbox"]');
            if (checkbox) checkbox.style.display = 'inline-block';
        }
                
                // ปรับขนาดสำหรับลิงก์ข้อมูลนักศึกษา
                const studentLink = row.querySelector('.studentDetail-a');
                if (studentLink) {
                    studentLink.classList.remove('col-12');
                    studentLink.classList.add('col-11');
                    
                    // ปรับขนาดของแต่ละคอลัมน์ภายในลิงก์
                    const studentCols = studentLink.querySelectorAll('p');
                    if (studentCols.length >= 5) {
                        studentCols[0].className = 'fw-normal my-3 col-2 grey'; // รหัสนักศึกษา
                        studentCols[1].className = 'fw-normal my-3 col-2 grey'; // ชื่อ-นามสกุล (ลดจาก col-3)
                        studentCols[2].className = 'fw-normal my-3 col-1 grey'; // ชื่อเล่น
                        studentCols[3].className = 'fw-normal my-3 col-4 grey email-column'; // อีเมล
                        studentCols[4].className = 'fw-normal my-3 col-1 grey'; // คณะ
                        if (studentCols[5].classList.contains('text-kku')) {
                              studentCols[5].className = 'fw-normal my-3 col-1 text-kku';
                          } else {
                              studentCols[5].className = 'fw-normal my-3 col-1 grey';
                          }
                        // นักศึกษาจาก คงเดิม col-1
                    }
                }
            });
        } else {
            // คืนค่าเดิมเมื่อยกเลิกโหมดเลือก
            const headerRow = document.querySelector('.list-div.purple.row');
            if (headerRow) {
              headerRow.innerHTML = `
   <p class="fw-bold my-3 col-1 checkbox-column" style="display: none;">
                  <input type="checkbox" id="selectAll" style="display: none;">
                </p>
    <p class="fw-bold col-2">
        รหัสนักศึกษา
    </p>
    <p class="fw-bold col-2">
        ชื่อ - นามสกุล
    </p>
    <p class="fw-bold col-1">
        ชื่อเล่น
    </p>
    <p class="fw-bold col-4">
        ที่อยู่อีเมล (Email)
    </p>
    <p class="fw-bold col-1">
        คณะ
    </p>
    <p class="fw-bold col-1">
        นักศึกษาจาก
    </p>
`;
                
                // เพิ่ม event listener ให้กับ selectAll ที่สร้างใหม่
                document.getElementById('selectAll').addEventListener('change', function() {
                    checkboxes.forEach(cb => {
                        cb.checked = this.checked;
                    });
                });
            }
            
            document.querySelectorAll('.list-div-data').forEach(row => {
                // ซ่อน checkbox column
                const checkboxCol = row.querySelector('.checkbox-column');
                if (checkboxCol) checkboxCol.style.display = 'none';
                
                // ตรวจสอบว่ามี checkbox หรือไม่
                const checkbox = checkboxCol ? checkboxCol.querySelector('input[type="checkbox"]') : null;
                if (checkbox) checkbox.style.display = 'none';
                
                // ปรับขนาดสำหรับลิงก์ข้อมูลนักศึกษา
                const studentLink = row.querySelector('.studentDetail-a');
                if (studentLink) {
                    studentLink.classList.remove('col-11');
                    studentLink.classList.add('col-12');
                    
                    // คืนค่าขนาดของแต่ละคอลัมน์ภายในลิงก์
                    const studentCols = studentLink.querySelectorAll('p');
                    if (studentCols.length >= 5) {
                        studentCols[0].className = 'fw-normal my-3 col-2 grey'; // รหัสนักศึกษา
                        studentCols[1].className = 'fw-normal my-3 col-2 grey col-adjust'; // ชื่อ-นามสกุล (เพิ่มเป็น col-3)
                        studentCols[2].className = 'fw-normal my-3 col-1 grey'; // ชื่อเล่น
                        studentCols[3].className = 'fw-normal my-3 col-4 grey email-column'; // อีเมล
                        studentCols[4].className = 'fw-normal my-3 col-1 grey'; // คณะ
                        if (studentCols[5].classList.contains('text-kku')) {
                          studentCols[5].className = 'fw-normal my-3 col-1 text-kku';
                      } else {
                          studentCols[5].className = 'fw-normal my-3 col-1 grey';
                      }
                    }
                }
            });
        }
        
        // ปรับปรุงอ้างอิงถึง checkboxes เนื่องจากอาจมีการสร้าง DOM ใหม่
        const newCheckboxes = document.getElementsByName('studentCheckbox');
        checkboxes.forEach((cb, index) => {
            if (newCheckboxes[index]) {
                newCheckboxes[index].checked = cb.checked;
            }
        });
    });
    
    // Select all functionality
    selectAll.addEventListener('change', function() {
      checkboxes.forEach(cb => {
        cb.checked = this.checked;
      });
    });
  
    // Delete selected students
  // แก้ไขส่วน Delete selected students
  deleteButton.addEventListener('click', async function() {
  const selectedIds = Array.from(checkboxes)
    .filter(cb => cb.checked)
    .map(cb => cb.value);

  if (selectedIds.length === 0) {
    Swal.fire({
      icon: 'warning',
      title: 'กรุณาเลือกรายชื่อ',
      text: 'โปรดเลือกรายชื่อที่ต้องการลบอย่างน้อย 1 รายชื่อ',
      confirmButtonText: 'ตกลง'
    });
    return;
  }

  // ยืนยันการลบ
  Swal.fire({
    title: 'ยืนยันการลบรายชื่อ',
    text: `คุณต้องการลบรายชื่อที่เลือกจำนวน ${selectedIds.length} รายการใช่หรือไม่?`,
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#d33',
    cancelButtonColor: '#3085d6',
    confirmButtonText: 'ยืนยันการลบ',
    cancelButtonText: 'ยกเลิก'
  }).then(async (result) => {
    if (result.isConfirmed) {
      try {
        const response = await fetch('/adminIndex/deleteStudents', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ studentIds: selectedIds }),
        });

        const result = await response.json();

        if (response.ok) {
          await Swal.fire({
            icon: 'success',
            title: 'ลบข้อมูลสำเร็จ',
            text: `ลบรายชื่อจำนวน ${selectedIds.length} รายการเรียบร้อยแล้ว`,
            timer: 1500,
            showConfirmButton: false
          });
          window.location.reload();
        } else {
          throw new Error(result.message);
        }
      } catch (error) {
        console.error('Error:', error);
        Swal.fire({
          icon: 'error',
          title: 'เกิดข้อผิดพลาด',
          text: error.message || 'เกิดข้อผิดพลาดในการลบข้อมูล',
          confirmButtonText: 'ตกลง'
        });
      }
    }
  });
});

const entriesPerPage = document.getElementById('entriesPerPage');
    const paginationContainer = document.querySelector('.d-flex.justify-content-end.mt-3');

    entriesPerPage.addEventListener('change', function() {
        const selectedValue = this.value;
        let url = new URL(window.location.href);
        
        if (selectedValue === 'all') {
        // ถ้าเลือก "ทั้งหมด" ให้ส่ง limit เป็น total count
        url.searchParams.set('limit', '<%= allStudents.totalDocs %>');
        paginationContainer.style.display = 'none';
        
        // เพิ่ม selected ให้กับตัวเลือก "ทั้งหมด"
        Array.from(entriesPerPage.options).forEach(option => {
            option.selected = option.value === 'all';
        });
        } else {
            url.searchParams.set('limit', selectedValue);
            url.searchParams.set('page', '1');
            paginationContainer.style.display = 'flex';

            Array.from(entriesPerPage.options).forEach(option => {
            option.selected = option.value === selectedValue;
        });
        }
        
        window.location.href = url.toString();
    });
    

    // ซ่อน pagination ถ้าเลือกแสดงทั้งหมด
    if (entriesPerPage.value === 'all') {
        paginationContainer.style.display = 'none';
    }

  });
  </script>
</html>