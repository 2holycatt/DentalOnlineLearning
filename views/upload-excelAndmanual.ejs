<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student List</title>
  <%- include("./partials/header.ejs")%>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  
  <style>
      body.dark {
        background-color: #212121 !important;
      }

      .card-1,
      .card-body-1 {
        border: none !important;
      }

      .add-button {
        width: fit-content !important;
      }

      .list-header {
        box-shadow: rgba(0, 0, 0, 0.15) 1.95px 1.95px 2.6px !important;
      }

      .p-header-1,
      .p-header-2 {
        border-right: 1px solid #999999 !important;
      }

      .p-header-4 {
        border-left: 1px solid #999999 !important;
      }

      .student-list {
        border-bottom: 1px solid #cdcdcd !important;
        color: #898989 !important;
      }

      .email-p {
        font-size: smaller !important;
      }

      .link-list {
        text-decoration: none !important;
      }

      .link-list:hover .student-list {
        color: black !important;
        transition: 0.3s;
      }

      .addContent-a {
        text-decoration: none !important;
        transition-duration: 0.3s;
      }

      .addContent-a:hover {
        color: #0d57d6 !important;
        transition: 0.3s;
      }

      .list-div {

        padding-top: 0.5em;
        border-bottom: 1px solid #EAEFF4;
      }

      .dark .list-div {
        border-bottom: 1px solid #555;
      }

      .list-div-data {

        padding-top: 1em;
        border-bottom: 1px solid #EAEFF4;
        text-align: start;
        color: #4e5458 !important;
      }

      .dark .list-div-data {
        border-bottom: 1px solid #555;
      }

      .lesson-bar {
        border-left: 0.25em solid #8A2BE2 !important;
        padding-left: 0.5em !important;
        margin-right: 0.5em !important;

      }

      /* .studentDetail-a:hover>.list-div-data {
        color: #0053ac !important;
        transition: 0.3s;
      } */

      .above-nav {
        background-color: white !important;
        border-bottom: 1px solid #999999;
      }

      .dark .above-nav-status {
        background-color: var(--secondary-color) !important;
        border-right: 1px solid #494949;
      }

      .status-a {
        color: #404258 !important;
      }

      .list-lesson-p {
        color: #8A2BE2;
      }

      .list-lesson-p-span {
        color: #4B0082;
      }

      .each-lesson {
        border-top: 0.1em solid #8A2BE2;
      }

      .aside-right {
        background-color: var(--bg-color) !important;
        height: 100%;
      }

      .manange-bar {
        border-radius: 0.5em;
        justify-content: space-between !important;

      }

      .add-button {
        border-radius: 0.5em !important;
        height: auto !important;
      }

      .lesson-content {
        height: fit-content !important;
        border-radius: 1em !important;
        justify-content: center !important;
      }

      .dark .manange-bar,
      .dark .lesson-content {
        background-color: var(--secondary-color) !important;
      }

      .lesson-nothing {
        margin: 25% 0 !important;
        padding: 0 !important;
      }

      .each-lesson-a {
        text-decoration: none !important;
      }

      .each-lesson-a:hover .each-lesson {
        border-left: 0.2em solid #8A2BE2 !important;
      }

      .card-img-top {
        box-shadow: rgba(0, 0, 0, 0.15) 1.95px 1.95px 2.6px !important;
      }

      .setColumn {
        display: grid !important;
        grid-template-columns: 1fr 1fr 1fr !important;
      }

      .card-a {
        text-decoration: none !important;
      }

      .card-a:hover,
      .card-a:hover .p-lesson-name {
        color: #007bff !important;
        transition: 0.5s;
      }

      .card-a:hover .bi-book {
        color: #007bff !important;
        transition: color 0.5s;
      }

      .bi-book-fill {
        display: none;
      }

      .card-a:hover .bi-book-fill {
        display: inline-block !important;
        transition: 0.5s;
      }

      .card-a:hover .bi-book {
        display: none;
        transition: 0.5s;
      }

      .manange-bar,
      .lesson-content {
        box-shadow: rgba(50, 50, 93, 0.25) 0px 2px 5px -1px !important;
        border-radius: 0.5em;
      }

      .card-1 {
        width: 90% !important;
        height: fit-content !important;
        transition: all 0.8s cubic-bezier(0.15, 0.83, 0.66, 1);
        cursor: pointer;
        border-radius: 0.5em;
        box-shadow: rgba(50, 50, 93, 0.25) 0px 2px 5px -1px !important;
      }

      .card-1:hover {
        transform: scale(1.05);
      }

      .card-header {
        border-right: 1px solid #EAEFF4;
        border-bottom: 1px solid #EAEFF4;
      }

      .a-list-5,
      .bi-5 {
        color: #8A2BE2 !important;

      }
      .dark .a-list-5,
      .darl .bi-5 {
        color: #b98aff !important;

      }
      .grey {
        color: gray !important;
      }

      .dark .grey {
        color: lightgray !important
      }

      /* .studentDetail-a :hover {
        color: #0053ac !important;
      } */
      .list-div-data:hover {
        background-color:#f4f4f9 ;

      }
      .dark .list-div-data:hover {
        background-color:#555 ;

      }
      .checkbox-column {
    transition: all 0.3s ease;
    width: 40px;
}
.swal2-popup {
  font-size: 1rem !important;
  text-align: center !important;
}

.swal2-title {
  font-size: 1.4rem !important;
  margin: 1rem 0 !important;
}

.swal2-content {
  font-size: 1rem !important;
}

.swal2-icon {
  margin: 1.5rem auto !important;
  transform: scale(1.2);
}

.swal2-actions {
  justify-content: center !important;
  gap: 1rem !important;
  margin-top: 1.5rem !important;
}

.swal2-confirm,
.swal2-cancel {
  font-size: 1rem !important;
  padding: 0.5rem 1.5rem !important;
  margin:1rem 0rem !important;
  border-radius: 0.5rem !important;
  min-width: 120px !important;
}

/* Dark mode adjustments */
.dark .swal2-popup {
  background-color: #333 !important;
  color: #fff !important;
}

.dark .swal2-title,
.dark .swal2-html-container {
  color: #fff !important;
}

.dark .swal2-confirm {
  background-color: #dc3545 !important;
}

.dark .swal2-cancel {
  background-color: #3085d6 !important;
}

/* Center icon and content */
.swal2-icon-content {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
}

.swal2-icon-success + .swal2-html-container {
  margin: 0 0 2rem 0 !important;
}
.swal2-html-container {
  margin: 0 !important;
  text-align: center !important;
}
#entriesPerPage {
    padding: 1rem 0.25rem;
    border-radius: 0.25rem;
    border: 1px solid #ced4da;
    background-color: #fff;
    cursor: pointer;
}



#entriesPerPage:focus {
    border-color: #86b7fe;
    outline: 0;
    box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
}
.email-column {
    overflow-wrap: break-word;
    word-wrap: break-word;
    hyphens: auto;
    overflow: visible;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}
#subjectSelect,
#entriesPerPage {
    font-size: 0.9rem !important;
}
label {
    font-size: 0.9rem !important;
}
      @media screen and (max-width: 768px) {
        .above-nav-status {
          display: none;
        }
      }
    </style>
</head>

<body>
  <div id="blur-container">
    <%- include("./partials/nav2.ejs", { theme: theme, isSidebarOpen: isSidebarOpen }) %>

  </div>
  <div class="main-content d-flex">
    <%- include("./partials/lessonsList.ejs")%>
      <div class="aside-right bg-white h-auto p-4 m-3" style="width: 80%;">
        <div class="manange-bar py-3 px-4 bg-white d-flex w-100">
          <p class="fw-bold fs-3 lesson-bar">รายชื่อนักศึกษา</p>
          <div>
    <button id="deleteButton" class="add-button btn btn-danger m-0 p-2" style="display: none;">
              <i class="bi bi-trash me-1"></i> ลบรายชื่อที่เลือก
            </button>
            <button id="selectButton" class="add-button btn btn-secondary m-0 p-2">
               <i class="bi bi-check-square me-1"></i>เลือกลบรายชื่อ
            </button>

            <a href="/adminIndex/uploadStudent2" class="add-button btn btn-primary m-0 p-2">
              <i class="bi bi-file-arrow-up-fill me-1"></i> อัปโหลดรายชื่อนักศึกษา
            </a>

            <a href="/adminIndex/exportStudentListPage" class="add-button btn btn-dark m-0 p-2">
             <i class="bi bi-file-arrow-down-fill me-1"></i>  นำออกรายชื่อนักศึกษา
              </i>
            </a>
          </div>
        </div>
        <br>
        <div class="d-flex align-items-center ms-2 mb-3 me-4">
          <label for="entriesPerPage" class="ms-3 me-2">แสดงรายชื่อ:</label>
          <select id="entriesPerPage" class="form-select" style="width: max-content; min-width: 170px;">
            <option value="10" <%= allStudents.limit == 10 ? 'selected' : '' %>> 10 รายการ</option>
            <option value="20" <%= allStudents.limit == 20 ? 'selected' : '' %>> 20 รายการ</option>
            <option value="all" <%= allStudents.limit == allStudents.totalDocs ? 'selected' : '' %>>
               ทั้งหมด (<%= allStudents.totalDocs %> รายการ)
            </option>
          </select>
        </div>
        <% if (allStudents.length < 1) { %>

          <div class="lesson-content bg-white w-100 py-3 my-2" style="height: fit-content;">
            <p class="px-3">ยังไม่มีรายชื่อนักศึกษา เนื่องจากคุณยังไม่ได้เพิ่มรายชื่อนักศึกษาและข้อมูลใด ๆ ลงในระบบ
            </p>
            <a href="/adminIndex/uploadStudent2" class="px-3 addContent-a text-primary">
              เพื่มรายชื่อและข้อมูลนักศึกษา
              <i class="bi bi-plus-circle-fill"></i>
            </a>
          </div>
          <% } else if (allStudents.docs.length> 0) {%>
            <div class="lesson-content p-4 bg-white w-100 my-2 h-auto">
              <div class="list-div purple row">
                <p class="fw-bold my-3 col-1 checkbox-column" style="display: none;">
                  <input type="checkbox" id="selectAll" style="display: none;">
                </p>
                <p class="fw-bold my-3 col-2 ">
                  รหัสนักศึกษา
                </p>
                <p class="fw-bold my-3 col-3 col-adjust">
                  ชื่อ - นามสกุล
                </p>
                <p class="fw-bold my-3 col-1 ">
                  ชื่อเล่น
                </p>
                <p class="fw-bold my-3 col-4  ">
                  ที่อยู่อีเมล (Email)
                </p>
                <p class="fw-bold my-3 col-1 ">
                  คณะ
                </p>
                <p class="fw-bold my-3 col-1">
                  นักศึกษาจาก
                </p>
              </div>
              <% allStudents.docs.forEach ((student, index)=> { %>
                <a href="/adminIndex/studentInformationAccount?studentId=<%=student.studentId%>"
                  class="studentDetail-a">
                  <div class="list-div-data row">
                    <p class="fw-normal my-3 col-1 checkbox-column" style="display: none;">
                      <input type="checkbox" name="studentCheckbox" value="<%= student.studentId %>" style="display: none;">
                    </p>
                    <p class="fw-normal my-3 col-2 grey ">
                      <%= student.studentId || '-' %>
                    </p>
                    <p class="fw-normal my-3 col-3 grey col-adjust">
                      <%= student.prefix || '' %><%= student.user ? `${student.user.fname || '' } ${student.user.lname || '' }` : '-' %>
                    </p>
                    <p class="fw-normal my-3 col-1 grey ">
                      <%= student.user && student.user.nickname ? student.user.nickname : '' %>
                    </p>
                    <p class="fw-normal my-3 col-4 grey email-column ">
                      <%= student.user?.email || '-' %>
                    </p>
                    <p class="fw-normal  my-3 col-1 grey ">
                      <%= student.user?.major || '-' %>
                    </p>
                    <p
                      class="fw-normal my-3 col-1  <%= student.user?.studentFromKku ? 'text-kku' : 'grey' %>">
                      <%= student.user?.studentFromKku ? 'มข.' : 'ภายนอก' %>
                    </p>
                  </div>
                </a>
                <% }); %>
            </div>
            <div class="d-flex justify-content-end mt-3">
              <nav aria-label="Page navigation example">
                <ul class="pagination">
                  <% if (allStudents.hasPrevPage) { %>
                    <li class="page-item">
                      <a class="page-link px-2"
                        href="/adminIndex/uploadStudent?page=<%= allStudents.prevPage %>&limit=<%= allStudents.limit %>">ก่อนหน้า</a>
                    </li>
                    <% } else { %>
                      <li class="page-item disabled">
                        <a class="page-link px-2" href="#">ก่อนหน้า</a>
                      </li>
                      <% } %>

                        <% let startPage=Math.max(allStudents.page - 1, 1); %>
                          <% let endPage=Math.min(startPage + 2, allStudents.totalPages); %>

                            <% if (startPage> 1) { %>
                              <li class="page-item">
                                <a class="page-link px-2"
                                  href="/adminIndex/uploadStudent?page=1&limit=<%= allStudents.limit %>">1</a>
                              </li>
                              <% if (startPage> 2) { %>
                                <li class="page-item disabled"><a class="page-link px-2">...</a></li>
                                <% } %>
                                  <% } %>


                                    <% for (let i=startPage; i <=endPage; i++) { %>
                                      <li class="page-item <%= allStudents.page === i ? 'active' : '' %>">
                                        <a class="page-link px-2"
                                          href="/adminIndex/uploadStudent?page=<%= i %>&limit=<%= allStudents.limit %>">
                                          <%= i %>
                                        </a>
                                      </li>
                                      <% } %>


                                        <% if (endPage < allStudents.totalPages) { %>
                                          <% if (endPage < allStudents.totalPages - 1) { %>
                                            <li class="page-item disabled"><a class="page-link">...</a></li>
                                            <% } %>
                                              <li class="page-item">
                                                <a class="page-link px-2"
                                                  href="/adminIndex/uploadStudent?page=<%= allStudents.totalPages %>&limit=<%= allStudents.limit %>">
                                                  <%= allStudents.totalPages %>
                                                </a>
                                              </li>
                                              <% } %>

                                                <% if (allStudents.hasNextPage) { %>
                                                  <li class="page-item">
                                                    <a class="page-link px-2"
                                                      href="/adminIndex/uploadStudent?page=<%= allStudents.nextPage %>&limit=<%= allStudents.limit %>">ถัดไป</a>
                                                  </li>
                                                  <% } else { %>
                                                    <li class="page-item disabled">
                                                      <a class="page-link px-2" href="#">ถัดไป</a>
                                                    </li>
                                                    <% } %>
                </ul>
              </nav>
            </div>
            <% } %>
      </div>
  </div>
  <%- include("./partials/footer.ejs")%>
</body>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const selectButton = document.getElementById('selectButton');
    const deleteButton = document.getElementById('deleteButton');
    const selectAll = document.getElementById('selectAll');
    const checkboxes = document.getElementsByName('studentCheckbox');
    const uploadButton = document.querySelector('a[href="/adminIndex/uploadStudent2"]');
    const exportButton = document.querySelector('a[href="/adminIndex/exportStudentListPage"]'); // แก้ไขตรงนี้
    const checkboxColumns = document.querySelectorAll('.checkbox-column');
    const adjustColumns = document.querySelectorAll('.col-adjust');
    let isSelectionMode = false;
  
    // Toggle selection mode
    selectButton.addEventListener('click', function() {
        isSelectionMode = !isSelectionMode;
        selectButton.innerHTML = isSelectionMode 
            ? 'ยกเลิก' 
            : '<i class="bi bi-check-square me-1"></i>เลือกลบรายชื่อ';
        
        // แสดง/ซ่อนปุ่มต่างๆ
        deleteButton.style.display = isSelectionMode ? 'inline-block' : 'none';
        uploadButton.style.display = isSelectionMode ? 'none' : 'inline-block';
        exportButton.style.display = isSelectionMode ? 'none' : 'inline-block';
        

        // ปรับขนาด columns
    if (isSelectionMode) {
        document.querySelectorAll('.list-div-data').forEach(row => {
            const columns = row.children;
            // ปรับ checkbox column
            columns[0].style.display = 'block';
            // ปรับรหัสนักศึกษา
            columns[1].className = 'fw-normal my-3 col-2 grey';
            // ปรับชื่อ-นามสกุล
            columns[2].className = 'fw-normal my-3 col-2 grey';
            // ปรับชื่อเล่น
            columns[3].className = 'fw-normal my-3 col-1 grey';
            // ปรับอีเมล
            columns[4].className = 'fw-normal my-3 col-4 grey email-column';
            // คณะและนักศึกษาจาก คงเดิม col-1
        });
        
        // ปรับ header columns ด้วย
        const headerRow = document.querySelector('.list-div.purple.row');
        if (headerRow) {
            const headerColumns = headerRow.children;
            headerColumns[0].style.display = 'block'; // checkbox
            headerColumns[1].className = 'fw-bold my-3 col-2';
            headerColumns[2].className = 'fw-bold my-3 col-2';
            headerColumns[3].className = 'fw-bold my-3 col-1';
            headerColumns[4].className = 'fw-bold my-3 col-4';
        }
    } else {
        // คืนค่าเดิม
        document.querySelectorAll('.list-div-data').forEach(row => {
            const columns = row.children;
            columns[0].style.display = 'none';
            columns[1].className = 'fw-normal my-3 col-2 grey';
            columns[2].className = 'fw-normal my-3 col-3 grey';
            columns[3].className = 'fw-normal my-3 col-1 grey';
            columns[4].className = 'fw-normal my-3 col-4 grey email-column';
        });
        
        // คืนค่า header
        const headerRow = document.querySelector('.list-div.purple.row');
        if (headerRow) {
            const headerColumns = headerRow.children;
            headerColumns[0].style.display = 'none';
            headerColumns[1].className = 'fw-bold my-3 col-2';
            headerColumns[2].className = 'fw-bold my-3 col-3';
            headerColumns[3].className = 'fw-bold my-3 col-1';
            headerColumns[4].className = 'fw-bold my-3 col-4';
        }
    }
    
        // แสดง/ซ่อน checkboxes
        checkboxColumns.forEach(col => {
            col.style.display = isSelectionMode ? 'block' : 'none';
        });
        checkboxes.forEach(cb => {
            cb.style.display = isSelectionMode ? 'inline-block' : 'none';
        });
        selectAll.style.display = isSelectionMode ? 'inline-block' : 'none';

  

        uploadButton.style.display = isSelectionMode ? 'none' : 'inline-block';
        exportButton.style.display = isSelectionMode ? 'none' : 'inline-block';

        checkboxes.forEach(cb => {
            cb.style.display = isSelectionMode ? 'inline-block' : 'none';
        });
        selectAll.style.display = isSelectionMode ? 'inline-block' : 'none';
    });
  
    // Select all functionality
    selectAll.addEventListener('change', function() {
      checkboxes.forEach(cb => {
        cb.checked = this.checked;
      });
    });
  
    // Delete selected students
  // แก้ไขส่วน Delete selected students
  deleteButton.addEventListener('click', async function() {
  const selectedIds = Array.from(checkboxes)
    .filter(cb => cb.checked)
    .map(cb => cb.value);

  if (selectedIds.length === 0) {
    Swal.fire({
      icon: 'warning',
      title: 'กรุณาเลือกรายชื่อ',
      text: 'โปรดเลือกรายชื่อที่ต้องการลบอย่างน้อย 1 รายชื่อ',
      confirmButtonText: 'ตกลง'
    });
    return;
  }

  // ยืนยันการลบ
  Swal.fire({
    title: 'ยืนยันการลบรายชื่อ',
    text: `คุณต้องการลบรายชื่อที่เลือกจำนวน ${selectedIds.length} รายการใช่หรือไม่?`,
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#d33',
    cancelButtonColor: '#3085d6',
    confirmButtonText: 'ยืนยันการลบ',
    cancelButtonText: 'ยกเลิก'
  }).then(async (result) => {
    if (result.isConfirmed) {
      try {
        const response = await fetch('/adminIndex/deleteStudents', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ studentIds: selectedIds }),
        });

        const result = await response.json();

        if (response.ok) {
          await Swal.fire({
            icon: 'success',
            title: 'ลบข้อมูลสำเร็จ',
            text: `ลบรายชื่อจำนวน ${selectedIds.length} รายการเรียบร้อยแล้ว`,
            timer: 1500,
            showConfirmButton: false
          });
          window.location.reload();
        } else {
          throw new Error(result.message);
        }
      } catch (error) {
        console.error('Error:', error);
        Swal.fire({
          icon: 'error',
          title: 'เกิดข้อผิดพลาด',
          text: error.message || 'เกิดข้อผิดพลาดในการลบข้อมูล',
          confirmButtonText: 'ตกลง'
        });
      }
    }
  });
});

const entriesPerPage = document.getElementById('entriesPerPage');
    const paginationContainer = document.querySelector('.d-flex.justify-content-end.mt-3');

    entriesPerPage.addEventListener('change', function() {
        const selectedValue = this.value;
        let url = new URL(window.location.href);
        
        if (selectedValue === 'all') {
        // ถ้าเลือก "ทั้งหมด" ให้ส่ง limit เป็น total count
        url.searchParams.set('limit', '<%= allStudents.totalDocs %>');
        paginationContainer.style.display = 'none';
        
        // เพิ่ม selected ให้กับตัวเลือก "ทั้งหมด"
        Array.from(entriesPerPage.options).forEach(option => {
            option.selected = option.value === 'all';
        });
        } else {
            url.searchParams.set('limit', selectedValue);
            url.searchParams.set('page', '1');
            paginationContainer.style.display = 'flex';

            Array.from(entriesPerPage.options).forEach(option => {
            option.selected = option.value === selectedValue;
        });
        }
        
        window.location.href = url.toString();
    });
    

    // ซ่อน pagination ถ้าเลือกแสดงทั้งหมด
    if (entriesPerPage.value === 'all') {
        paginationContainer.style.display = 'none';
    }

  });
  </script>
</html>