<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Subjects</title>
  <!-- <link rel="stylesheet" href="/css/event.css"> -->
  <!-- <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous"> -->
  <%- include("./partials/header.ejs")%>
    <style>
      * {
        box-sizing: border-box !important;
      }

      body.dark {
        background-color: #212121 !important;
      }

      .card-1,
      .card-body-1 {
        border: none !important;
      }

      .descp {
        text-indent: 2em;
        margin: 0 2em;
      }

      .rectangle-141 {
        background-color: white;
        border-radius: 0.75em;
        box-shadow: 0em 0.75em 1.5em -0.25em #919eab1f, 0em 0em 0.125em #919eab33;
        height: 14.6875em;
        width: 75%;
        margin: 2em 2em;
      }

      .home-div,
      .a-home {
        color: #999999 !important;
      }

      .above-nav {
        background-color: white !important;
        border-bottom: 1px solid #999999;
      }

      .dark .above-nav-status {
        background-color: var(--secondary-color) !important;
        border-right: 1px solid #494949;
      }

      .status-a {
        color: #404258 !important;
      }

      .list-lesson-p {
        color: #8A2BE2;
      }

      .list-lesson-p-span {
        color: #4B0082;
      }

      .each-lesson {
        border-top: 0.1em solid #8A2BE2;
      }

      .aside-right {
        background-color: var(--bg-color) !important;
        height: 100%;
      }

      .manange-bar {
        border-radius: 0.5em;
        justify-content: space-between !important;

      }

      .add-button {
        border-radius: 0.5em !important;
        width: 20% !important;
        height: auto !important;
      }

      .lesson-content {
        height: fit-content !important;
        border-radius: 1em !important;
        justify-content: center !important;
      }

      .dark .manange-bar,
      .dark .lesson-content {
        background-color: var(--secondary-color) !important;
      }

      .lesson-nothing {
        margin: 25% 0 !important;
        padding: 0 !important;
      }

      .each-lesson-a {
        text-decoration: none !important;
      }

      .each-lesson-a:hover .each-lesson {
        border-left: 0.2em solid #8A2BE2 !important;
      }

      .card-img-top {
        box-shadow: rgba(0, 0, 0, 0.15) 1.95px 1.95px 2.6px !important;
      }

      .setColumn {
        display: grid !important;
        grid-template-columns: 1fr 1fr 1fr !important;
      }

      .card-a {
        text-decoration: none !important;
      }

      .card-a:hover,
      .card-a:hover .p-lesson-name {
        color: #007bff !important;
        transition: 0.5s;
      }

      .card-a:hover .bi-book {
        color: #007bff !important;
        transition: color 0.5s;
      }

      .bi-book-fill {
        display: none;
      }

      .card-a:hover .bi-book-fill {
        display: inline-block !important;
        transition: 0.5s;
      }

      .card-a:hover .bi-book {
        display: none;
        transition: 0.5s;
      }

      .manange-bar,
      .lesson-content {
        box-shadow: rgba(50, 50, 93, 0.25) 0px 2px 5px -1px !important;
        border-radius: 0.5em;
      }

      .card-1 {
        width: 90% !important;
        height: fit-content !important;
        transition: all 0.8s cubic-bezier(0.15, 0.83, 0.66, 1);
        cursor: pointer;
        border-radius: 0.5em;
        box-shadow: rgba(50, 50, 93, 0.25) 0px 2px 5px -1px !important;
        background-image: repeating-linear-gradient(
      45deg,
      #ffffff,
      #ffffff 10px,
      #f8f9fa 10px,
      #f8f9fa 20px
    );
      }

      .dark .card-1 {
        box-shadow: lightgray 0px 2px 5px -1px !important;
        background-image: repeating-linear-gradient(
      45deg,
      #2b2b2b,
      #2b2b2b 10px,
      #333333 10px,
      #333333 20px
    );
      }

      .card-1:hover {
        transform: scale(1.05);
      }

      .card-header {
        border-right: 1px solid #EAEFF4;
        border-bottom: 1px solid #EAEFF4;
      }

      .a-list-1,
      .bi-1 {
        color: #8A2BE2 !important;
      }



      #yearSelector {
        border-color: #EAEFF4;
        border-radius: 0.5em;
        background-color: white !important;
        font-size: smaller;
        padding: 0.5em !important;
      }

      #yearSelector option {
        color: #404258;
        background-color: white !important;

      }

      /* .set-border {
         border-bottom: 1px solid #EAEFF4;
         padding-bottom: 1em !important;
   
       } */

      .set-border-bottom {
        border-bottom: 1px solid #EAEFF4;
        margin-bottom: 1em !important;

      }

      .lesson-bar {
        border-left: 0.25em solid #ba55d3 !important;
        padding-left: 0.5em !important;
        margin-right: 0.5em !important;

      }

      .a-add {
        color: #007bff !important;
      }

      .a-add:hover {
        color: #0053ac !important;
      }

      #semesterSelector,
      #sectionSelector {
        border: 1px solid lightgray;
        border-radius: 0.5em;
      }
     

      @media screen and (max-width: 768px) {
        .above-nav-status {
          display: none;
        }

      }

      @media screen and (max-width: 575px) {
        .row {
          justify-content: center;
        }
       
      }
    </style>

</head>

<body>
  <% if (userRole === 'student') { %>
    <%- include("./partials/studentNav.ejs", { theme: theme, isSidebarOpen: isSidebarOpen }) %>
  <% } else { %>
    <%- include("./partials/nav2.ejs", { theme: theme, isSidebarOpen: isSidebarOpen }) %>
  <% } %>

    <div class="main-content d-flex">
      <% const pageName="adminLessonIndex" %>
      <% if (userRole === 'student') { %>
        <%- include("./partials/studentAside.ejs", { pageName: pageName })%>
        <% } else { %>
          <%- include("./partials/lessonsList.ejs", { pageName: pageName }) %>
        <% } %>
          <div class="aside-right bg-white h-auto p-4 m-3" style="width: 80%;">
            <div class="manange-bar px-4 py-3 bg-white d-flex w-100">
              <p class="fw-bold fs-3 lesson-bar">รายวิชาที่จัดเก็บ</p>
              <div>
               
                <a href="/subjects" class="btn m-0 p-2"
                  style="color: white;background-color: #999999;">
                  กลับไปรายวิชา <i class="bi bi-arrow-left"></i>
                </a>
              </div>
            </div>


            <div class="lesson-content p-4 bg-white w-100 my-4">

              <% if (!subject || subject.length === 0) { %>
                <div class="d-flex">
                  <div class="set-border">
                    <p class="fw-bold fs-5 my-1 mx-2">ยังไม่มีรายวิชาใด ๆ ที่ถูกจัดเก็บ</p>
              
                
                  </div>
                </div>


                <% } else if (subject.length> 0) { %>
                    <% let groupedSubjects = {}; %>

                    <% 
                    // Filter out invalid subjects
                    const validSubjects = subject.filter(sub => sub && sub.semester && sub.section);
                    
                    validSubjects.forEach(sub => { 
                      const key = `${sub.semester}-${sub.section}`;
                      if (!groupedSubjects[key]) {
                        groupedSubjects[key] = [];
                      }
                      groupedSubjects[key].push(sub);
                    });
                  
                    // Get unique semesters and sections from valid subjects only
                    const semesters = [...new Set(validSubjects.map(sub => sub.semester))];
                    const sections = [...new Set(validSubjects.map(sub => sub.section))];
                    %>

                                  <div class="d-flex align-items-center flex-wrap my-2 justify-content-end">
                                    <div class="set-border d-flex align-items-center mb-2 mb-sm-0">
                                      <select id="semesterSelector" class="ms-2 fs-sm px-2">
                                        <option value="all">ภาคการศึกษาทั้งหมด</option>
                                        <% semesters.forEach(semester=> { %>
                                          <option value="<%= semester %>">ภาคการศึกษา <%= semester %>
                                          </option>
                                          <% }); %>
                                      </select>
                                    </div>
                                    <div class="set-border d-flex align-items-center">
                                      <select id="sectionSelector" class="ms-2 px-2 fs-sm">
                                        <option value="all">กลุ่มเรียนทั้งหมด</option>
                                        <% sections.forEach(section=> { %>
                                          <option value="<%= section %>">กลุ่มที่ <%= section %>
                                          </option>
                                          <% }); %>
                                      </select>
                                    </div>
                                  </div>


                                  <% for (let key in groupedSubjects) { %>
                                    <% let group=groupedSubjects[key]; %>
                                      <% let [semester, section]=key.split('-'); %>

                                        <div class="my-3 showSubject show" data-semester="<%= semester %>"
                                          data-section="<%= section %>">
                                          <div class="set-border-bottom">
                                            <p class="my-2 p-schoolYear">
                                              <span class="fw-bold ms-2">ภาคการศึกษา:</span>
                                              <span class="text-primary">
                                                <%= semester %>
                                              </span>
                                              <span class="fw-bold ms-2">กลุ่มที่:</span>
                                              <span class="text-primary">
                                                <%= section %>
                                              </span>
                                            </p>
                                          </div>

                                          <div class="row">
                                            <% group.forEach(sub=> { %>
                                              <div
                                                class="col-md-4 col-sm-6 col-xs-12 mb-3 d-flex justify-content-center">
                                                <a href="/eachSubject?subjectDbId=<%= sub._id %>">
                        
                                                  <div class="card-1 text-bg-white mb-3"
                                                    style="max-width: 18em; max-height: 10em; position: relative;">
                                                    <div class="card-header bg-white px-2 py-1 fw-bold text-primary"
                                                      style="width: fit-content; border-bottom-right-radius: 0.5em; position: absolute;">
                                                      <p class="text-break" style="font-size: small;">
                                                        <%= sub.subjectId %>
                                                          <%= sub.subjectName %>
                                                      </p>
                                                    </div>
                                                    <div class="card-body d-flex justify-content-center p-4">
                                                      <img src="/images/indexMed/DENTISTRY_KKU.svg.png" class="card-img"
                                                        alt="รูปของบทเรียน"
                                                        style="height: 100%; width: 60%; object-fit: cover;">
                                                    </div>
                                                  </div>
                                                </a>
                                              </div>
                                              <% }); %>
                                          </div>
                                        </div>
                                        <% } %>
                                          <% } %>

            </div>

          </div>

    </div>
    </div>
    </div>
    <%- include("./partials/footer.ejs")%>
      <script>
        AOS.init();

        document.getElementById('semesterSelector').addEventListener('change', function () {
          const semester = this.value;
          const section = document.getElementById('sectionSelector').value;
          filterSubjects(semester, section);
        });

        document.getElementById('sectionSelector').addEventListener('change', function () {
          const section = this.value;
          const semester = document.getElementById('semesterSelector').value;
          filterSubjects(semester, section);
        });

        function filterSubjects(semester, section) {
          document.querySelectorAll('.showSubject').forEach(subject => {
            const matchSemester = semester === 'all' || subject.dataset.semester === semester;
            const matchSection = section === 'all' || subject.dataset.section === section;
            subject.style.display = matchSemester && matchSection ? 'block' : 'none';
          });
        }
      </script>
</body>


</html>